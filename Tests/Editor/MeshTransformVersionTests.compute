#pragma kernel ReadPrevious
#include "Packages/com.infinity.render-pipeline/Shaders/ShaderLibrary/GPUScene.hlsl"
RWStructuredBuffer<float4> Result;
uint TestEntityIndex;
[numthreads(1, 1, 1)]
void ReadPrevious(uint3 id : SV_DispatchThreadID)
{
    Result[0] = mul(MeshPreviousObjectToWorld(TestEntityIndex), float4(0, 0, 0, 1));
}
