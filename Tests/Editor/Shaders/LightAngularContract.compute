#pragma kernel LightAngularContract

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/CommonLighting.hlsl"
#include "Packages/com.infinity.render-pipeline/Shaders/ShaderLibrary/Lighting/LightRecord.hlsl"

StructuredBuffer<FLightRecord> Records;
StructuredBuffer<float4> Positions;
RWStructuredBuffer<float2> Results;

[numthreads(1, 1, 1)]
void LightAngularContract(uint3 id : SV_DispatchThreadID)
{
    FLightRecord light = Records[0];
    float3 position = Positions[id.x].xyz;
    float cosine = dot(normalize(position - light.positionRange.xyz), light.forward.xyz);
    Results[id.x] = float2(SpotWindow(light, position),
        SmoothAngleAttenuation(cosine, light.right.w, -light.forward.w * light.right.w));
}
