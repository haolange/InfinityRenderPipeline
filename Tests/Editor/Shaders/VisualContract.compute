#pragma kernel TraceContract
#pragma kernel MixedShadowContract
#pragma kernel EnergyContract
#pragma kernel ReceiverPlaneContract
#pragma kernel MeshNormalContract
#include "../../../Shaders/Library/GPUScene.hlsl"
#include "../../../Shaders/Library/RayTracing/ScreenSpaceRayTrace/SSRTRayCast.hlsl"
#include "../../../Shaders/Library/ShadowSampling.hlsl"
#include "../../../Shaders/Library/IndirectComposition.hlsl"
Texture2D<float> SurfaceDepth;
Texture2D<float> DepthPyramid;
Texture2D<float> ShadowRamp;
float4x4 Projection;
float4 Origin, Direction;
float ShadowStrength;
RWStructuredBuffer<float4> Results;
[numthreads(1, 1, 1)]
void TraceContract(uint3 id : SV_DispatchThreadID)
{
    ScreenSpaceHit hit = (ScreenSpaceHit)0;
    bool valid = TraceScreenSpaceHiZ(Origin.xyz, Direction.xyz, 64, 0, SCREEN_TRACE_TOWARD | SCREEN_TRACE_BEHIND, Projection, SurfaceDepth, float4(0,0,0,0), DepthPyramid, float4(0,0,0,0), DepthPyramid, hit);
    Results[0] = float4(hit.uv, hit.rawDepth, valid ? 1 : 0);
}
[numthreads(1, 1, 1)]
void MixedShadowContract(uint3 id : SV_DispatchThreadID)
{
    LightRecord light = (LightRecord)0;
    light.flags = LIGHT_FLAG_SHADOWMASK;
    light.misc.x = ShadowStrength;
    light.bakedVisibilitySlot = id.x % 2;
    float distance = id.x < 4 ? 50 : id.x < 8 ? 95 : 100;
    Results[id.x] = MixBakedAndRealtimeShadow(light, 0.6, float2(0.1, 0.2), distance);
}
[numthreads(1, 1, 1)]
void EnergyContract(uint3 id : SV_DispatchThreadID)
{
    // Threads 0..2 replace indirect diffuse (diffuse color 1), threads 3..5 environment specular (environment BRDF 0.5), at
    // confidence 0, 0.5 and 1 with a screen-space result equal to the term it replaces: the sum must not change.
    float confidence = (id.x % 3) * 0.5;
    float3 direct = float3(1, 2, 3);
    float3 existing = float3(0.2, 0.4, 0.6);
    float3 replaced = id.x < 3
        ? ReplaceIndirectDiffuse(existing, 1, float4(existing * confidence, confidence))
        : ReplaceEnvironmentSpecular(existing, 0.5, float4(existing / 0.5 * confidence, confidence));
    Results[id.x] = float4(direct + replaced, 1);
}

[numthreads(1, 1, 1)]
void ReceiverPlaneContract(uint3 id : SV_DispatchThreadID)
{
    float2 uv = float2(0.511, 0.507);
    float z = 0.4 + 0.2 * uv.x + 0.1 * uv.y;
    Results[id.x] = id.x == 0
        ? SampleShadowHard(ShadowRamp, uv, z, 1.0 / 64, float4(0, 0, 1, 1), float2(0.2, 0.1))
        : SampleShadowTent(ShadowRamp, uv, z, 1.0 / 64, float4(0, 0, 1, 1), id.x, float2(0.2, 0.1));
}

float4x4 ObjectToWorld;
[numthreads(1, 1, 1)]
void MeshNormalContract(uint3 id : SV_DispatchThreadID)
{
    Results[0] = float4(MeshNormalToWorld(ObjectToWorld, normalize(float3(1, 2, 3))), MeshTransformSign(ObjectToWorld));
}
