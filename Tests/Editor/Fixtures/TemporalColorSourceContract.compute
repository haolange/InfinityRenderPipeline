#pragma kernel SampleSource
#include "Packages/com.infinity.render-pipeline/Shaders/Library/Common.hlsl"
#include "Packages/com.infinity.render-pipeline/Shaders/Library/TemporalColorSource.hlsl"
StructuredBuffer<float4> ContractInputs;
RWStructuredBuffer<float4> ContractResults;
float4 ContractMotion;
float4x4 ContractInverseVP;
float4x4 ContractPreviousVP;
float4x4 ContractCurrentMotionVP;
float4x4 ContractPreviousMotionVP;
[numthreads(1,1,1)]
void SampleSource(uint3 id : SV_DispatchThreadID)
{
    float4 input = ContractInputs[id.x];
    float confidence;
    float3 color = SampleTemporalHitColor(input.xy,input.z,ContractMotion.xy,input.w,
        ContractInverseVP,ContractPreviousVP,ContractCurrentMotionVP,ContractPreviousMotionVP,confidence);
    ContractResults[id.x] = float4(color,confidence);
}
