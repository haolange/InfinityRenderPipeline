#pragma kernel DepthContract
#pragma kernel ReprojectionContract
#pragma kernel IlluminanceContract
#pragma kernel SurfaceContract
#pragma kernel TraceContract
#pragma kernel ContactShadowContract

#include "../../../Shaders/ShaderLibrary/Common.hlsl"
#include "../../../Shaders/ShaderLibrary/ScreenSpaceDepth.hlsl"
#include "../../../Shaders/ShaderLibrary/ScreenSpaceReprojection.hlsl"
#include "../../../Shaders/ShaderLibrary/RayTracing/ScreenSpaceRayTrace/SSRTRayCast.hlsl"
#include "../../../Shaders/ShaderLibrary/GBufferPack.hlsl"

Texture2D<float> SRV_DepthTexture;
Texture2D SRV_GBufferB, SRV_GBufferC;
float4 SSGI_Resolution;
float4x4 Matrix_InvProj, Matrix_InvViewProj;
#include "../../../Shaders/ShaderLibrary/ScreenSpaceIndirectSurface.hlsl"
#include "../../../Shaders/ShaderLibrary/Lighting/LightShapes.hlsl"

StructuredBuffer<float4> ContractInputs;
RWStructuredBuffer<float4> ContractResults;
float4x4 ContractPreviousVP, ContractCurrentMotionVP, ContractPreviousMotionVP;
float4x4 ContractProjection;
float4 ContractOrigin, ContractDirection;
float ContractTraceDistance;
Texture2D<float> ContractSurfaceDepth;
Texture2D<float> ContractDepthPyramid;

[numthreads(1, 1, 1)]
void DepthContract(uint3 id : SV_DispatchThreadID)
{
    ContractResults[id.x] = ScreenSpaceLinearEyeDepth(ContractInputs[id.x].x);
}

[numthreads(1, 1, 1)]
void ReprojectionContract(uint3 id : SV_DispatchThreadID)
{
    float4 input = ContractInputs[id.x];
    float2 historyUV = -2;
    float expectedDepth = -2;
    ReprojectSurface(input.xy, input.z, float2(.05, -.03), Matrix_InvViewProj,
        ContractPreviousVP, ContractCurrentMotionVP, ContractPreviousMotionVP, historyUV, expectedDepth);
    float2 virtualUV = ReprojectVirtualPoint(float3(.2, .3, 1), float3(0, 0, 1), 2, ContractPreviousVP);
    ContractResults[id.x] = float4(historyUV, expectedDepth, virtualUV.x);
}

[numthreads(1, 1, 1)]
void IlluminanceContract(uint3 id : SV_DispatchThreadID)
{
    float2 input = ContractInputs[id.x].xy;
    ContractResults[id.x] = IlluminanceSphereOrDisk(input.x, input.y);
}

[numthreads(1, 1, 1)]
void SurfaceContract(uint3 id : SV_DispatchThreadID)
{
    FSSGISurface surface;
    bool valid = LoadSurface(uint2(id.x, 0), surface);
    ContractResults[id.x] = float4(surface.rawDepth, valid ? 1 : 0,
        dot(surface.normalWS, surface.normalWS), dot(surface.positionWS, surface.positionWS));
}

[numthreads(1, 1, 1)]
void TraceContract(uint3 id : SV_DispatchThreadID)
{
    float3 hit = -2;
    bool found = false;
    if (ContractInputs[id.x].x == 0)
        found = TraceScreenSpaceRay(ContractOrigin.xyz, ContractDirection.xyz, ContractTraceDistance, 2,
            64, 0, ContractProjection, ContractSurfaceDepth, float4(16, 8, 16, 8), ContractDepthPyramid, float4(8, 4, 8, 4), hit);
    else
        found = TraceScreenSpaceRayLinear(ContractOrigin.xyz, ContractDirection.xyz, ContractTraceDistance, 2,
            64, 0, ContractProjection, ContractSurfaceDepth, float4(16, 8, 16, 8), ContractDepthPyramid, float4(8, 4, 8, 4), 0, hit);
    ContractResults[id.x] = float4(hit, found ? 1 : 0);
}

[numthreads(1, 1, 1)]
void ContactShadowContract(uint3 id : SV_DispatchThreadID)
{
    float4 input = ContractInputs[id.x];
    FLightRecord light = (FLightRecord)0;
    light.misc.z = input.x;
    uint mask = (uint)input.y | ((uint)input.z << 24);
    ContractResults[id.x] = ContactShadowFromMask(light, mask);
}
