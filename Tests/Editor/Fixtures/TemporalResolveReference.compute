#pragma kernel Main
#pragma kernel MainDebug TAA_WRITE_DIAGNOSTICS
#pragma kernel Sharpen TAA_SHARPEN

// Two-dispatch reference of Compute_TemporalAntiAliasing.compute: a per-pixel resolve, then a separate sharpen of the
// stored history. The production kernel fuses both through a group-shared tile.

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.infinity.render-pipeline/Shaders/Library/Common.hlsl"

float4 TAA_Resolution;
float4 TAA_InputResolution;
float2 TAA_JitterPixels;
float TAA_ResetBlend;
float TAA_Sharpness;
Texture2D<float4> SRV_AliasingColorTexture;
Texture2D<float> SRV_DepthTexture;
Texture2D<float4> SRV_HistoryColorTexture;
Texture2D<float2> SRV_MotionTexture;
Texture2D<float> SRV_ReactiveMaskTexture;
RWTexture2D<float4> UAV_AccumulateColorTexture;
#if defined(TAA_WRITE_DIAGNOSTICS)
RWTexture2D<float4> UAV_TAADiagnostics;
RWTexture2D<float4> UAV_TAAReprojection;
#endif

float3 TaaCompress(float3 rgb)
{
    rgb = max(rgb, 0);
    return rgb / (1 + dot(rgb, float3(0.2126, 0.7152, 0.0722)));
}

float3 TaaExpand(float3 color)
{
    color = max(YCoCg2RGB(color), 0);
    return min(color / max(1.0 / 65504, 1 - dot(color, float3(0.2126, 0.7152, 0.0722))), 65504);
}

int2 TaaClampPixel(int2 pixel)
{
    return clamp(pixel, 0, int2(TAA_Resolution.xy) - 1);
}

int2 TaaClampInputPixel(int2 pixel)
{
    return clamp(pixel, 0, int2(TAA_InputResolution.xy) - 1);
}

float2 TaaClosestMotion(int2 centerCoord)
{
    int2 bestCoord = centerCoord;
    float bestDepth = SRV_DepthTexture.Load(int3(centerCoord, 0));
    [unroll] for (int y = -1; y <= 1; y++)
    [unroll] for (int x = -1; x <= 1; x++)
    {
        int2 sampleCoord = TaaClampInputPixel(centerCoord + int2(x, y));
        float d = SRV_DepthTexture.Load(int3(sampleCoord, 0));
#if UNITY_REVERSED_Z
        if (d > bestDepth)
#else
        if (d < bestDepth)
#endif
        {
            bestDepth = d;
            bestCoord = sampleCoord;
        }
    }
    return SRV_MotionTexture.Load(int3(bestCoord, 0));
}

float3 TaaClip(float3 value, float3 low, float3 high)
{
    float3 center = (low + high) * 0.5;
    float3 extent = max((high - low) * 0.5, 1e-5);
    float3 delta = value - center;
    return center + delta / max(1, max3(abs(delta.x / extent.x), abs(delta.y / extent.y), abs(delta.z / extent.z)));
}

float4 TaaCubicWeights(float f)
{
    float f2 = f * f;
    float f3 = f2 * f;
    return float4(-0.5*f + f2 - 0.5*f3, 1 - 2.5*f2 + 1.5*f3,
        0.5*f + 2*f2 - 1.5*f3, -0.5*f2 + 0.5*f3);
}

// History footprint

// An on-screen footprint of accepted samples (finite, sample count at least 1) is the history; nothing else validates it.
bool TaaReadHistory(float2 colorUV, out float4 history)
{
    history = 0;
    bool valid = false;
    if (all(colorUV >= 0) && all(colorUV < 1))
    {
        float2 texel = colorUV * TAA_Resolution.xy - 0.5;
        int2 base = (int2)floor(texel);
        float2 phase = frac(texel);
        float4 wx = TaaCubicWeights(phase.x);
        float4 wy = TaaCubicWeights(phase.y);
        float3 low = 1e20;
        float3 high = -1e20;
        float sum = 0;
        [unroll] for (int y = 0; y < 4; y++)
        [unroll] for (int x = 0; x < 4; x++)
        {
            float weight = wx[x] * wy[y];
            if (abs(weight) < 1e-8)
            {
                continue;
            }
            int2 pixel = base + int2(x - 1, y - 1);
            if (any(pixel < 0) || any(pixel >= int2(TAA_Resolution.xy)))
            {
                continue;
            }
            float4 value = SRV_HistoryColorTexture.Load(int3(pixel, 0));
            if (!all(isfinite(value)) || value.a < 1)
            {
                continue;
            }
            low = min(low, value.rgb);
            high = max(high, value.rgb);
            history += value * weight;
            sum += weight;
        }
        if (sum > 0.05)
        {
            history /= sum;
            history.rgb = RGB2YCoCg(TaaCompress(clamp(history.rgb, low, high)));
            history.a = clamp(history.a, 1, 32);
            valid = true;
        }
    }
    return valid;
}

// Resolve

void TemporalAntiAlias(uint3 id)
{
    if (any(id.xy >= (uint2)TAA_Resolution.xy))
    {
        return;
    }
    int2 pixel = id.xy;
    float2 uv = (pixel + 0.5) * TAA_Resolution.zw;
    int2 baseCoord = TaaClampInputPixel(pixel);
    float2 velocity = TaaClosestMotion(baseCoord);
    float2 historyUV = uv - velocity;
    float3 currentLinear = max(SRV_AliasingColorTexture.Load(int3(baseCoord, 0)).rgb, 0);
    float3 current = RGB2YCoCg(TaaCompress(currentLinear));
    float3 linearLow = currentLinear;
    float3 linearHigh = currentLinear;
    float3 mean = 0;
    float3 moment = 0;
    float3 neighborhoodLow = 1e20;
    float3 neighborhoodHigh = -1e20;
    [unroll] for (int y = -1; y <= 1; y++)
    [unroll] for (int x = -1; x <= 1; x++)
    {
        float3 sampleLinear = max(SRV_AliasingColorTexture.Load(int3(TaaClampInputPixel(baseCoord + int2(x, y)), 0)).rgb, 0);
        linearLow = min(linearLow, sampleLinear);
        linearHigh = max(linearHigh, sampleLinear);
        float3 value = RGB2YCoCg(TaaCompress(sampleLinear));
        mean += value;
        moment += value * value;
        neighborhoodLow = min(neighborhoodLow, value);
        neighborhoodHigh = max(neighborhoodHigh, value);
    }
    mean /= 9;
    float3 deviation = sqrt(max(moment / 9 - mean * mean, 0));
    float3 low = max(neighborhoodLow, min(current, mean - 1.25 * deviation));
    float3 high = min(neighborhoodHigh, max(current, mean + 1.25 * deviation));
    float4 history = 0;
    float weight = 0;
    float count = 1;
    // 1 reset, 2 invalid motion, 3 offscreen, 4 footprint without accepted samples.
    bool finiteMotion = all(isfinite(velocity));
    float reason = TAA_ResetBlend <= 0 ? 1 : !finiteMotion ? 2 : any(historyUV < 0) || any(historyUV >= 1) ? 3 : 4;
    bool valid = TAA_ResetBlend > 0 && finiteMotion;
    if (valid)
    {
        valid = TaaReadHistory(historyUV, history);
    }
    if (valid)
    {
        float pixelsMoved = length(velocity * TAA_Resolution.xy);
        float limit = lerp(32, 4, saturate(pixelsMoved / 8));
        float samples = min(history.a, limit);
        float reactive = saturate(SRV_ReactiveMaskTexture.Load(int3(baseCoord, 0)));
        weight = samples / (samples + 1) * TAA_ResetBlend * (1 - reactive);
        history.rgb = TaaClip(history.rgb, low, high);
        count = clamp(1 + samples * TAA_ResetBlend * (1 - reactive), 1.0, 32.0);
        reason = reactive >= 1 ? 5 : 0;
    }
    float3 result = valid ? lerp(currentLinear, clamp(TaaExpand(history.rgb), linearLow, linearHigh), weight) : currentLinear;
    UAV_AccumulateColorTexture[pixel] = float4(min(result, 65504), count);
#if defined(TAA_WRITE_DIAGNOSTICS)
    UAV_TAADiagnostics[pixel] = float4(valid ? 1 : 0, weight, reason, count);
    UAV_TAAReprojection[pixel] = float4(historyUV, velocity);
#endif
}

[numthreads(8, 8, 1)]
void Main(uint3 id : SV_DispatchThreadID)
{
    TemporalAntiAlias(id);
}

[numthreads(8, 8, 1)]
void MainDebug(uint3 id : SV_DispatchThreadID)
{
    TemporalAntiAlias(id);
}

// Sharpen

[numthreads(8, 8, 1)]
void Sharpen(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)TAA_Resolution.xy))
    {
        return;
    }
    int2 pixel = id.xy;
    const float3 luminanceWeights = float3(0.2126, 0.7152, 0.0722);
    float3 rgb = max(SRV_AliasingColorTexture.Load(int3(pixel, 0)).rgb, 0);
    float luminance = dot(rgb, luminanceWeights);
    float center = luminance / (1 + luminance);
    float average = 0;
    float low = center;
    float high = center;
    const int2 offsets[4] = {int2(-1,0), int2(1,0), int2(0,-1), int2(0,1)};
    [unroll] for (int i = 0; i < 4; i++)
    {
        float3 neighbor = max(SRV_AliasingColorTexture.Load(int3(TaaClampPixel(pixel + offsets[i]), 0)).rgb, 0);
        float value = dot(neighbor, luminanceWeights);
        value /= 1 + value;
        average += value * 0.25;
        low = min(low, value);
        high = max(high, value);
    }
    float target = clamp(center + (center - average) * TAA_Sharpness, low, high);
    float targetLuminance = target / max(1 - target, 1.0 / 65504);
    // Rescale radiance instead of adding an equal RGB offset: chromaticity and
    // zero channels remain unchanged even beside high-contrast colored edges.
    float scale = min(targetLuminance / max(luminance, 1e-6), 65504 / max(max3(rgb.r, rgb.g, rgb.b), 1e-6));
    UAV_AccumulateColorTexture[pixel] = float4(rgb * scale, 1);
}
