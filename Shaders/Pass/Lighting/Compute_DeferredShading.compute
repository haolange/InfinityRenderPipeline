#include "Packages/com.infinity.render-pipeline/Shaders/Library/TextureView.hlsl"
#pragma kernel DeferredShadingCS
#pragma multi_compile_local _ INFINITY_SIDEBAND
#pragma multi_compile_local _ DEFERRED_AO
#pragma multi_compile_local _ DEFERRED_SSGI
#pragma multi_compile_local _ DEFERRED_SSR
#pragma multi_compile_local _ DEFERRED_CONTACT_SHADOW
#pragma multi_compile_local _ DEFERRED_RASTER_REFLECTION
#pragma multi_compile_local _ DEFERRED_ANALYTIC_SHADOW
#pragma multi_compile _ INFINITY_CASCADE_SHADOW_MOMENTS
#pragma multi_compile _ INFINITY_LOCAL_SHADOW_MOMENTS
#pragma multi_compile _ INFINITY_LIGHT_COOKIES
#pragma multi_compile _ INFINITY_REFLECTION_PROBES

#include "../../Library/Common.hlsl"
#include "../../Library/GBufferPack.hlsl"
#include "../../Library/Sideband.hlsl"
#include "../../Library/Stencil.hlsl"
#include "../../Library/BSDF.hlsl"
#include "../../Library/Lighting.hlsl"
#include "../../Library/ImageBasedLighting.hlsl"
#include "../../Library/IndirectComposition.hlsl"

Texture2DArray<float4> _AtmosphereGGXPrefilter;

// The DeferredShadingParameters record DeferredShadingPass writes, bound as one constant buffer.
cbuffer CBV_DeferredShadingParameters
{
    float4 DeferredShading_Resolution;
    float _AtmosphereIBLMaxMip;
    int DeferredShading_HasRenderingLayers;
    int DeferredShading_Padding0;
    int DeferredShading_Padding1;
};
#include "../../Library/ViewUniform.hlsl"

Texture2D SRV_GBufferTextureA;
Texture2D SRV_GBufferTextureB;
Texture2D<float> SRV_DepthTexture;
Texture2D<uint2> SRV_StencilTexture;
// Scene Color holds emission plus indirect diffuse from the geometry draw; this pass replaces it with the complete shading.
RWTexture2D<float4> UAV_LightingTexture;
#if defined(INFINITY_SIDEBAND)
// R is rewritten as the diffuse share of the shaded color; G, B and A pass through.
RWTexture2D<float4> UAV_Sideband;
#endif
#if defined(DEFERRED_AO)
Texture2D<float> SRV_OcclusionTexture;
#endif
#if defined(DEFERRED_SSGI)
// Premultiplied indirect irradiance, alpha = confidence.
Texture2D<float4> SRV_SSGITexture;
#endif
#if defined(DEFERRED_SSR)
// Premultiplied reflected radiance, alpha = edge fade.
Texture2D<float4> SRV_SSRTexture;
#endif
#if defined(DEFERRED_RASTER_REFLECTION)
Texture2D<float4> SRV_RasterReflection;
#endif

#include "../../Library/SurfaceLighting.hlsl"

[numthreads(8, 8, 1)]
void DeferredShadingCS(uint3 id : SV_DispatchThreadID)
{
    uint2 pixelCoord = id.xy;
    if (any(pixelCoord >= (uint2)DeferredShading_Resolution.xy))
    {
        return;
    }
    // Only pixels the geometry draw marked deferred are shaded; forward, sky and empty pixels keep their color.
    if ((LoadStencil(SRV_StencilTexture, pixelCoord) & STENCIL_BIT_DEFERRED) == 0)
    {
        return;
    }

    float2 screenUV = (pixelCoord + 0.5) * DeferredShading_Resolution.zw;
    float rawDepth = SRV_DepthTexture[pixelCoord];
    float3 ndcPos = GetNDCPos(screenUV, rawDepth);
    float3 worldPos = GetWorldSpacePos(ndcPos, Matrix_InvViewFlipYJitterProj);
    float3 viewDir = normalize(ViewPositionWS() - worldPos);
    float viewDepth = -GetViewSpacePos(ndcPos, Matrix_InvFlipYJitterProj).z;

    SurfaceData surface;
    DecodeSurface(pixelCoord, SRV_GBufferTextureA, SRV_GBufferTextureB, surface);
#if defined(INFINITY_SIDEBAND)
    float4 packedSideband = UAV_Sideband[pixelCoord];
    SidebandData sideband = UnpackSideband(packedSideband);
#else
    SidebandData sideband = DefaultSideband();
#endif
    uint lightChannels = DeferredShading_HasRenderingLayers != 0 ? sideband.LightChannels : SIDEBAND_LIGHT_CHANNELS_ALL;

    // Split the geometry color by its diffuse share: indirect diffuse I = C·r, emission E = C − I. Without a sideband no
    // reader changes the indirect term, so the whole color passes through as E.
    float3 geometryColor = UAV_LightingTexture[pixelCoord].rgb;
    float3 indirectDiffuse = geometryColor * sideband.DiffuseRatio;
    float3 emission = geometryColor - indirectDiffuse;

    float3 albedo = surface.Albedo;
    float3 normal = surface.Normal;
    float roughness = surface.Roughness;
    float metallic = surface.Metallic;
    float specular = surface.Specular;
    MicrofaceContext microfaceCtx = InitMicrofaceContext(specular, roughness, metallic, albedo);

    // Indirect occlusion applies to the stored indirect diffuse and the environment, never to emission or direct light.
#if defined(DEFERRED_AO)
    float occlusion = InfinitySampleLevel(SRV_OcclusionTexture, Global_point_clamp_sampler, screenUV, 0);
#else
    float occlusion = 1.0;
#endif
#if defined(DEFERRED_ANALYTIC_SHADOW)
    occlusion *= EvaluateAnalyticIndirectOcclusion(pixelCoord, viewDepth, worldPos, normal, lightChannels);
#endif
    indirectDiffuse *= occlusion;
#if defined(DEFERRED_SSGI)
    indirectDiffuse = ReplaceIndirectDiffuse(indirectDiffuse, microfaceCtx.AlbedoColor, SRV_SSGITexture[pixelCoord]);
#endif

    float3 directDiffuse;
    float3 direct = EvaluateSurfaceLights(worldPos, normal, viewDir, microfaceCtx, sideband.BakedVisibility, viewDepth, lightChannels, pixelCoord, directDiffuse);

    // Specular environment: raster reflection volume overrides clustered probes front to back, sky for the remainder.
    float3 reflectionWS = reflect(-viewDir, normal);
    float3 sky = SampleGGXCubemapArray(_AtmosphereGGXPrefilter, reflectionWS, microfaceCtx.RoughnessClamp, _AtmosphereIBLMaxMip);
#if defined(DEFERRED_RASTER_REFLECTION)
    float4 rasterReflection = SRV_RasterReflection[pixelCoord];
#else
    float4 rasterReflection = 0;
#endif
    float3 environmentBRDF = EnvBRDFApprox(microfaceCtx.SpecularColor, microfaceCtx.RoughnessClamp, saturate(dot(normal, viewDir))).rgb;
    float3 environment = ComposeSpecularEnvironment(rasterReflection, worldPos, reflectionWS, microfaceCtx.RoughnessClamp, pixelCoord, viewDepth, sky)
        * environmentBRDF * occlusion;
#if defined(DEFERRED_SSR)
    environment = ReplaceEnvironmentSpecular(environment, environmentBRDF, SRV_SSRTexture[pixelCoord]);
#endif

    float3 color = max(0, emission + indirectDiffuse + direct + environment);
    UAV_LightingTexture[pixelCoord] = float4(color, 1);
#if defined(INFINITY_SIDEBAND)
    UAV_Sideband[pixelCoord] = float4(DiffuseRatio(indirectDiffuse + directDiffuse, color), packedSideband.gba);
#endif
}
