#pragma kernel ScreenSpaceComposite
#pragma multi_compile _ INFINITY_GBUFFER_BESTFIT_YCOCG
#pragma multi_compile_local _ INFINITY_SSS_OUTPUT
#pragma multi_compile_local _ INFINITY_SSS_ALPHA
#pragma multi_compile_local _ COMPOSITE_SSR
#pragma multi_compile_local _ COMPOSITE_SSGI

#include "../../Library/Common.hlsl"
#include "../../Library/ScreenSpaceDepth.hlsl"
#include "../../Library/IndirectComposition.hlsl"
#include "../../Library/GBufferPack.hlsl"
#include "../../Library/BSDF.hlsl"
#include "../../Library/ImageBasedLighting.hlsl"

// AO is applied once in DeferredShading on IBL; SSR/SSGI sample already-lit color and must not be multiplied again.

// The CompositeParameters record ScreenSpaceCompositePass writes, bound as one constant buffer.
cbuffer CBV_CompositeParameters
{
    float4 Composite_Resolution;
};
#include "../../Library/ViewUniform.hlsl"
Texture2D SRV_LightingTexture;
#if defined(COMPOSITE_SSGI)
Texture2D<float4> SRV_IndirectDiffuse;
#endif
#if defined(COMPOSITE_SSR)
Texture2D<float4> SRV_IndirectSpecular;
#endif
Texture2D SRV_GBufferTextureA;
Texture2D SRV_GBufferTextureB;
Texture2D SRV_SurfaceMetadata;
Texture2D<float> SRV_DepthTexture;
#if defined(COMPOSITE_SSR)
Texture2D<float4> SRV_SSRTexture;
#endif
#if defined(COMPOSITE_SSGI)
Texture2D<float4> SRV_SSGITexture;
#endif
RWTexture2D<float4> UAV_SceneColor;
#if defined(INFINITY_SSS_OUTPUT)
RWTexture2D<float4> UAV_ScatterDiffuse;
#endif

[numthreads(16, 16, 1)]
void ScreenSpaceComposite(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)Composite_Resolution.x || id.y >= (uint)Composite_Resolution.y)
    {
        return;
    }

    uint2 pixelCoord = id.xy;
    float4 sourceLighting = SRV_LightingTexture[pixelCoord];
    float3 lighting = sourceLighting.rgb;
#if defined(INFINITY_SSS_ALPHA)
    float outAlpha = sourceLighting.a;
#else
    float outAlpha = 1.0;
#endif
    float rawDepth = SRV_DepthTexture[pixelCoord];
    if (ScreenSpaceIsFarDepth(rawDepth))
    {
        UAV_SceneColor[pixelCoord] = float4(lighting, outAlpha);
        return;
    }

    SurfaceData surfaceData;
    DecodeSurface(pixelCoord, SRV_GBufferTextureA, SRV_GBufferTextureB, SRV_SurfaceMetadata, SRV_GBufferTextureA_InfinityView, false, surfaceData);
    MicrofaceContext microfaceCtx = InitMicrofaceContext(surfaceData.Specular, surfaceData.Roughness, surfaceData.Metallic, surfaceData.Albedo);

#if defined(COMPOSITE_SSGI)
    float4 ssgiColor = SRV_SSGITexture[pixelCoord];
    float3 previousIndirectDiffuse = SRV_IndirectDiffuse[pixelCoord].rgb;
    float3 replacedIndirectDiffuse = microfaceCtx.AlbedoColor * ssgiColor.rgb;
    lighting = ReplaceIndirectContribution(lighting, previousIndirectDiffuse, replacedIndirectDiffuse, ssgiColor.a);
#if defined(INFINITY_SSS_OUTPUT)
    float3 scatter = UAV_ScatterDiffuse[pixelCoord].rgb;
    UAV_ScatterDiffuse[pixelCoord] = float4(ReplaceIndirectContribution(scatter, previousIndirectDiffuse, replacedIndirectDiffuse, ssgiColor.a), 1);
#elif defined(INFINITY_SSS_ALPHA)
    if ((surfaceData.Flags & SURFACE_FLAG_SUBSURFACE) != 0)
    {
        outAlpha = max(0, outAlpha + ssgiColor.a * (Luminance(replacedIndirectDiffuse) - Luminance(previousIndirectDiffuse)));
    }
#endif
#endif

#if defined(COMPOSITE_SSR)
    float2 screenUV = (pixelCoord + 0.5) * Composite_Resolution.zw;
    float3 ndcPos = GetNDCPos(screenUV, rawDepth);
    float3 worldPos = GetWorldSpacePos(ndcPos, Matrix_InvViewFlipYJitterProj);
    float3 viewDir = normalize(ViewPositionWS() - worldPos);
    float4 ssrColor = SRV_SSRTexture[pixelCoord];
    float3 indirectSpecular = ssrColor.rgb;
    lighting = ReplaceIndirectContribution(lighting, SRV_IndirectSpecular[pixelCoord].rgb, EnvBRDFApprox(microfaceCtx.SpecularColor, microfaceCtx.RoughnessClamp, saturate(dot(surfaceData.Normal, viewDir))).rgb * indirectSpecular, ssrColor.a);
#endif

    UAV_SceneColor[pixelCoord] = float4(max(0, lighting), outAlpha);
}
