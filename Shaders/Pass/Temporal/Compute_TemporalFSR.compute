// AMD FidelityFX Super Resolution 3.1.6 Upscaler, SDK v2.4.0.
// Vendor math and its license are in FidelityFX/. This adapter declares InfinityRP bindings.
#pragma kernel FSR_Clear FSR_STAGE_CLEAR
#pragma kernel FSR_PrepareInputs FSR_STAGE_PREPARE
#pragma kernel FSR_LumaPyramid FSR_STAGE_LUMA_TILES
#pragma kernel FSR_FinalizeLuma FSR_STAGE_LUMA_FINAL
#pragma kernel FSR_ShadingPyramid FSR_STAGE_SHADING_PYRAMID
#pragma kernel FSR_ShadingChange FSR_STAGE_SHADING_CHANGE
#pragma kernel FSR_PrepareReactivity FSR_STAGE_REACTIVITY
#pragma kernel FSR_LumaInstability FSR_STAGE_INSTABILITY
#pragma kernel FSR_Accumulate FSR_STAGE_ACCUMULATE
#pragma kernel FSR_RCAS FSR_STAGE_RCAS

#pragma multi_compile_local _ FSR_REACTIVE_MASK
#pragma multi_compile_local _ FSR_SHARPEN
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.infinity.render-pipeline/Shaders/Library/ColorUtility.hlsl"
#undef PI

cbuffer CBV_TemporalFsrParameters
{
    int2 iRenderSize;
    int2 iPreviousFrameRenderSize;
    int2 iUpscaleSize;
    int2 iPreviousFrameUpscaleSize;
    int2 iMaxRenderSize;
    int2 iMaxUpscaleSize;
    float4 fDeviceToViewDepth;
    float2 fJitter;
    float2 fPreviousFrameJitter;
    float2 fMotionVectorScale;
    float2 fDownscaleFactor;
    float2 fMotionVectorJitterCancellation;
    float fTanHalfFOV;
    float fJitterSequenceLength;
    float fDeltaTime;
    float fDeltaPreExposure;
    float fViewSpaceToMetersFactor;
    float fFrameIndex;
    float fVelocityFactor;
    float fReactivenessScale;
    float fShadingChangeScale;
    float fAccumulationAddedPerFrame;
    float fMinDisocclusionAccumulation;
    uint FSR_MipCount;
    uint FSR_WorkgroupCount;
    uint FSR_Orthographic;
    float4 FSR_RcasConfig;
};

#if defined(FSR_STAGE_CLEAR)
RWStructuredBuffer<uint> rw_reconstructed_previous_nearest_depth;
RWTexture2D<float> rw_new_locks;

[numthreads(8, 8, 1)]
void FSR_Clear(uint2 pixel : SV_DispatchThreadID)
{
    if (all(pixel < (uint2)iRenderSize))
    {
#if UNITY_REVERSED_Z
        rw_reconstructed_previous_nearest_depth[pixel.y * iRenderSize.x + pixel.x] = 0;
#else
        rw_reconstructed_previous_nearest_depth[pixel.y * iRenderSize.x + pixel.x] = asuint(1.0);
#endif
    }
    if (all(pixel < (uint2)iUpscaleSize))
        rw_new_locks[pixel] = 0;
}
#else

#define FFX_GPU 1
#define FFX_HLSL 1
#define FFX_HALF 0
#define FFX_IMPLICIT_SHADER_REGISTER_BINDING_HLSL 1
#define FFX_SPD_NO_WAVE_OPERATIONS 1
#define FFX_FSR3UPSCALER_OPTION_LOW_RESOLUTION_MOTION_VECTORS 1
#define FFX_FSR3UPSCALER_OPTION_INVERTED_DEPTH UNITY_REVERSED_Z
#define FFX_FSR3UPSCALER_OPTION_HDR_COLOR_INPUT 1
#define FFX_FSR3UPSCALER_OPTION_JITTERED_MOTION_VECTORS 0
#if defined(FSR_SHARPEN)
    #define FFX_FSR3UPSCALER_OPTION_APPLY_SHARPENING 1
#else
    #define FFX_FSR3UPSCALER_OPTION_APPLY_SHARPENING 0
#endif

