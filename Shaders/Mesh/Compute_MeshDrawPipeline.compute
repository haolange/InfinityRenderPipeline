// Mesh Drawing Pipeline kernels.
// - Transform versions: every backend builds immutable per-entity transform tables from dirty-slot patches.
// - Culling: one uint per entity slot and view (frustum, or two-stage Hi-Z occlusion in MeshOcclusion.hlsl).
// - GPU indirect draw lists: ClearCounts, Compact over the pass's candidate table (one entry per element slot),
//   BuildIndirectArgs, then one DrawMeshInstancedIndirect per live command. Visible counts are never read back.
//
// Index spaces: entity slot (culling, InstanceToEntity values), element slot (candidate table), command slot
// (per pass cache), instance (position in InstanceToEntity).

#pragma kernel InitializeTransformVersion
#pragma kernel CopyTransformVersion
#pragma kernel PatchTransformVersion
#pragma kernel CullFrustum
#pragma kernel CullFirstNoHistory
#pragma kernel CullFirstWithHistory
#pragma kernel CullOcclusionRecovery
#pragma kernel ClearCounts
#pragma kernel Compact
#pragma kernel BuildIndirectArgs

#define MESH_NO_COMMAND 0xFFFFFFFFu
#define MESH_COMMAND_MASK 0x00FFFFFFu
#define MESH_LOD_SHIFT 24u
#define MESH_ENTITY_VISIBLE 4u
#define MESH_META_STRIDE 5u
#define MESH_ARGS_STRIDE 5u
#include "../Library/MeshLOD.hlsl"

struct MeshFrustumView
{
    float4 plane0;
    float4 plane1;
    float4 plane2;
    float4 plane3;
    float4 plane4;
    float4 plane5;
    uint planeCount;
    uint layerMask;
    uint sceneLow;
    uint sceneHigh;
    uint renderingLayerMask;
    uint filterRenderingLayers;
    uint lodOrthographic;
    uint reserved0;
    float lodScale;
    float lodBias;
    float lodOriginX;
    float lodOriginY;
    float lodOriginZ;
    uint reserved1;
    uint reserved2;
    uint reserved3;
};

uint _EntityCount;
uint _CommandCount;
uint _CandidateCount;
uint _DitherLod;
uint _ViewCount;
uint _EntityStride;
uint _VisibilityBase;
float4 _FrustumPlanes[6];
StructuredBuffer<MeshFrustumView> _FrustumViews;

StructuredBuffer<float4> _EntityBoundsCenter;
StructuredBuffer<float4> _EntityBoundsExtent;
StructuredBuffer<uint> _EntityFlags;
StructuredBuffer<uint> _EntityLayerMask;
StructuredBuffer<uint2> _EntitySceneCullingMask;
StructuredBuffer<uint> _EntityRenderingLayer;
uint _ViewSceneCullingMaskLow;
uint _ViewSceneCullingMaskHigh;
uint _ViewLayerMask;
uint _ViewRenderingLayerMask;
uint _FilterRenderingLayers;
RWStructuredBuffer<uint> _Visibility;

StructuredBuffer<uint> _CommandMeta;
StructuredBuffer<uint2> _CandidateTable;
RWStructuredBuffer<uint> _InstanceToEntity;
RWStructuredBuffer<float> _InstanceFade;
RWStructuredBuffer<uint> _VisibleCounts;
RWStructuredBuffer<uint> _IndirectArgs;

bool FrustumCullAABB(float3 center, float3 extent)
{
    bool culled = false;
    [unroll]
    for (int i = 0; i < 6; ++i)
    {
        float4 plane = _FrustumPlanes[i];
        float distance = dot(plane.xyz, center) + plane.w;
        float radius = dot(extent, abs(plane.xyz));
        if (distance + radius < 0.0f) culled = true;
    }
    return culled;
}

bool MeshFrustumVisible(uint entity)
{
    bool visible = false;
    bool matches = (_EntityFlags[entity] & MESH_ENTITY_VISIBLE) != 0u && (_EntityLayerMask[entity] & _ViewLayerMask) != 0u;
    if (matches && _FilterRenderingLayers != 0u)
        matches = (_EntityRenderingLayer[entity] & _ViewRenderingLayerMask) != 0u;
    if (matches)
    {
        uint2 sceneMask = _EntitySceneCullingMask[entity];
        matches = any(sceneMask & uint2(_ViewSceneCullingMaskLow, _ViewSceneCullingMaskHigh));
    }
    if (matches)
        visible = !FrustumCullAABB(_EntityBoundsCenter[entity].xyz, _EntityBoundsExtent[entity].xyz);
    return visible;
}

uint MeshCullVisibility(uint entity)
{
    uint packed = 0u;
    if (MeshFrustumVisible(entity)) packed = MeshPackLODVisibility(entity, _EntityBoundsCenter[entity].xyz, _EntityBoundsExtent[entity].xyz);
    return packed;
}

float4 MeshFrustumPlane(MeshFrustumView view, int index)
{
    float4 plane = view.plane0;
    if (index == 1) plane = view.plane1;
    else if (index == 2) plane = view.plane2;
    else if (index == 3) plane = view.plane3;
    else if (index == 4) plane = view.plane4;
    else if (index == 5) plane = view.plane5;
    return plane;
}

bool MeshViewFrustumCulled(MeshFrustumView view, float3 center, float3 extent)
{
    bool culled = false;
    [loop]
    for (int i = 0; i < 6; ++i)
    {
        if (i >= (int)view.planeCount) break;
        float4 plane = MeshFrustumPlane(view, i);
        float distance = dot(plane.xyz, center) + plane.w;
        float radius = dot(extent, abs(plane.xyz));
        if (distance + radius < 0.0f) culled = true;
    }
    return culled;
}

bool MeshFrustumVisibleInView(uint entity, MeshFrustumView view)
{
    bool visible = false;
    bool matches = (_EntityFlags[entity] & MESH_ENTITY_VISIBLE) != 0u && (_EntityLayerMask[entity] & view.layerMask) != 0u;
    if (matches && view.filterRenderingLayers != 0u)
        matches = (_EntityRenderingLayer[entity] & view.renderingLayerMask) != 0u;
    if (matches)
    {
        uint2 sceneMask = _EntitySceneCullingMask[entity];
        matches = any(sceneMask & uint2(view.sceneLow, view.sceneHigh));
    }
    if (matches)
        visible = !MeshViewFrustumCulled(view, _EntityBoundsCenter[entity].xyz, _EntityBoundsExtent[entity].xyz);
    return visible;
}

[numthreads(64, 1, 1)]
void CullFrustum(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _EntityCount || id.y >= _ViewCount) return;
    MeshFrustumView view = _FrustumViews[id.y];
    uint packed = 0u;
    if (MeshFrustumVisibleInView(id.x, view))
    {
        packed = MeshPackLODVisibility(id.x, _EntityBoundsCenter[id.x].xyz, _EntityBoundsExtent[id.x].xyz,
            float3(view.lodOriginX, view.lodOriginY, view.lodOriginZ), view.lodScale, view.lodBias, view.lodOrthographic);
    }
    _Visibility[id.y * _EntityStride + id.x] = packed;
}
#include "MeshOcclusion.hlsl"

[numthreads(64, 1, 1)]
void ClearCounts(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _CommandCount) return;
    [unroll]
    for (uint range = 0u; range < 2u; ++range)
    {
        _VisibleCounts[id.x * 2u + range] = 0u;
        uint argsBase = (id.x * 2u + range) * MESH_ARGS_STRIDE;
        _IndirectArgs[argsBase + 0u] = 0u;
        _IndirectArgs[argsBase + 1u] = 0u;
        _IndirectArgs[argsBase + 2u] = 0u;
        _IndirectArgs[argsBase + 3u] = 0u;
        _IndirectArgs[argsBase + 4u] = 0u;
    }
}

// One thread per element slot of the pass cache. A visible member of the selected LOD appends its entity to its command's
// stable range (range 0). Inside a cross-fade band of a dithering pass the outgoing level appends +f and the next level -f
// to the fading range (range 1); mirrors MeshDrawGatherJob.LODFactor.
[numthreads(64, 1, 1)]
void Compact(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _CandidateCount) return;
    uint2 candidate = _CandidateTable[id.x];
    if (candidate.y == MESH_NO_COMMAND) return;
    uint entity = candidate.x;
    uint command = candidate.y & MESH_COMMAND_MASK;
    uint elementLod = candidate.y >> MESH_LOD_SHIFT;
    if (command >= _CommandCount) return;
    uint packed = _Visibility[_VisibilityBase + entity];
    if (packed == 0u) return;

    uint level = (packed >> 8) & 0xFFu;
    uint fadeBits = packed >> 16;
    bool fading = _DitherLod != 0u && fadeBits != MESH_LOD_STABLE;
    float fade = fadeBits / 65534.0;
    uint range = 2u;
    float factor = 0.0;
    if (elementLod == level)
    {
        if (!fading) range = 0u;
        else if (fadeBits > 0u) { range = 1u; factor = fade; }
    }
    else if (fading && elementLod == level + 1u)
    {
        range = 1u;
        factor = -max(fade, 1e-6);
    }
    if (range == 2u) return;

    uint slot;
    InterlockedAdd(_VisibleCounts[command * 2u + range], 1u, slot);
    uint instance = _CommandMeta[command * MESH_META_STRIDE + 3u + range] + slot;
    _InstanceToEntity[instance] = entity;
    _InstanceFade[instance] = factor;
}

[numthreads(64, 1, 1)]
void BuildIndirectArgs(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _CommandCount) return;
    uint metaBase = id.x * MESH_META_STRIDE;
    [unroll]
    for (uint range = 0u; range < 2u; ++range)
    {
        uint argsBase = (id.x * 2u + range) * MESH_ARGS_STRIDE;
        _IndirectArgs[argsBase + 0u] = _CommandMeta[metaBase + 0u];
        _IndirectArgs[argsBase + 1u] = _VisibleCounts[id.x * 2u + range];
        _IndirectArgs[argsBase + 2u] = _CommandMeta[metaBase + 1u];
        _IndirectArgs[argsBase + 3u] = _CommandMeta[metaBase + 2u];
        _IndirectArgs[argsBase + 4u] = 0u;
    }
}

// Immutable world transform versions per entity slot. Only dirty 64-slot pages cross the CPU/GPU boundary.
struct MeshTransformPatch
{
    float4x4 objectToWorld;
    uint generation;
    uint index;
    uint2 reserved;
};
StructuredBuffer<float4x4> _TransformSourceMatrices;
StructuredBuffer<uint> _TransformSourceGenerations;
StructuredBuffer<MeshTransformPatch> _TransformChanges;
RWStructuredBuffer<float4x4> _TransformVersionMatrices;
RWStructuredBuffer<uint> _TransformVersionGenerations;
uint _TransformVersionCount, _TransformSourceCount, _TransformPatchCount;

[numthreads(64, 1, 1)]
void InitializeTransformVersion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _TransformVersionCount) return;
    _TransformVersionMatrices[id.x] = (float4x4)0;
    _TransformVersionGenerations[id.x] = 0;
}

[numthreads(64, 1, 1)]
void CopyTransformVersion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _TransformVersionCount) return;
    float4x4 transformMatrix = (float4x4)0;
    uint generation = 0;
    if (id.x < _TransformSourceCount)
    {
        transformMatrix = _TransformSourceMatrices[id.x];
        generation = _TransformSourceGenerations[id.x];
    }
    _TransformVersionMatrices[id.x] = transformMatrix;
    _TransformVersionGenerations[id.x] = generation;
}

[numthreads(64, 1, 1)]
void PatchTransformVersion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _TransformPatchCount) return;
    MeshTransformPatch patch = _TransformChanges[id.x];
    _TransformVersionMatrices[patch.index] = patch.objectToWorld;
    _TransformVersionGenerations[patch.index] = patch.generation;
}
