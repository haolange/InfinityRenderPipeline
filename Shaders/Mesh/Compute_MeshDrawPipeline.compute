// Mesh Drawing Pipeline kernels.
// - Transform versions: every backend builds immutable per-entity transform tables from dirty-slot patches.
// - GPU indirect draw lists: one producer per list. InitializeIndirectArgs, then BuildDrawList over the pass's candidate
//   table (one thread per element slot): the element's entity is tested against the list's culling context (masks, LOD,
//   frustum) and, for an occluded list, against the context's Hi-Z occluder; a passing element appends its entity to its
//   command's stable or fading range. Visible counts are never read back.
// - An occluded list records which candidates it drew; a later list of the same context and pass draws only the rest.
//
// Index spaces: entity slot (culling, InstanceToEntity values), element slot (candidate table), command slot
// (per pass cache), instance (position in InstanceToEntity).

#pragma kernel InitializeTransformVersion
#pragma kernel CopyTransformVersion
#pragma kernel PatchTransformVersion
#pragma kernel InitializeIndirectArgs
#pragma kernel BuildDrawList
#pragma kernel BuildDrawListOccluded
#pragma kernel BuildDrawListOccludedHistory

#define MESH_NO_COMMAND 0xFFFFFFFFu
#define MESH_COMMAND_MASK 0x00FFFFFFu
#define MESH_LOD_SHIFT 24u
#define MESH_ENTITY_VISIBLE 4u
#define MESH_META_STRIDE 5u
#define MESH_ARGS_STRIDE 5u
#include "../Library/MeshLOD.hlsl"

// One list's culling context; mirrors MeshCullingContext in C#.
struct MeshCullingContext
{
    float4 plane0;
    float4 plane1;
    float4 plane2;
    float4 plane3;
    float4 plane4;
    float4 plane5;
    uint planeCount;
    uint layerMask;
    uint sceneLow;
    uint sceneHigh;
    uint renderingLayerMask;
    uint filterRenderingLayers;
    uint lodOrthographic;
    float lodScale;
    float lodBias;
    float lodOriginX, lodOriginY, lodOriginZ;
};

uint _CommandCount;
uint _CandidateCount;
uint _DitherLod;
uint _ReadDrawn;
StructuredBuffer<MeshCullingContext> _CullingContext;

StructuredBuffer<float4> _EntityBoundsCenter;
StructuredBuffer<float4> _EntityBoundsExtent;
StructuredBuffer<uint> _EntityFlags;
StructuredBuffer<uint> _EntityLayerMask;
StructuredBuffer<uint2> _EntitySceneCullingMask;
StructuredBuffer<uint> _EntityRenderingLayer;

StructuredBuffer<uint> _CommandMeta;
StructuredBuffer<uint2> _CandidateTable;
RWStructuredBuffer<uint> _InstanceToEntity;
RWStructuredBuffer<float> _InstanceFade;
RWStructuredBuffer<uint> _IndirectArgs;
RWStructuredBuffer<uint> _DrawnCandidates;

#include "MeshOcclusion.hlsl"

bool MeshEligible(uint entity, MeshCullingContext context)
{
    bool matches = (_EntityFlags[entity] & MESH_ENTITY_VISIBLE) != 0u && (_EntityLayerMask[entity] & context.layerMask) != 0u;
    if (matches && context.filterRenderingLayers != 0u)
        matches = (_EntityRenderingLayer[entity] & context.renderingLayerMask) != 0u;
    if (matches)
    {
        uint2 sceneMask = _EntitySceneCullingMask[entity];
        matches = any(sceneMask & uint2(context.sceneLow, context.sceneHigh));
    }
    return matches;
}

float4 MeshContextPlane(MeshCullingContext context, int index)
{
    float4 plane = context.plane0;
    if (index == 1) plane = context.plane1;
    else if (index == 2) plane = context.plane2;
    else if (index == 3) plane = context.plane3;
    else if (index == 4) plane = context.plane4;
    else if (index == 5) plane = context.plane5;
    return plane;
}

// Mirrors MeshDrawGatherJob.OutsidePlanes; precise keeps every list of a context on one answer.
bool MeshFrustumCulled(MeshCullingContext context, float3 center, float3 extent)
{
    bool culled = false;
    [loop]
    for (int i = 0; i < 6; ++i)
    {
        if (i >= (int)context.planeCount) break;
        float4 plane = MeshContextPlane(context, i);
        precise float distance = dot(plane.xyz, center) + plane.w;
        precise float radius = dot(extent, abs(plane.xyz));
        if (distance + radius < 0.0f) culled = true;
    }
    return culled;
}

// Which range of its command an element of level elementLod fills (0 stable, 1 fading) and its signed dither factor.
// Inside a band of a dithering pass the outgoing level draws +f and the next level -f; mirrors MeshDrawLod.Factor.
bool MeshElementRange(uint packed, uint elementLod, out uint range, out float factor)
{
    range = 2u;
    factor = 0.0;
    if (packed != 0u)
    {
        uint level = (packed >> 8) & 0xFFu;
        uint fadeBits = packed >> 16;
        bool fading = _DitherLod != 0u && fadeBits != MESH_LOD_STABLE;
        float fade = fadeBits / 65534.0;
        if (elementLod == level)
        {
            if (!fading) range = 0u;
            else if (fadeBits > 0u) { range = 1u; factor = fade; }
        }
        else if (fading && elementLod == level + 1u)
        {
            range = 1u;
            factor = -max(fade, 1e-6);
        }
    }
    return range != 2u;
}

// occluded and history are literals at each kernel, so the plain kernel binds no occluder and no drawn table, and the
// current-frame occluder binds no transform versions.
void BuildDrawListCore(uint candidateIndex, bool occluded, bool history)
{
    uint2 candidate = _CandidateTable[candidateIndex];
    bool drawn = false;
    if (occluded)
    {
        if (_ReadDrawn != 0u) drawn = _DrawnCandidates[candidateIndex] != 0u;
    }
    bool append = false;
    uint entity = candidate.x;
    uint command = candidate.y & MESH_COMMAND_MASK;
    uint range = 2u;
    float factor = 0.0;
    if (candidate.y != MESH_NO_COMMAND && !drawn && command < _CommandCount)
    {
        MeshCullingContext context = _CullingContext[0];
        if (MeshEligible(entity, context))
        {
            float3 center = _EntityBoundsCenter[entity].xyz;
            float3 extent = _EntityBoundsExtent[entity].xyz;
            uint packed = MeshPackLODVisibility(entity, center, extent, float3(context.lodOriginX, context.lodOriginY, context.lodOriginZ),
                context.lodScale, context.lodBias, context.lodOrthographic);
            if (MeshElementRange(packed, candidate.y >> MESH_LOD_SHIFT, range, factor))
                append = !MeshFrustumCulled(context, center, extent);
            if (append && occluded)
            {
                // The previous frame's pyramid proves nothing about an entity that moved since.
                bool testable = true;
                if (history) testable = MeshHasStableHistory(entity);
                if (testable) append = !MeshOccluded(center, extent);
            }
        }
    }
    if (append)
    {
        uint slot;
        uint argsBase = (command * 2u + range) * MESH_ARGS_STRIDE;
        InterlockedAdd(_IndirectArgs[argsBase + 1u], 1u, slot);
        uint instance = _CommandMeta[command * MESH_META_STRIDE + 3u + range] + slot;
        _InstanceToEntity[instance] = entity;
        _InstanceFade[instance] = factor;
    }
    if (occluded) _DrawnCandidates[candidateIndex] = (drawn || append) ? 1u : 0u;
}

[numthreads(64, 1, 1)]
void InitializeIndirectArgs(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _CommandCount) return;
    uint metaBase = id.x * MESH_META_STRIDE;
    [unroll]
    for (uint range = 0u; range < 2u; ++range)
    {
        uint argsBase = (id.x * 2u + range) * MESH_ARGS_STRIDE;
        _IndirectArgs[argsBase + 0u] = _CommandMeta[metaBase + 0u];
        _IndirectArgs[argsBase + 1u] = 0u;
        _IndirectArgs[argsBase + 2u] = _CommandMeta[metaBase + 1u];
        _IndirectArgs[argsBase + 3u] = _CommandMeta[metaBase + 2u];
        _IndirectArgs[argsBase + 4u] = 0u;
    }
}

[numthreads(64, 1, 1)]
void BuildDrawList(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CandidateCount) BuildDrawListCore(id.x, false, false);
}

[numthreads(64, 1, 1)]
void BuildDrawListOccluded(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CandidateCount) BuildDrawListCore(id.x, true, false);
}

[numthreads(64, 1, 1)]
void BuildDrawListOccludedHistory(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CandidateCount) BuildDrawListCore(id.x, true, true);
}

// Immutable world transform versions per entity slot. Only dirty 64-slot pages cross the CPU/GPU boundary.
struct MeshTransformPatch
{
    float4x4 objectToWorld;
    uint generation;
    uint index;
    uint2 reserved;
};
StructuredBuffer<float4x4> _TransformSourceMatrices;
StructuredBuffer<uint> _TransformSourceGenerations;
StructuredBuffer<MeshTransformPatch> _TransformChanges;
RWStructuredBuffer<float4x4> _TransformVersionMatrices;
RWStructuredBuffer<uint> _TransformVersionGenerations;
uint _TransformVersionCount, _TransformSourceCount, _TransformPatchCount;

[numthreads(64, 1, 1)]
void InitializeTransformVersion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _TransformVersionCount) return;
    _TransformVersionMatrices[id.x] = (float4x4)0;
    _TransformVersionGenerations[id.x] = 0;
}

[numthreads(64, 1, 1)]
void CopyTransformVersion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _TransformVersionCount) return;
    float4x4 transformMatrix = (float4x4)0;
    uint generation = 0;
    if (id.x < _TransformSourceCount)
    {
        transformMatrix = _TransformSourceMatrices[id.x];
        generation = _TransformSourceGenerations[id.x];
    }
    _TransformVersionMatrices[id.x] = transformMatrix;
    _TransformVersionGenerations[id.x] = generation;
}

[numthreads(64, 1, 1)]
void PatchTransformVersion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _TransformPatchCount) return;
    MeshTransformPatch patch = _TransformChanges[id.x];
    _TransformVersionMatrices[patch.index] = patch.objectToWorld;
    _TransformVersionGenerations[patch.index] = patch.generation;
}
