#pragma kernel CaptureTexture
Texture2D<float4> SRV_Capture;
RWTexture2D<float4> UAV_Capture;
float4 CaptureSize;
[numthreads(8, 8, 1)]
void CaptureTexture(uint3 id : SV_DispatchThreadID)
{
    if (all(id.xy < (uint2)CaptureSize.xy)) UAV_Capture[id.xy] = SRV_Capture.Load(int3(id.xy, 0));
}

#pragma kernel CaptureSurfaceMetadata
#include "Packages/com.infinity.render-pipeline/Shaders/Library/ScreenSpaceSurfaceMetadata.hlsl"
Texture2D<uint> SRV_CaptureMetadata;
// xy: octahedral normal, z: sample age, w: 0.
[numthreads(8,8,1)]
void CaptureSurfaceMetadata(uint3 id : SV_DispatchThreadID)
{
    if (all(id.xy < (uint2)CaptureSize.xy)) UAV_Capture[id.xy] = float4(DecodeSurfaceMetadata(SRV_CaptureMetadata.Load(int3(id.xy, 0))), 0);
}

#pragma kernel CaptureRadiance
#include "../Library/ScreenSpaceRadiance.hlsl"
Texture2DArray<float2> SRV_CaptureRadiance;
int CaptureSourceMip;

[numthreads(8, 8, 1)]
void CaptureRadiance(uint3 id : SV_DispatchThreadID)
{
    if (all(id.xy < (uint2)CaptureSize.xy))
        UAV_Capture[id.xy] = LoadScreenSpaceRadiance(SRV_CaptureRadiance, id.xy, CaptureSourceMip);
}

#pragma kernel CaptureIrradiance
Texture2D<float> SRV_CaptureConfidence;

[numthreads(8, 8, 1)]
void CaptureIrradiance(uint3 id : SV_DispatchThreadID)
{
    if (all(id.xy < (uint2)CaptureSize.xy))
        UAV_Capture[id.xy] = float4(SRV_Capture.Load(int3(id.xy, 0)).rgb, SRV_CaptureConfidence.Load(int3(id.xy, 0)));
}
