#include "Packages/com.infinity.render-pipeline/Shaders/ShaderLibrary/TextureView.hlsl"
#pragma kernel DeferredShadingCS
#pragma multi_compile_local _ DEFERRED_AO
#pragma multi_compile_local _ DEFERRED_CONTACT_SHADOW

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/GBufferPack.hlsl"
#include "../../ShaderLibrary/BSDF.hlsl"
#include "../../ShaderLibrary/ShadingModel.hlsl"
#include "../../ShaderLibrary/Lighting.hlsl"
#include "../../ShaderLibrary/ImageBasedLighting.hlsl"

StructuredBuffer<float4> _AtmosphereSkySH;
Texture2DArray<float4> _AtmosphereGGXPrefilter;
float _AtmosphereIBLMaxMip;

float4 DeferredShading_Resolution;
float DeferredShading_FarDepth;
float4x4 Matrix_InvProj;
float4x4 Matrix_InvViewProj;
float3 _WorldSpaceCameraPos;

Texture2D SRV_GBufferTextureA;
Texture2D SRV_GBufferTextureB;
Texture2D SRV_GBufferTextureC;
Texture2D<float> SRV_DepthTexture;
#if defined(DEFERRED_AO)
Texture2D<float> SRV_OcclusionTexture;
#endif

Texture2D<float4> SRV_BakedDiffuse, SRV_BakedOcclusion;
RWTexture2D<float4> UAV_IndirectDiffuse, UAV_IndirectSpecular;
RWTexture2D<float4> UAV_LightingTexture;

#include "../../ShaderLibrary/SurfaceLighting.hlsl"

[numthreads(16, 16, 1)]
void DeferredShadingCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)DeferredShading_Resolution.xy))
        return;

    float2 screenUV = (id.xy + 0.5) * DeferredShading_Resolution.zw;
    uint2 pixelCoord = id.xy;

    float rawDepth = SRV_DepthTexture[pixelCoord];
    if (abs(rawDepth - DeferredShading_FarDepth) <= 1e-5)
    {
        UAV_LightingTexture[pixelCoord] = 0;
        UAV_IndirectDiffuse[pixelCoord] = 0;
        UAV_IndirectSpecular[pixelCoord] = 0;
        return;
    }

    FGBufferData gbufferData;
    DecodeGBuffer(pixelCoord, SRV_GBufferTextureA, SRV_GBufferTextureB, SRV_GBufferTextureC, SRV_GBufferTextureA_InfinityView, gbufferData);

    if ((gbufferData.Flags & GBUFFER_FLAG_FORWARD) != 0)
    {
        UAV_IndirectDiffuse[pixelCoord] = 0;
        UAV_IndirectSpecular[pixelCoord] = 0;
        return;
    }
    float3 albedo = gbufferData.Albedo;
    float3 normal = gbufferData.Normal;
    float roughness = gbufferData.Roughness;
    float reflectance = gbufferData.Reflactance;
    float specular = gbufferData.Specular;

    float3 ndcPos = GetNDCPos(screenUV, rawDepth);
    float3 worldPos = GetWorldSpacePos(ndcPos, Matrix_InvViewProj);
    float3 viewDir = normalize(_WorldSpaceCameraPos - worldPos);
    float3 viewPos = GetViewSpacePos(ndcPos, Matrix_InvProj);
    float viewDepth = -viewPos.z;

    MicrofaceContext microfaceCtx = InitMicrofaceContext(specular, roughness, reflectance, albedo);

#if defined(DEFERRED_AO)
    float ao = InfinitySampleLevel(SRV_OcclusionTexture,Global_point_clamp_sampler,screenUV,0);
#else
    float ao = 1.0;
#endif
#if defined(DEFERRED_CONTACT_SHADOW)
    float contactShadow = SRV_ContactShadowSun[pixelCoord];
    uint contactMask = SRV_ContactShadowMask[pixelCoord];
#else
    float contactShadow = 1.0;
    uint contactMask = 0;
#endif
    float4 bakedMask = 1 - SRV_BakedOcclusion[pixelCoord];
    float3 lighting = 0;

    for (int d = 0; d < g_DirectionalLightCount; ++d)
    {
        if ((g_LightRecordBuffer[d].lightLayer & gbufferData.RenderingLayer) == 0) continue;
        lighting += EvaluateDirectional(g_LightRecordBuffer[d], worldPos, normal, viewDir, microfaceCtx, d == g_SunRecordIndex ? contactShadow : 1.0, viewDepth, bakedMask);
    }

    FLightLoop lightLoop;
    BeginLightLoop(pixelCoord, viewDepth, lightLoop);
    uint recordIndex;
    [loop]
    while (NextLight(lightLoop, recordIndex))
    {
        FLightRecord light = g_LightRecordBuffer[recordIndex];
        if ((light.lightLayer & gbufferData.RenderingLayer) == 0) continue;
        lighting += EvaluateLocal(light, worldPos, normal, viewDir, microfaceCtx, bakedMask, viewDepth, contactMask);
    }

    float4 baked = SRV_BakedDiffuse[pixelCoord];
    float3 diffuse = microfaceCtx.AlbedoColor * (baked.a > 0 ? baked.rgb : EvaluateSH2Irradiance(normal, _AtmosphereSkySH)) * ao;
    // Specular environment: reflection probes front to back, the sky for the remainder (SSR replaces it by confidence).
    float3 reflectionWS = reflect(-viewDir, normal);
    float3 sky = SampleGGXCubemapArray(_AtmosphereGGXPrefilter, reflectionWS, microfaceCtx.RoughnessClamp, _AtmosphereIBLMaxMip);
    float3 specularIBL = BlendReflectionProbesWithSky(worldPos, reflectionWS, microfaceCtx.RoughnessClamp, pixelCoord, viewDepth, sky)
        * EnvBRDFApprox(microfaceCtx.SpecularColor, microfaceCtx.RoughnessClamp, saturate(dot(normal, viewDir))).rgb * ao;
    UAV_IndirectDiffuse[pixelCoord] = float4(diffuse, 1);
    UAV_IndirectSpecular[pixelCoord] = float4(specularIBL, 1);
    lighting += diffuse + specularIBL;

    float3 emissive = UAV_LightingTexture[pixelCoord].rgb;
    UAV_LightingTexture[pixelCoord] = float4(max(0, lighting) + emissive, 1);
}
