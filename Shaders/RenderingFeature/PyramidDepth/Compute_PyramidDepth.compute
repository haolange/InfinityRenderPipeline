#pragma kernel HiZ_Generation
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

float4 _SrcSize;
float4 _DstSize;
int _CopySource;
int _MipWriteCount;
int _SrcMip;
Texture2D<float> _PrevMipDepth;
RWTexture2D<float> _HierarchicalDepth0;
RWTexture2D<float> _HierarchicalDepth1;
RWTexture2D<float> _HierarchicalDepth2;
RWTexture2D<float> _HierarchicalDepth3;

float HiZClosest(float a, float b)
{
#if UNITY_REVERSED_Z
    return max(a, b);
#else
    return min(a, b);
#endif
}

// Every batch reads only the previous completed mip. Each last output cell owns
// the trailing odd row/column, including dimensions that have already reached 1.
float ReduceDepth(uint2 pixel, int mip)
{
    uint2 srcSize = (uint2)_SrcSize.xy;
    uint2 dstSize = max(uint2(1, 1), (uint2)_DstSize.xy >> mip);
    uint scale = 1u << (mip + (_CopySource != 0 ? 0 : 1));
    uint2 begin = min(pixel * scale, srcSize - 1);
    uint2 end = min(begin + scale, srcSize);
    if (pixel.x == dstSize.x - 1) end.x = srcSize.x;
    if (pixel.y == dstSize.y - 1) end.y = srcSize.y;
    float depth = _PrevMipDepth.Load(int3(begin, _SrcMip));
    for (uint y = begin.y; y < end.y; ++y)
        for (uint x = begin.x; x < end.x; ++x)
            depth = HiZClosest(depth, _PrevMipDepth.Load(int3(x, y, _SrcMip)));
    return depth;
}

[numthreads(8, 8, 1)]
void HiZ_Generation(uint3 id : SV_DispatchThreadID)
{
    uint2 size = (uint2)_DstSize.xy;
    if (_MipWriteCount > 0 && all(id.xy < size))
        _HierarchicalDepth0[id.xy] = ReduceDepth(id.xy, 0);
    if (_MipWriteCount > 1 && all(id.xy < max(uint2(1, 1), size >> 1)))
        _HierarchicalDepth1[id.xy] = ReduceDepth(id.xy, 1);
    if (_MipWriteCount > 2 && all(id.xy < max(uint2(1, 1), size >> 2)))
        _HierarchicalDepth2[id.xy] = ReduceDepth(id.xy, 2);
    if (_MipWriteCount > 3 && all(id.xy < max(uint2(1, 1), size >> 3)))
        _HierarchicalDepth3[id.xy] = ReduceDepth(id.xy, 3);
}
