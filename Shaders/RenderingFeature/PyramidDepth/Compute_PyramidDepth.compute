#pragma kernel HiZ_Generation
#pragma kernel HiZ_FurthestGeneration
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

float4 _HiZSourceSize, _HiZDestinationSize;
int _HiZSourceMip, _HiZRawSource, _HiZMipWriteCount;
Texture2D<float> _HiZRawDepth;
Texture2D<float> _HiZSourceClosest;
Texture2D<float> _HiZSourceFurthest;
RWTexture2D<float> _HiZClosest0;
RWTexture2D<float> _HiZClosest1;
RWTexture2D<float> _HiZClosest2;
RWTexture2D<float> _HiZClosest3;
RWTexture2D<float> _HiZFurthest0;
RWTexture2D<float> _HiZFurthest1;
RWTexture2D<float> _HiZFurthest2;
RWTexture2D<float> _HiZFurthest3;

float2 ReduceHiZ(uint2 pixel, uint level, bool closestNeeded)
{
    uint2 sourceSize = (uint2)_HiZSourceSize.xy;
    uint2 destinationSize = max(uint2(1, 1), (uint2)_HiZDestinationSize.xy >> level);
    uint scale = 1u << (level + 1);
    uint2 begin = min(pixel * scale, sourceSize - 1);
    uint2 end = min(begin + scale, sourceSize);
    if (pixel.x == destinationSize.x - 1) end.x = sourceSize.x;
    if (pixel.y == destinationSize.y - 1) end.y = sourceSize.y;
#if UNITY_REVERSED_Z
    float2 result = float2(0, 1);
#else
    float2 result = float2(1, 0);
#endif
    for (uint y = begin.y; y < end.y; ++y)
        for (uint x = begin.x; x < end.x; ++x)
        {
            float2 depths = 0;
            if (_HiZRawSource != 0) depths = _HiZRawDepth.Load(int3(x, y, 0)).xx;
            else
            {
                depths.y = _HiZSourceFurthest.Load(int3(x, y, _HiZSourceMip));
                if (closestNeeded) depths.x = _HiZSourceClosest.Load(int3(x, y, _HiZSourceMip));
            }
#if UNITY_REVERSED_Z
            if (closestNeeded) result.x = max(result.x, depths.x);
            result.y = min(result.y, depths.y);
#else
            if (closestNeeded) result.x = min(result.x, depths.x);
            result.y = max(result.y, depths.y);
#endif
        }
    return result;
}

void GenerateHiZ(uint2 pixel, bool closestNeeded)
{
    uint2 size = (uint2)_HiZDestinationSize.xy;
    if (_HiZMipWriteCount > 0 && all(pixel < size))
    {
        float2 value = ReduceHiZ(pixel, 0, closestNeeded);
        if (closestNeeded) _HiZClosest0[pixel] = value.x;
        _HiZFurthest0[pixel] = value.y;
    }
    if (_HiZMipWriteCount > 1 && all(pixel < max(uint2(1, 1), size >> 1)))
    {
        float2 value = ReduceHiZ(pixel, 1, closestNeeded);
        if (closestNeeded) _HiZClosest1[pixel] = value.x;
        _HiZFurthest1[pixel] = value.y;
    }
    if (_HiZMipWriteCount > 2 && all(pixel < max(uint2(1, 1), size >> 2)))
    {
        float2 value = ReduceHiZ(pixel, 2, closestNeeded);
        if (closestNeeded) _HiZClosest2[pixel] = value.x;
        _HiZFurthest2[pixel] = value.y;
    }
    if (_HiZMipWriteCount > 3 && all(pixel < max(uint2(1, 1), size >> 3)))
    {
        float2 value = ReduceHiZ(pixel, 3, closestNeeded);
        if (closestNeeded) _HiZClosest3[pixel] = value.x;
        _HiZFurthest3[pixel] = value.y;
    }
}

[numthreads(8, 8, 1)]
void HiZ_Generation(uint3 id : SV_DispatchThreadID) { GenerateHiZ(id.xy, true); }
[numthreads(8, 8, 1)]
void HiZ_FurthestGeneration(uint3 id : SV_DispatchThreadID) { GenerateHiZ(id.xy, false); }
