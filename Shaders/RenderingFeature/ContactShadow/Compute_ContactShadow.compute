// Screen-space traced (contact) shadows from the depth buffer.
//   Sun: one ray toward the sun record (g_SunRecordIndex) -> UAV_ContactShadowSun (R8, 1 = lit), soft by intensity and
//        distance fade.
//   Local lights: every light of the pixel's clustered list that owns a contact bit (record.misc.z) traces toward its
//        position -> UAV_ContactShadowMask (R32_UInt: bits 0..23 = occluded lights, bits 24..31 = strength).
// Hits compare linear view depths against a constant surface thickness; ray starts are jittered per pixel and frame.
#pragma kernel ContactShadowCS

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/Lighting.hlsl"
#include "../../ShaderLibrary/Lighting/LightLoop.hlsl"
#include "../../ShaderLibrary/Lighting/LightShapes.hlsl"
#include "../../ShaderLibrary/Random.hlsl"

int ContactShadow_NumSteps;
int ContactShadow_SunNumSteps;
int ContactShadow_FrameIndex;
float ContactShadow_MaxDistance;
float ContactShadow_Thickness;
float ContactShadow_Intensity;
float ContactShadow_FadeDistance;
float4 ContactShadow_Resolution;
// x, y = m22, m23 of the GPU projection; z = 1 for orthographic cameras.
float4 ContactShadow_DepthParams;

float4x4 Matrix_ViewProj;
float4x4 Matrix_InvViewProj;
float3 _WorldSpaceCameraPos;

Texture2D<float> SRV_DepthTexture;
RWTexture2D<float> UAV_ContactShadowSun;
RWTexture2D<uint> UAV_ContactShadowMask;

float ContactLinearDepth(float rawDepth)
{
    return ContactShadow_DepthParams.z != 0
        ? (ContactShadow_DepthParams.y - rawDepth) / ContactShadow_DepthParams.x
        : ContactShadow_DepthParams.y / (rawDepth + ContactShadow_DepthParams.x);
}

// True when the ray from worldPos along dir (rayLength meters) passes behind the depth buffer within the thickness.
bool TraceContactShadow(float3 worldPos, float3 dir, float rayLength, int steps, float jitter)
{
    steps = max(steps, 1);
    [loop]
    for (int i = 0; i < steps; ++i)
    {
        float t = (i + jitter) / steps;
        float4 clip = mul(Matrix_ViewProj, float4(worldPos + dir * (rayLength * t), 1.0));
        if (clip.w <= 0.0) return false;
        float3 ndc = clip.xyz / clip.w;
        float2 uv = ndc.xy * 0.5 + 0.5;
#if UNITY_UV_STARTS_AT_TOP
        uv.y = 1.0 - uv.y;
#endif
        if (any(uv < 0.0) || any(uv > 1.0)) return false;
        float sceneDepth = ContactLinearDepth(SRV_DepthTexture.SampleLevel(Global_point_clamp_sampler, uv, 0));
        float rayDepth = ContactShadow_DepthParams.z != 0 ? ContactLinearDepth(ndc.z) : clip.w;
        float delta = rayDepth - sceneDepth;
        // A small relative bias keeps the receiver itself from occluding the start of its ray.
        if (delta > 1e-3 * rayDepth && delta < ContactShadow_Thickness) return true;
    }
    return false;
}

[numthreads(8, 8, 1)]
void ContactShadowCS(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)ContactShadow_Resolution.xy))
        return;

    float2 screenUV = (id.xy + 0.5) * ContactShadow_Resolution.zw;
    float rawDepth = SRV_DepthTexture.SampleLevel(Global_point_clamp_sampler, screenUV, 0);
    float sun = 1.0;
    uint mask = 0u;

    float viewDepth = ContactLinearDepth(rawDepth);
    float3 worldPos = GetWorldSpacePos(GetNDCPos(screenUV, rawDepth), Matrix_InvViewProj);
    float viewDist = length(worldPos - _WorldSpaceCameraPos);
    float distanceFade = 1.0 - saturate((viewDist - ContactShadow_FadeDistance * 0.8) / (ContactShadow_FadeDistance * 0.2));
    float strength = ContactShadow_Intensity * distanceFade;
    // Sky pixels and faded-out pixels trace nothing.
    if (rawDepth > 1e-7 && strength > 0)
    {
        float jitter = InterleavedGradientNoise(id.xy, ContactShadow_FrameIndex);

        if (g_SunRecordIndex >= 0 && g_SunRecordIndex < g_DirectionalLightCount)
        {
            FLightRecord sunLight = g_LightRecordBuffer[g_SunRecordIndex];
            if ((sunLight.flags & LIGHT_FLAG_CONTACT) != 0
                && TraceContactShadow(worldPos, DirectionalLightL(sunLight), ContactShadow_MaxDistance, ContactShadow_SunNumSteps, jitter))
            {
                sun = 1.0 - strength;
            }
        }

        FLightLoop lightLoop = BeginLightLoop(id.xy, viewDepth);
        uint recordIndex;
        [loop]
        while (NextLight(lightLoop, recordIndex))
        {
            FLightRecord light = g_LightRecordBuffer[recordIndex];
            int bit = LightContactShadowBit(light);
            if (bit < 0 || LocalLightWindow(light, worldPos) <= 0)
            {
                continue;
            }
            float3 dir;
            float rayLength = ContactShadow_MaxDistance;
            if (LightHasFlag(light, LIGHT_FLAG_SPOT_BOX))
            {
                dir = -light.forward.xyz;
            }
            else
            {
                float3 toLight = light.positionRange.xyz - worldPos;
                float distance = length(toLight);
                dir = toLight / max(distance, 1e-4);
                // Stop before the emitter: a sphere or tube source does not occlude its own ray.
                rayLength = min(rayLength, max(distance - light.shape.x, 0.0));
            }
            if (rayLength > 0 && TraceContactShadow(worldPos, dir, rayLength, ContactShadow_NumSteps, jitter))
            {
                mask |= 1u << (uint)bit;
            }
        }
        if (mask != 0u)
        {
            mask |= (uint)round(saturate(strength) * 255.0) << 24;
        }
    }

    UAV_ContactShadowSun[id.xy] = sun;
    UAV_ContactShadowMask[id.xy] = mask;
}
