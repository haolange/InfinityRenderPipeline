#pragma kernel Main
#pragma kernel MainDebug TAA_WRITE_DIAGNOSTICS

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDepth.hlsl"

float4 TAA_Resolution;
float4 TAA_JitterUV; // current xy, previous zw, in sampled framebuffer UV.
float TAA_ResetBlend;
static const float TAA_Sharpness = 0.35;
Texture2D<float4> SRV_AliasingColorTexture;
Texture2D<float4> SRV_HistoryColorTexture;
Texture2D<float> SRV_HistoryDepthTexture;
Texture2D<float2> SRV_MotionTexture;
Texture2D<float4> SRV_MotionMetadata;
Texture2D<float> SRV_ReactiveMaskTexture;
RWTexture2D<float4> UAV_AccumulateColorTexture;
RWTexture2D<float4> UAV_SharpenedColorTexture;
RWTexture2D<float> UAV_TemporalDepthTexture;
#if defined(TAA_WRITE_DIAGNOSTICS)
RWTexture2D<float4> UAV_TAADiagnostics;
RWTexture2D<float4> UAV_TAAReprojection;
#endif

float3 TaaCompress(float3 rgb)
{
    rgb = max(rgb, 0);
    return rgb / (1 + dot(rgb, float3(0.2126, 0.7152, 0.0722)));
}
float3 TaaExpand(float3 color)
{
    color = max(YCoCg2RGB(color), 0);
    return min(color / max(1.0 / 65504, 1 - dot(color, float3(0.2126, 0.7152, 0.0722))), 65504);
}
int2 TaaClampPixel(int2 pixel)
{
    return clamp(pixel, 0, int2(TAA_Resolution.xy) - 1);
}
float3 TaaClip(float3 value, float3 low, float3 high)
{
    float3 center = (low + high) * 0.5;
    float3 extent = max((high - low) * 0.5, 1e-5);
    float3 delta = value - center;
    return center + delta / max(1, max3(abs(delta.x / extent.x), abs(delta.y / extent.y), abs(delta.z / extent.z)));
}
bool TaaDepthMatches(float expected, float actual)
{
    bool expectedFar = ScreenSpaceIsFarDepth(expected);
    bool actualFar = ScreenSpaceIsFarDepth(actual);
    if (expectedFar || actualFar) return expectedFar && actualFar;
    float a = ScreenSpaceLinearEyeDepth(expected);
    float b = ScreenSpaceLinearEyeDepth(actual);
    return abs(a - b) <= max(0.002, 0.005 * a);
}
float4 TaaCubicWeights(float f)
{
    float f2 = f * f, f3 = f2 * f;
    return float4(-0.5*f + f2 - 0.5*f3, 1 - 2.5*f2 + 1.5*f3,
        0.5*f + 2*f2 - 1.5*f3, -0.5*f2 + 0.5*f3);
}
// Depth history preserves raster samples; color history is a stable-grid resolve.
// These two lookups must not share the jitter offset.
float TaaDepthCoverage(float2 depthUV, float expectedDepth)
{
    if (any(depthUV < 0) || any(depthUV >= 1)) return 0;
    float2 texel = depthUV * TAA_Resolution.xy - 0.5;
    int2 base = (int2)floor(texel);
    float2 phase = frac(texel);
    float coverage = 0;
    [unroll] for (int y = 0; y < 2; y++)
    [unroll] for (int x = 0; x < 2; x++)
    {
        int2 pixel = base + int2(x, y);
        if (any(pixel < 0) || any(pixel >= int2(TAA_Resolution.xy))) continue;
        float weight = (x == 0 ? 1 - phase.x : phase.x) * (y == 0 ? 1 - phase.y : phase.y);
        if (TaaDepthMatches(expectedDepth, SRV_HistoryDepthTexture.Load(int3(pixel, 0)))) coverage += weight;
    }
    return saturate(coverage);
}
bool TaaReadHistory(float2 colorUV, float2 depthUV, float expectedDepth, out float4 history, out float coverage)
{
    history = 0; coverage = 0;
    if (any(colorUV < 0) || any(colorUV >= 1)) return false;
    coverage = TaaDepthCoverage(depthUV, expectedDepth);
    // A matching footprint is a geometric witness, not a temporal blend probability.
    // Multiplying sample age by bilinear phase repeatedly resets static silhouette pixels.
    if (coverage <= 0) return false;
    float2 texel = colorUV * TAA_Resolution.xy - 0.5;
    int2 base = (int2)floor(texel);
    float2 phase = frac(texel);
    float4 wx = TaaCubicWeights(phase.x), wy = TaaCubicWeights(phase.y);
    float3 low = 1e20, high = -1e20;
    float sum = 0;
    [unroll] for (int y = 0; y < 4; y++)
    [unroll] for (int x = 0; x < 4; x++)
    {
        float weight = wx[x] * wy[y];
        if (abs(weight) < 1e-8) continue;
        int2 pixel = base + int2(x - 1, y - 1);
        if (any(pixel < 0) || any(pixel >= int2(TAA_Resolution.xy))) continue;
        float4 value = SRV_HistoryColorTexture.Load(int3(pixel, 0));
        if (!all(isfinite(value)) || value.a < 1) continue;
        low = min(low, value.rgb); high = max(high, value.rgb);
        history += value * weight; sum += weight;
    }
    if (sum <= 0.05) return false;
    history /= sum;
    history.rgb = RGB2YCoCg(TaaCompress(clamp(history.rgb, low, high)));
    history.a = clamp(history.a, 1, 32);
    return true;
}
float4 ResolveTemporalPixel(int2 pixel, out float depth, out float4 diagnostics, out float4 reprojection)
{
    float2 uv = (pixel + 0.5) * TAA_Resolution.zw;
    float2 velocity = SRV_MotionTexture.Load(int3(pixel, 0));
    float4 metadata = SRV_MotionMetadata.Load(int3(pixel, 0));
    float2 historyUV = uv - velocity;
    float2 historyDepthUV = historyUV + TAA_JitterUV.zw - TAA_JitterUV.xy;
    float3 currentLinear = max(SRV_AliasingColorTexture.Load(int3(pixel, 0)).rgb, 0);
    float3 current = RGB2YCoCg(TaaCompress(currentLinear));
    float3 linearLow = currentLinear, linearHigh = currentLinear;
    float3 mean = 0, moment = 0, neighborhoodLow = 1e20, neighborhoodHigh = -1e20;
    [unroll] for (int y = -1; y <= 1; y++)
    [unroll] for (int x = -1; x <= 1; x++)
    {
        float3 sampleLinear = max(SRV_AliasingColorTexture.Load(int3(TaaClampPixel(pixel + int2(x, y)), 0)).rgb, 0);
        linearLow = min(linearLow, sampleLinear); linearHigh = max(linearHigh, sampleLinear);
        float3 value = RGB2YCoCg(TaaCompress(sampleLinear));
        mean += value; moment += value * value;
        neighborhoodLow = min(neighborhoodLow, value); neighborhoodHigh = max(neighborhoodHigh, value);
    }
    mean /= 9;
    float3 deviation = sqrt(max(moment / 9 - mean * mean, 0));
    float3 low = max(neighborhoodLow, min(current, mean - 1.25 * deviation));
    float3 high = min(neighborhoodHigh, max(current, mean + 1.25 * deviation));
    float4 history = 0;
    float coverage = 0, weight = 0, count = 1;
    // 1 reset, 2 invalid motion, 3 offscreen, 4 depth/footprint rejection.
    float reason = TAA_ResetBlend <= 0 ? 1 : metadata.z <= 0 ? 2 : any(historyUV < 0) || any(historyUV >= 1) ? 3 : 4;
    bool valid = TAA_ResetBlend > 0 && metadata.z > 0 && all(isfinite(velocity));
    if (valid) valid = TaaReadHistory(historyUV, historyDepthUV, metadata.x, history, coverage);
    if (valid)
    {
        float pixelsMoved = length(velocity * TAA_Resolution.xy);
        float limit = lerp(32, 4, saturate(pixelsMoved / 8));
        float samples = min(history.a, limit);
        float reactive = saturate(SRV_ReactiveMaskTexture.Load(int3(pixel, 0)));
        weight = samples / (samples + 1) * TAA_ResetBlend * (1 - reactive);
        history.rgb = TaaClip(history.rgb, low, high);
        count = min(32, 1 + samples * TAA_ResetBlend * (1 - reactive));
        reason = reactive >= 1 ? 5 : 0;
    }
    float3 result = valid ? lerp(currentLinear, clamp(TaaExpand(history.rgb), linearLow, linearHigh), weight) : currentLinear;
    depth = metadata.y;
    diagnostics = float4(valid ? coverage : 0, weight, reason, count);
    reprojection = float4(historyUV, historyDepthUV);
    return float4(min(result, 65504), count);
}

// Every group solves its own halo, so no cross-group producer ordering is required.
groupshared float3 TemporalTile[100];
float3 QuantizeHistory(float3 color) { return f16tof32(f32tof16(color)); }
void TemporalAntiAlias(uint3 groupId, uint3 threadId, uint groupIndex)
{
    int2 origin = int2(groupId.xy * 8);
    int2 pixel = origin + int2(threadId.xy);
    float ownDepth; float4 diagnostics, reprojection;
    float4 own = ResolveTemporalPixel(TaaClampPixel(pixel), ownDepth, diagnostics, reprojection);
    uint centerIndex = (threadId.y + 1) * 10 + threadId.x + 1;
    TemporalTile[centerIndex] = QuantizeHistory(own.rgb);
    if (groupIndex < 36)
    {
        int2 halo;
        if (groupIndex < 10) halo = int2(groupIndex, 0);
        else if (groupIndex < 20) halo = int2(groupIndex - 10, 9);
        else if (groupIndex < 28) halo = int2(0, groupIndex - 19);
        else halo = int2(9, groupIndex - 27);
        float depth; float4 debugValue, reprojectionValue;
        float4 value = ResolveTemporalPixel(TaaClampPixel(origin + halo - 1), depth, debugValue, reprojectionValue);
        TemporalTile[halo.y * 10 + halo.x] = QuantizeHistory(value.rgb);
    }
    GroupMemoryBarrierWithGroupSync();
    // All lanes reach the barrier, including lanes outside odd-sized images.
    if (any(pixel >= (int2)TAA_Resolution.xy)) return;
    float3 rgb = TemporalTile[centerIndex];
    const float3 weights = float3(0.2126, 0.7152, 0.0722);
    float luminance = dot(rgb, weights);
    float center = luminance / (1 + luminance);
    float average = 0, low = center, high = center;
    const int offsets[4] = {-1, 1, -10, 10};
    [unroll] for (int n = 0; n < 4; n++)
    {
        float value = dot(TemporalTile[(int)centerIndex + offsets[n]], weights);
        value /= 1 + value;
        average += value * 0.25;
        low = min(low, value); high = max(high, value);
    }
    float target = clamp(center + (center - average) * TAA_Sharpness, low, high);
    float targetLuminance = target / max(1 - target, 1.0 / 65504);
    float scale = min(targetLuminance / max(luminance, 1e-6), 65504 / max(max3(rgb.r, rgb.g, rgb.b), 1e-6));
    UAV_AccumulateColorTexture[pixel] = own;
    UAV_TemporalDepthTexture[pixel] = ownDepth;
    UAV_SharpenedColorTexture[pixel] = float4(rgb * scale, 1);
#if defined(TAA_WRITE_DIAGNOSTICS)
    UAV_TAADiagnostics[pixel] = diagnostics;
    UAV_TAAReprojection[pixel] = reprojection;
#endif
}
[numthreads(8, 8, 1)]
void Main(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID, uint index : SV_GroupIndex)
{ TemporalAntiAlias(groupId, threadId, index); }
[numthreads(8, 8, 1)]
void MainDebug(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID, uint index : SV_GroupIndex)
{ TemporalAntiAlias(groupId, threadId, index); }
