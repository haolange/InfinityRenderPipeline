#pragma kernel Main
#pragma kernel MainDebug TAA_WRITE_CONFIDENCE

float4 TAA_Resolution;
float4 TAA_BlendParameter; // x: static, y: dynamic, z: motion amplification, w: temporalScale
float TAA_Sharpness;
float TAA_ResetBlend;
Texture2D SRV_DepthTexture;
Texture2D SRV_MotionTexture;
Texture2D SRV_HistoryDepthTexture;
Texture2D SRV_HistoryColorTexture;
Texture2D SRV_AliasingColorTexture;
Texture2D SRV_ReactiveMaskTexture;
RWTexture2D<float4> UAV_AccmulateColorTexture;
#if defined(TAA_WRITE_CONFIDENCE)
RWTexture2D<float> UAV_TAAConfidenceTexture;
#endif

static const half TONEMAP_EPSILON = 1.0f / 65530.0f;
static const int2 SampleOffsets[9] = { int2(-1, -1), int2(0, -1), int2(1, -1), int2(-1, 0), int2(0, 0), int2(1, 0), int2(-1, 1), int2(0, 1), int2(1, 1) };
static const int2 NeighborOffsets[8] = { int2(-1, -1), int2(0, -1), int2(1, -1), int2(-1, 0), int2(1, 1), int2(1, 0), int2(-1, 1), int2(0, 1) };

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/ShaderVariables.hlsl"

float3 ClipAABB(float3 color, float3 aabbMin, float3 aabbMax)
{
    float3 center = 0.5 * (aabbMax + aabbMin);
    float3 extents = 0.5 * (aabbMax - aabbMin) + 1e-5;
    float3 offset = color - center;
    float3 ts = abs(offset / extents);
    float t = max3(ts.x, ts.y, ts.z);
    return t > 1.0 ? center + offset / t : color;
}

#if 1 //defined(UNITY_REVERSED_Z)
    #define COMPARE_DEPTH(a, b) step(b, a)
#else
    #define COMPARE_DEPTH(a, b) step(a, b)
#endif

float3 Tonemap(float3 fRgb)
{
    return fRgb / (max(max(0.f, fRgb.r), max(fRgb.g, fRgb.b)) + 1.f).xxx;
}

float3 InverseTonemap(float3 fRgb)
{
    return fRgb / max(TONEMAP_EPSILON, 1.f - max(fRgb.r, max(fRgb.g, fRgb.b))).xxx;
}

float2 GetClosestFragment(float2 uv, float currDepth)
{
    float neighborhood[8];
    [unroll]
    for(uint i = 0; i < 8; ++i) 
    {
        neighborhood[i] = SRV_DepthTexture.SampleLevel(Global_point_clamp_sampler, uv, 0, NeighborOffsets[i]).r;
    }

    float3 result = float3(0, 0, currDepth);

    [unroll]
    for(uint j = 0; j < 8; ++j) 
    {
        result = lerp(result, float3(NeighborOffsets[j], neighborhood[j]), COMPARE_DEPTH(neighborhood[j], result.z));
    }

    return (uv + result.xy * TAA_Resolution.zw);
}

float HistoryDepthConfidence(float2 reprojUV, float currLinear)
{
    if (any(reprojUV < 0.0) || any(reprojUV > 1.0))
    {
        return 0.0;
    }

    float histMin = 1e20;
    float histMax = 0.0;
    [unroll]
    for (uint n = 0; n < 9; ++n)
    {
        float histDepth = SRV_HistoryDepthTexture.SampleLevel(Global_point_clamp_sampler, reprojUV, 0, SampleOffsets[n]).r;
        float histLinear = LinearEyeDepth(histDepth, _ZBufferParams);
        histMin = min(histMin, histLinear);
        histMax = max(histMax, histLinear);
    }

    float expand = max(abs(histMax - histMin), 1e-4) * 0.5 + max(currLinear, 1e-4) * 0.01;
    return (currLinear < histMin - expand || currLinear > histMax + expand) ? 0.0 : 1.0;
}

void TemporalAntiAlias(uint3 id)
{
    float2 screenUV = (id.xy + 0.5) * TAA_Resolution.zw;

    float currDepth = SRV_DepthTexture.SampleLevel(Global_point_clamp_sampler, screenUV, 0).r;
    float2 velocity = SRV_MotionTexture.SampleLevel(Global_bilinear_clamp_sampler, GetClosestFragment(screenUV, currDepth), 0).xy;
    float2 reprojUV = screenUV - velocity;
    float3 lastColor = Texture2DSampleBicubic(SRV_HistoryColorTexture, Global_bilinear_clamp_sampler, reprojUV, TAA_Resolution.xy, TAA_Resolution.zw).rgb;
    lastColor = RGB2YCoCg(Tonemap(lastColor));

    float currLinear = LinearEyeDepth(currDepth, _ZBufferParams);
    float confidence = HistoryDepthConfidence(reprojUV, currLinear);

    float3 sampleColors[9];

    [unroll]
    for(uint i = 0; i < 9; ++i) 
    {
        sampleColors[i] = SRV_AliasingColorTexture.SampleLevel(Global_point_clamp_sampler, screenUV, 0, SampleOffsets[i]).rgb;
        sampleColors[i] = RGB2YCoCg(Tonemap(sampleColors[i]));
    }

    float3 currColor = sampleColors[4];

    float3 m1 = 0; 
    float3 m2 = 0;

    [unroll]
    for(uint x = 0; x < 9; ++x) 
    {
        m1 += sampleColors[x];
        m2 += sampleColors[x] * sampleColors[x];
    }

    float3 mean = m1 / 9;
    float3 stddev = sqrt((m2 / 9) - pow2(mean));

    float3 minColor = mean - TAA_BlendParameter.w * stddev;
    float3 maxColor = mean + TAA_BlendParameter.w * stddev;

    minColor = min(minColor, currColor);
    maxColor = max(maxColor, currColor);

    lastColor = ClipAABB(lastColor, minColor, maxColor);

    float weight = clamp(lerp(TAA_BlendParameter.x, TAA_BlendParameter.y, length(velocity) * TAA_BlendParameter.z), TAA_BlendParameter.y, TAA_BlendParameter.x);
    weight *= TAA_ResetBlend;
    weight *= confidence;
    float reactive = SRV_ReactiveMaskTexture.SampleLevel(Global_point_clamp_sampler, screenUV, 0).r;
    weight *= 1.0 - saturate(reactive);

    float3 blended = lerp(currColor, lastColor, weight);

    float crossLuma = (sampleColors[1].x + sampleColors[3].x + sampleColors[5].x + sampleColors[7].x) * 0.25;
    blended.x += (blended.x - crossLuma) * TAA_Sharpness;
    blended.x = clamp(blended.x, minColor.x, maxColor.x);

    UAV_AccmulateColorTexture[id.xy] = float4(clamp(InverseTonemap(YCoCg2RGB(blended)), 0.0, 65472), 1.0);
#if defined(TAA_WRITE_CONFIDENCE)
    UAV_TAAConfidenceTexture[id.xy] = confidence;
#endif
}

[numthreads(16, 16, 1)]
void Main(uint3 id : SV_DispatchThreadID)
{
    TemporalAntiAlias(id);
}

[numthreads(16, 16, 1)]
void MainDebug(uint3 id : SV_DispatchThreadID)
{
    TemporalAntiAlias(id);
}

