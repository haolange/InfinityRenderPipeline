#include "Packages/com.infinity.render-pipeline/Shaders/ShaderLibrary/TextureView.hlsl"
// Stochastic screen-space reflections after Frostbite (Stachowiak 2015, "Stochastic Screen-Space Reflections").
//
//   SSRClassify      one group per 8x8 trace tile: skip, Hi-Z (smooth) or linear (rough) by the tile's minimum roughness
//   SSRClearSkipped  indirect over skip tiles: clears their ray records
//   SSRTraceHiZ      indirect over Hi-Z tiles: one VNDF ray per trace pixel, Hi-Z walk
//   SSRTraceLinear   indirect over linear tiles: one VNDF ray per trace pixel, linear march
//   SSRResolve       full resolution: ratio estimator over neighbor rays (ray reuse), filtered importance sampling mip
//   SSRTemporal      full resolution: virtual-point + surface reprojection, variance clip, per-pixel history age
//   SSRSpatial       full resolution: optional 5x5 a-trous pass with roughness-scaled spacing
//   SSRDebug         full resolution: tile class, ray result, confidence and history age views
//
// Trace resolution is full or half; tiles, quad rotation, ray records and ray reuse are shared with SSGI
// (RayTracing/ScreenSpaceRayTrace/ScreenSpaceTraceTiles.hlsl).
// Resolved / Temporal / SSRTexture (RGBA16F): rgb = radiance premultiplied by confidence, a = confidence.
// Meta (RGBA16F): octahedral world normal, raw depth, history age in frames (0 = no history).

#pragma kernel SSRClassify
#pragma kernel SSRClearSkipped
#pragma kernel SSRTraceHiZ
#pragma kernel SSRTraceLinear
#pragma kernel SSRResolve
#pragma kernel SSRTemporal
#pragma kernel SSRSpatial
#pragma kernel SSRDebug

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDepth.hlsl"
#include "../../ShaderLibrary/ScreenSpaceReprojection.hlsl"
#include "../../ShaderLibrary/GBufferPack.hlsl"
#include "../../ShaderLibrary/BSDF.hlsl"
#include "../../ShaderLibrary/RayTracing/ScreenSpaceRayTrace/SSRTRayCast.hlsl"
#include "../../ShaderLibrary/RayTracing/ScreenSpaceRayTrace/ScreenSpaceTraceTiles.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDenoise/TemporalAccumulation.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDenoise/AtrousFilter.hlsl"
#include "../../ShaderLibrary/DebugViewModes.hlsl"

#define SSR_TILE_SIZE SCREEN_SPACE_TRACE_TILE_SIZE
#define SSR_CLASS_HIZ 0
#define SSR_CLASS_LINEAR 1
#define SSR_CLASS_SKIP 2

float4 SSR_Resolution;
float4 SSR_TraceResolution;
uint SSR_TraceScale;
uint SSR_FrameIndex;
uint SSR_MaxTiles;
uint SSR_TileListOffset;
float SSR_MaxDistance;
float SSR_Thickness;
float SSR_MaxRoughness;
float SSR_EdgeFade;
float SSR_MirrorRoughness;
float SSR_LinearRoughness;
float SSR_BRDFBias;
uint SSR_HiZSteps;
uint SSR_LinearSteps;
uint SSR_ResolveSamples;
float SSR_ResolveRadius;
float SSR_TemporalWeight;
float SSR_TemporalClampScale;
float SSR_HistoryValid;
int SSR_DebugMode;
// xyz = world position, w = 1 for orthographic cameras.
float4 SSR_CameraPosition;
float4 SSR_CameraForward;
float4x4 Matrix_Proj, Matrix_InvProj, Matrix_InvViewProj, Matrix_WorldToView;
float4x4 Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj;

Texture2D<float> SRV_DepthTexture;
Texture2D SRV_HiZTexture;
Texture2D SRV_GBufferA;
Texture2D SRV_GBufferB;
Texture2D SRV_GBufferC;
Texture2D SRV_LightingPyramid;
Texture2D SRV_MotionTexture;
Texture2D SRV_HistoryRadiance;
Texture2D SRV_HistoryMeta;
Texture2D<float4> SRV_RayHit;
Texture2D<float4> SRV_Resolved;
Texture2D<float> SRV_HitDistance;
Texture2D<float4> SRV_Temporal;
Texture2D<float4> SRV_Meta;
Texture2D<uint> SRV_TileClass;
StructuredBuffer<uint> SRV_TileList;

RWStructuredBuffer<uint> UAV_TileArgs;
RWStructuredBuffer<uint> UAV_TileList;
RWTexture2D<uint> UAV_TileClass;
RWTexture2D<float4> UAV_RayHit;
RWTexture2D<float4> UAV_Resolved;
RWTexture2D<float> UAV_HitDistance;
RWTexture2D<float4> UAV_Temporal;
RWTexture2D<float4> UAV_Meta;
RWTexture2D<float4> UAV_Output;
RWTexture2D<float4> UAV_Debug;

struct FSSRSurface
{
    float rawDepth;
    float roughness;
    float3 normalWS;
    float3 positionVS;
    float3 positionWS;
    // Unit vector from the camera toward the surface.
    float3 viewRayWS;
};

// Deferred, valid, glossy enough. Forward-route pixels keep their own specular and are never reflected onto.
bool IsReflectiveSurface(uint2 pixel, out float rawDepth, out float roughness)
{
    rawDepth = SRV_DepthTexture[pixel];
    roughness = 1;
    if (ScreenSpaceIsFarDepth(rawDepth))
    {
        return false;
    }
    uint shadingModel, flags;
    UnpackGBufferCChannelR(SRV_GBufferC[pixel].r, shadingModel, flags);
    if ((flags & GBUFFER_FLAG_VALID_SURFACE) == 0 || (flags & GBUFFER_FLAG_FORWARD) != 0)
    {
        return false;
    }
    roughness = SRV_GBufferA[pixel].b;
    return roughness <= SSR_MaxRoughness;
}

bool LoadSurface(uint2 pixel, out FSSRSurface surface)
{
    surface = (FSSRSurface)0;
    if (!IsReflectiveSurface(pixel, surface.rawDepth, surface.roughness))
    {
        return false;
    }
    surface.normalWS = normalize(SRV_GBufferB[pixel].xyz * 2 - 1);
    float2 uv = (pixel + 0.5) * SSR_Resolution.zw;
    float3 ndc = GetNDCPos(uv, surface.rawDepth);
    surface.positionVS = GetViewSpacePos(ndc, Matrix_InvProj);
    surface.positionWS = GetWorldSpacePos(ndc, Matrix_InvViewProj);
    surface.viewRayWS = SSR_CameraPosition.w != 0 ? SSR_CameraForward.xyz : normalize(surface.positionWS - SSR_CameraPosition.xyz);
    return true;
}

uint2 TraceToFullPixel(uint2 tracePixel)
{
    return TraceToFullPixel(tracePixel, SSR_TraceScale, SSR_FrameIndex, (uint2)SSR_Resolution.xy);
}

uint2 FullToTracePixel(uint2 pixel)
{
    return FullToTracePixel(pixel, SSR_TraceScale, (uint2)SSR_TraceResolution.xy);
}

// ---------------------------------------------------------------------------------------------------------------------
// Classification

groupshared uint gs_ReflectiveCount;
groupshared uint gs_MinRoughness;

[numthreads(SSR_TILE_SIZE, SSR_TILE_SIZE, 1)]
void SSRClassify(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
    if (groupIndex == 0)
    {
        gs_ReflectiveCount = 0;
        gs_MinRoughness = asuint(1.0f);
    }
    GroupMemoryBarrierWithGroupSync();

    uint2 tracePixel = groupId.xy * SSR_TILE_SIZE + groupThreadId.xy;
    if (all(tracePixel < (uint2)SSR_TraceResolution.xy))
    {
        float rawDepth, roughness;
        if (IsReflectiveSurface(TraceToFullPixel(tracePixel), rawDepth, roughness))
        {
            InterlockedAdd(gs_ReflectiveCount, 1u);
            // Non-negative floats order like their bit patterns.
            InterlockedMin(gs_MinRoughness, asuint(saturate(roughness)));
        }
    }
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex == 0)
    {
        uint tileClass = SSR_CLASS_SKIP;
        if (gs_ReflectiveCount > 0)
        {
            tileClass = asfloat(gs_MinRoughness) < SSR_LinearRoughness ? SSR_CLASS_HIZ : SSR_CLASS_LINEAR;
        }
        uint slot;
        InterlockedAdd(UAV_TileArgs[tileClass * 3], 1u, slot);
        UAV_TileList[tileClass * SSR_MaxTiles + slot] = PackTraceTile(groupId.xy);
        UAV_TileClass[groupId.xy] = tileClass;
    }
}

uint2 TileTracePixel(uint3 groupId, uint3 groupThreadId)
{
    return UnpackTraceTile(SRV_TileList[SSR_TileListOffset + groupId.x]) * SSR_TILE_SIZE + groupThreadId.xy;
}

[numthreads(SSR_TILE_SIZE, SSR_TILE_SIZE, 1)]
void SSRClearSkipped(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint2 tracePixel = TileTracePixel(groupId, groupThreadId);
    if (all(tracePixel < (uint2)SSR_TraceResolution.xy))
    {
        UAV_RayHit[tracePixel] = 0;
    }
}

// ---------------------------------------------------------------------------------------------------------------------
// Trace

void TraceTilePixel(uint3 groupId, uint3 groupThreadId, bool linearMarch)
{
    uint2 tracePixel = TileTracePixel(groupId, groupThreadId);
    if (any(tracePixel >= (uint2)SSR_TraceResolution.xy))
    {
        return;
    }

    FSSRSurface surface;
    if (!LoadSurface(TraceToFullPixel(tracePixel), surface))
    {
        UAV_RayHit[tracePixel] = 0;
        return;
    }

    float3 V = -surface.viewRayWS;
    float3 N = surface.normalWS;
    float3 L;
    float pdf;
    if (surface.roughness < SSR_MirrorRoughness)
    {
        // Mirror pixels resolve their own ray only; the pdf is unused.
        L = reflect(-V, N);
        pdf = 1;
    }
    else
    {
        float3x3 tangentBasis = GetTangentBasis(N);
        float3 tangentV = mul(tangentBasis, V);
        float2 E = float2(GetBNDSequenceSample(tracePixel, SSR_FrameIndex, 0), GetBNDSequenceSample(tracePixel, SSR_FrameIndex, 1));
        // BRDF bias truncates the lobe tail: E.x is the radial coordinate of the visible-normal disk.
        E.x *= 1 - SSR_BRDFBias;
        float4 sampleH = ImportanceSampleVisibleGGX(E, max(surface.roughness, 0.02), tangentV);
        float3 H = mul(sampleH.xyz, tangentBasis);
        L = reflect(-V, H);
        float VoH = saturate(dot(V, H));
        pdf = sampleH.w / max(4 * VoH, 1e-5);
    }

    if (dot(N, L) <= 0)
    {
        UAV_RayHit[tracePixel] = 0;
        return;
    }

    float3 directionVS = normalize(mul((float3x3)Matrix_WorldToView, L));
    float jitter = GetBNDSequenceSample(tracePixel, SSR_FrameIndex, 2);
    float3 hit;
    bool found = linearMarch
        ? TraceScreenSpaceRayLinear(surface.positionVS, directionVS, SSR_MaxDistance, SSR_Thickness, SSR_LinearSteps, jitter, Matrix_Proj, SRV_HiZTexture, SRV_HiZTexture_InfinityView, SSR_TraceScale - 1, hit)
        : TraceScreenSpaceRay(surface.positionVS, directionVS, SSR_MaxDistance, SSR_Thickness, SSR_HiZSteps, jitter, Matrix_Proj, SRV_HiZTexture, SRV_HiZTexture_InfinityView, hit);

    UAV_RayHit[tracePixel] = found ? EncodeRayHit(hit, pdf) : EncodeRayMiss(L, pdf);
}

[numthreads(SSR_TILE_SIZE, SSR_TILE_SIZE, 1)]
void SSRTraceHiZ(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    TraceTilePixel(groupId, groupThreadId, false);
}

[numthreads(SSR_TILE_SIZE, SSR_TILE_SIZE, 1)]
void SSRTraceLinear(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    TraceTilePixel(groupId, groupThreadId, true);
}

// ---------------------------------------------------------------------------------------------------------------------
// Resolve (ray reuse)

[numthreads(8, 8, 1)]
void SSRResolve(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSR_Resolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    FSSRSurface surface;
    if (!LoadSurface(pixel, surface))
    {
        UAV_Resolved[pixel] = 0;
        UAV_HitDistance[pixel] = 0;
        return;
    }

    float3 V = -surface.viewRayWS;
    float3 N = surface.normalWS;
    float NoV = saturate(dot(N, V)) + 1e-5;
    float roughness = max(surface.roughness, 0.02);
    float roughness4 = pow4(roughness);
    bool mirror = surface.roughness < SSR_MirrorRoughness;

    uint lightingWidth, lightingHeight, lightingMips;
    InfinityGetMipDimensions(SRV_LightingPyramid, 0, lightingWidth, lightingHeight, lightingMips);
    // Pixels covered by one world unit at eye depth 1.
    float projectionScale = 0.5 * SSR_Resolution.y * abs(Matrix_Proj[1][1]);

    uint2 traceCenter = FullToTracePixel(pixel);
    uint sampleCount = mirror ? 1u : clamp(SSR_ResolveSamples, 1u, 16u);
    float rotation = InterleavedGradientNoise(float2(pixel) + 0.5, (float)(SSR_FrameIndex & 7u)) * 6.2831853;

    float weightSum = 0;
    float3 radianceSum = 0;
    float confidenceSum = 0;
    float distanceSum = 0;
    float distanceWeight = 0;
    [loop]
    for (uint i = 0; i < sampleCount; ++i)
    {
        int2 samplePixel = clamp(int2(traceCenter) + RayReuseOffset(i, sampleCount, SSR_ResolveRadius, rotation), 0, int2(SSR_TraceResolution.xy) - 1);
        float4 ray = SRV_RayHit[samplePixel];
        if (ray.w == 0)
        {
            continue;
        }

        float pdf = abs(ray.w);
        float3 L;
        float3 radiance = 0;
        float hitConfidence = 0;
        float hitDistance = 0;
        if (ray.w > 0)
        {
            float3 hitWS = GetWorldSpacePos(GetNDCPos(ray.xy, ray.z), Matrix_InvViewProj);
            float3 toHit = hitWS - surface.positionWS;
            hitDistance = length(toHit);
            if (hitDistance <= 1e-4)
            {
                continue;
            }
            L = toHit / hitDistance;

            // The back of an object is never visible in a reflection; a ray that lands on one is treated as a miss.
            uint2 hitPixel = min((uint2)(ray.xy * SSR_Resolution.xy), (uint2)SSR_Resolution.xy - 1);
            float3 hitNormal = normalize(SRV_GBufferB[hitPixel].xyz * 2 - 1);
            float facing = saturate(-dot(hitNormal, L) * 4);
            float distanceFade = saturate((SSR_MaxDistance - hitDistance) / max(0.1 * SSR_MaxDistance, 1e-3));
            hitConfidence = GetScreenFadeBord(ray.xy, SSR_EdgeFade) * facing * distanceFade;

            // Filtered importance sampling: mirrors read the full-resolution image.
            float mip = mirror ? 0 : RayConeMip(pdf, sampleCount, hitDistance, projectionScale, ScreenSpaceLinearEyeDepth(ray.z), lightingMips);
            radiance = InfinitySampleLevelTrilinear(SRV_LightingPyramid,Global_trilinear_clamp_sampler,ray.xy,mip).rgb;
        }
        else
        {
            L = OctahedronToUnitVector(ray.xy);
        }

        float NoL = dot(N, L);
        if (NoL <= 0)
        {
            continue;
        }

        // Ratio estimator: sum(f * Li / pdf) / sum(f / pdf). Fresnel is applied by the composite with the split-sum
        // term, so f is D * Vis * NoL here. A miss adds weight but no confidence: that part falls back to probes.
        float weight = 1;
        if (!mirror)
        {
            float NoH = saturate(dot(N, normalize(V + L)));
            weight = D_GGX(NoH, roughness4) * Vis_Smith(NoL, NoV, roughness) * NoL / pdf;
        }
        weightSum += weight;
        radianceSum += weight * hitConfidence * radiance;
        confidenceSum += weight * hitConfidence;
        if (ray.w > 0)
        {
            distanceSum += weight * hitDistance;
            distanceWeight += weight;
        }
    }

    float inverseWeight = weightSum > 0 ? rcp(weightSum) : 0;
    UAV_Resolved[pixel] = float4(radianceSum * inverseWeight, saturate(confidenceSum * inverseWeight));
    UAV_HitDistance[pixel] = distanceWeight > 0 ? distanceSum / distanceWeight : 0;
}

// ---------------------------------------------------------------------------------------------------------------------
// Temporal

[numthreads(8, 8, 1)]
void SSRTemporal(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSR_Resolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    FSSRSurface surface;
    if (!LoadSurface(pixel, surface))
    {
        UAV_Temporal[pixel] = 0;
        UAV_Meta[pixel] = float4(0, 0, surface.rawDepth, 0);
        return;
    }

    float4 current = SRV_Resolved[pixel];
    float4 sum = 0;
    float4 sumSquares = 0;
    int2 maxPixel = int2(SSR_Resolution.xy) - 1;
    [unroll]
    for (int y = -1; y <= 1; ++y)
    {
        [unroll]
        for (int x = -1; x <= 1; ++x)
        {
            float4 value = SRV_Resolved[clamp(int2(pixel) + int2(x, y), 0, maxPixel)];
            sum += value;
            sumSquares += value * value;
        }
    }
    FNeighborhoodMoments moments = ResolveNeighborhoodMoments(sum, sumSquares, 9, current, SSR_TemporalClampScale);

    float2 uv = (pixel + 0.5) * SSR_Resolution.zw;
    float2 surfaceMotion = SRV_MotionTexture[pixel].xy;
    float2 surfaceUV;
    float expectedDepth;
    ReprojectSurface(uv, surface.rawDepth, surfaceMotion, Matrix_InvViewProj, Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj, surfaceUV, expectedDepth);

    float historyAge = 0;
    float4 history = current;
    float historyValid = SSR_HistoryValid * HistoryDepthConfidence(SRV_HistoryMeta, SRV_HistoryMeta_InfinityView, surfaceUV, expectedDepth, 2);
    if (historyValid > 0)
    {
        float4 historyMeta = InfinitySampleLevel(SRV_HistoryMeta,Global_point_clamp_sampler,surfaceUV,0);
        float normalAgreement = dot(surface.normalWS, OctahedronToUnitVector(historyMeta.xy));
        historyValid = normalAgreement > 0.9 && historyMeta.w >= 1 ? 1 : 0;
        historyAge = historyValid > 0 ? historyMeta.w : 0;
    }

    if (historyValid > 0)
    {
        float4 surfaceHistory = InfinitySampleLevel(SRV_HistoryRadiance,Global_bilinear_clamp_sampler,surfaceUV,0);
        history = surfaceHistory;
        float hitDistance = SRV_HitDistance[pixel];
        float2 virtualUV = hitDistance > 0 ? ReprojectVirtualPoint(surface.positionWS, surface.viewRayWS, hitDistance, Matrix_HistoryViewProj) : -1;
        if (all(virtualUV >= 0) && all(virtualUV <= 1))
        {
            // Smooth lobes follow the reflected image; rough lobes follow the surface. The neighborhood arbitrates.
            float4 virtualHistory = InfinitySampleLevel(SRV_HistoryRadiance,Global_bilinear_clamp_sampler,virtualUV,0);
            float prior = 1 - smoothstep(0.1, 0.4, surface.roughness);
            float virtualWeight = prior * exp2(-NeighborhoodDistance(virtualHistory, moments));
            float surfaceWeight = (1 - prior) * exp2(-NeighborhoodDistance(surfaceHistory, moments)) + 1e-4;
            history = (virtualHistory * virtualWeight + surfaceHistory * surfaceWeight) / (virtualWeight + surfaceWeight);
        }
        history = ClipHistoryToNeighborhood(history, moments);
    }

    float currentWeight = TemporalCurrentWeight(historyAge, SSR_TemporalWeight);
    UAV_Temporal[pixel] = max(0, lerp(history, current, currentWeight));
    UAV_Meta[pixel] = float4(UnitVectorToOctahedron(surface.normalWS), surface.rawDepth, NextHistoryAge(historyAge));
}

// ---------------------------------------------------------------------------------------------------------------------
// Spatial

[numthreads(8, 8, 1)]
void SSRSpatial(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSR_Resolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    float4 center = SRV_Temporal[pixel];
    float centerDepth, centerRoughness;
    if (!IsReflectiveSurface(pixel, centerDepth, centerRoughness) || centerRoughness < SSR_MirrorRoughness)
    {
        UAV_Output[pixel] = center;
        return;
    }

    float centerEye = ScreenSpaceLinearEyeDepth(centerDepth);
    float3 centerNormal = normalize(SRV_GBufferB[pixel].xyz * 2 - 1);
    // Wider spacing for rougher lobes: mirrors keep detail, rough reflections are smoothed.
    float spacing = lerp(1.0, 3.0, saturate(centerRoughness / max(SSR_MaxRoughness, 1e-3)));
    int2 maxPixel = int2(SSR_Resolution.xy) - 1;

    float4 sum = 0;
    float weightSum = 0;
    [unroll]
    for (int y = -2; y <= 2; ++y)
    {
        [unroll]
        for (int x = -2; x <= 2; ++x)
        {
            int2 tap = int2(x, y);
            uint2 samplePixel = (uint2)clamp(int2(pixel) + (int2)round(float2(tap) * spacing), 0, maxPixel);
            float sampleDepth, sampleRoughness;
            if (!IsReflectiveSurface(samplePixel, sampleDepth, sampleRoughness))
            {
                continue;
            }
            float3 sampleNormal = normalize(SRV_GBufferB[samplePixel].xyz * 2 - 1);
            float weight = AtrousKernelWeight(tap)
                * AtrousDepthWeight(centerEye, ScreenSpaceLinearEyeDepth(sampleDepth), 0.05)
                * AtrousNormalWeight(centerNormal, sampleNormal, 32)
                * AtrousRoughnessWeight(centerRoughness, sampleRoughness);
            sum += SRV_Temporal[samplePixel] * weight;
            weightSum += weight;
        }
    }
    UAV_Output[pixel] = weightSum > 0 ? sum / weightSum : center;
}

// ---------------------------------------------------------------------------------------------------------------------
// Debug

[numthreads(8, 8, 1)]
void SSRDebug(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSR_Resolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    uint2 tracePixel = FullToTracePixel(pixel);
    float3 color = 0;
    if (SSR_DebugMode == DEBUGVIEW_SSRTILECLASS)
    {
        uint tileClass = SRV_TileClass[tracePixel / SSR_TILE_SIZE];
        color = tileClass == SSR_CLASS_HIZ ? float3(0.1, 0.45, 1.0) : (tileClass == SSR_CLASS_LINEAR ? float3(1.0, 0.6, 0.1) : float3(0.12, 0.12, 0.12));
    }
    else if (SSR_DebugMode == DEBUGVIEW_SSRRAYHIT)
    {
        float4 ray = SRV_RayHit[tracePixel];
        color = ray.w > 0 ? float3(0, 1, 0) : (ray.w < 0 ? float3(1, 0, 0) : float3(0, 0, 0));
    }
    else if (SSR_DebugMode == DEBUGVIEW_SSRCONFIDENCE)
    {
        color = SRV_Resolved[pixel].aaa;
    }
    else if (SSR_DebugMode == DEBUGVIEW_SSRHISTORYAGE)
    {
        color = saturate(SRV_Meta[pixel].w / 16.0).xxx;
    }
    UAV_Debug[pixel] = float4(color, 1);
}
