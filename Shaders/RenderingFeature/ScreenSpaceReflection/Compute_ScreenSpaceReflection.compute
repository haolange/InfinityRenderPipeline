#include "Packages/com.infinity.render-pipeline/Shaders/ShaderLibrary/TextureView.hlsl"
// Stochastic screen-space reflections after Frostbite (Stachowiak 2015, "Stochastic Screen-Space Reflections").
//
//   SSRClearArgs     one thread: indirect counter to (0, 1, 1) before classify atomics
//   SSRClassify      one group per 8x8 trace tile: skip, Hi-Z (smooth) or linear (rough). Skip tiles clear their records.
//   SSRTrace         one indirect group per reflective tile: up to four sample records, shaded in this kernel
//   SSRResolve       full resolution: rebuilds receiver BRDF weights from those records; does not sample color
//   SSRTemporal      full resolution: motion-vector and hit-point reprojection, clamped to mean ± dev
//   SSRBilateral     full resolution: runs only where the smoothed reconstruction variance is high
//   SSRDebug         full resolution: tile class, ray result, confidence and history age views
//
// Trace resolution is full or half; tiles, quad rotation, ray records and ray reuse are shared with SSGI
// (RayTracing/ScreenSpaceRayTrace/ScreenSpaceTraceTiles.hlsl).
// Resolved / Temporal / SSRTexture (RGBA16F): rgb = hit radiance premultiplied by the hit edge fade, a = that fade.
// A miss does not enter the average. No hit leaves alpha at 0 so the environment term stays.
// Meta (RG32UInt): exact depth, oct12x2 world normal, age7 and valid1.

#pragma kernel SSRClearArgs
#pragma kernel SSRClassify
#pragma kernel SSRTrace
#pragma kernel SSRResolve
#pragma kernel SSRTemporal
#pragma kernel SSRBilateral
#pragma kernel SSRDebug

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDepth.hlsl"
#include "../../ShaderLibrary/ScreenSpaceReprojection.hlsl"
#include "../../ShaderLibrary/TemporalColorSource.hlsl"
#include "../../ShaderLibrary/GBufferPack.hlsl"
#include "../../ShaderLibrary/ScreenSpaceSurfaceMetadata.hlsl"
#include "../../ShaderLibrary/BSDF.hlsl"
#include "../../ShaderLibrary/RayTracing/ScreenSpaceRayTrace/SSRTRayCast.hlsl"
#include "../../ShaderLibrary/RayTracing/ScreenSpaceRayTrace/ScreenSpaceTraceTiles.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDenoise/TemporalAccumulation.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDenoise/AtrousFilter.hlsl"
#include "../../ShaderLibrary/DebugViewModes.hlsl"

#define SSR_TILE_SIZE SCREEN_SPACE_TRACE_TILE_SIZE
#define SSR_CLASS_HIZ 0
#define SSR_CLASS_LINEAR 1
#define SSR_CLASS_SKIP 2

float4 SSR_Resolution;
float4 SSR_TraceResolution;
uint SSR_TraceScale;
uint SSR_FrameIndex;
float SSR_MaxRoughness;
float SSR_EdgeFade;
float SSR_MirrorRoughness;
float SSR_LinearRoughness;
float SSR_BRDFBias;
uint SSR_HiZSteps;
uint SSR_LinearSteps;
uint SSR_BinarySteps;
uint SSR_TraceFlags;
uint SSR_ResolveSamples;
uint SSR_Samples;
float SSR_ResolveRadius;
float SSR_TemporalWeight;
float SSR_TemporalClampScale;
float SSR_HistoryValid;
int SSR_DebugMode;
// xyz = world position, w = 1 for orthographic cameras.
float4 SSR_CameraPosition;
float4 SSR_CameraForward;
float4x4 Matrix_Proj, Matrix_InvProj, Matrix_InvViewProj, Matrix_WorldToView;
float4x4 Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj;

Texture2D<float> SRV_DepthTexture;
Texture2D<float> SRV_HiZClosestTexture;
Texture2D<float> SRV_HiZFurthestTexture;
Texture2D SRV_GBufferA;
Texture2D SRV_GBufferB;
Texture2D SRV_GBufferC;
Texture2D<float4> SRV_HitMotionMetadata;
Texture2D SRV_MotionTexture;
Texture2D SRV_HistoryRadiance;
Texture2D<uint2> SRV_HistoryMeta;
Texture2D<float4> SRV_RayHit;
Texture2D<float4> SRV_Resolved;
Texture2D<float> SRV_HitDistance;
Texture2D<float4> SRV_Temporal;
Texture2D<float4> SRV_HitMean;
Texture2D<float4> SRV_HitDev;
Texture2D<float> SRV_HistoryVariance;
Texture2D<float> SRV_Variance;
Texture2D<uint2> SRV_Meta;
Texture2D<uint> SRV_TileClass;
StructuredBuffer<uint> SRV_TileList;

RWStructuredBuffer<uint> UAV_TileArgs;
RWStructuredBuffer<uint> UAV_TileList;
RWTexture2D<uint> UAV_TileClass;
RWTexture2D<float4> UAV_RayHit;
struct FReflectionSample
{
    float4 radiance; // rgb = unweighted Li, a = hit confidence
    float4 dirT;     // xyz = Dir * HitT from this sample's origin, w = signed inverse pdf
};
RWStructuredBuffer<FReflectionSample> UAV_Samples;
StructuredBuffer<FReflectionSample> SRV_Samples;
RWTexture2D<float4> UAV_Resolved;
RWTexture2D<float4> UAV_HitMean;
RWTexture2D<float4> UAV_HitDev;
RWTexture2D<float> UAV_HitDistance;
RWTexture2D<float> UAV_Variance;
RWTexture2D<float4> UAV_Temporal;
RWTexture2D<uint2> UAV_Meta;
RWTexture2D<float4> UAV_Output;
RWTexture2D<float4> UAV_Debug;

struct FSSRSurface
{
    float rawDepth;
    float roughness;
    float3 normalWS;
    float3 positionVS;
    float3 positionWS;
    // Unit vector from the camera toward the surface.
    float3 viewRayWS;
};

// Deferred, valid, glossy enough. Forward-route pixels keep their own specular and are never reflected onto.
bool IsReflectiveSurface(uint2 pixel, out float rawDepth, out float roughness)
{
    rawDepth = SRV_DepthTexture[pixel];
    roughness = 1;
    bool valid = false;
    if (!ScreenSpaceIsFarDepth(rawDepth))
    {
        uint shadingModel, flags;
        UnpackGBufferCChannelR(SRV_GBufferC[pixel].r, shadingModel, flags);
        if ((flags & GBUFFER_FLAG_VALID_SURFACE) != 0 && (flags & GBUFFER_FLAG_FORWARD) == 0)
        {
            roughness = SRV_GBufferA[pixel].b;
            valid = roughness <= SSR_MaxRoughness;
        }
    }
    return valid;
}

bool LoadSurface(uint2 pixel, out FSSRSurface surface)
{
    surface = (FSSRSurface)0;
    float rawDepth = 0, roughness = 1;
    bool valid = IsReflectiveSurface(pixel, rawDepth, roughness);
    surface.rawDepth = rawDepth;
    surface.roughness = roughness;
    if (valid)
    {
        surface.normalWS = normalize(SRV_GBufferB[pixel].xyz * 2 - 1);
        float2 uv = (pixel + 0.5) * SSR_Resolution.zw;
        float3 ndc = GetNDCPos(uv, rawDepth);
        surface.positionVS = GetViewSpacePos(ndc, Matrix_InvProj);
        surface.positionWS = GetWorldSpacePos(ndc, Matrix_InvViewProj);
        surface.viewRayWS = SSR_CameraPosition.w != 0 ? SSR_CameraForward.xyz : normalize(surface.positionWS - SSR_CameraPosition.xyz);
    }
    return valid;
}

uint2 TraceToFullPixel(uint2 tracePixel)
{
    return TraceToFullPixel(tracePixel, SSR_TraceScale, SSR_FrameIndex, (uint2)SSR_Resolution.xy);
}

uint2 FullToTracePixel(uint2 pixel)
{
    return FullToTracePixel(pixel, SSR_TraceScale, (uint2)SSR_TraceResolution.xy);
}

// ---------------------------------------------------------------------------------------------------------------------
// Classification

uint ReflectionSampleIndex(uint2 pixel, uint sampleIndex)
{
    return (pixel.y * (uint)SSR_TraceResolution.x + pixel.x) * 4u + sampleIndex;
}

void WriteReflectionSample(uint2 pixel, uint sampleIndex, float4 radiance, float4 dirT)
{
    FReflectionSample record;
    record.radiance = radiance;
    record.dirT = dirT;
    UAV_Samples[ReflectionSampleIndex(pixel, sampleIndex)] = record;
}

void ClearReflectionPixel(uint2 pixel)
{
    UAV_RayHit[pixel] = 0;
    [unroll] for (uint sampleIndex = 0; sampleIndex < 4; ++sampleIndex)
        WriteReflectionSample(pixel, sampleIndex, 0, 0);
}

[numthreads(1, 1, 1)]
void SSRClearArgs(uint3 id : SV_DispatchThreadID)
{
    UAV_TileArgs[0] = 0;
    UAV_TileArgs[1] = 1;
    UAV_TileArgs[2] = 1;
}

groupshared uint gs_ReflectiveCount;
groupshared uint gs_MinRoughness;
groupshared uint gs_TileClass;

[numthreads(SSR_TILE_SIZE, SSR_TILE_SIZE, 1)]
void SSRClassify(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
    if (groupIndex == 0)
    {
        gs_ReflectiveCount = 0;
        gs_MinRoughness = asuint(1.0f);
    }
    GroupMemoryBarrierWithGroupSync();

    uint2 tracePixel = groupId.xy * SSR_TILE_SIZE + groupThreadId.xy;
    bool inside = all(tracePixel < (uint2)SSR_TraceResolution.xy);
    if (inside)
    {
        float rawDepth, roughness;
        if (IsReflectiveSurface(TraceToFullPixel(tracePixel), rawDepth, roughness))
        {
            InterlockedAdd(gs_ReflectiveCount, 1u);
            // Non-negative floats order like their bit patterns.
            InterlockedMin(gs_MinRoughness, asuint(saturate(roughness)));
        }
    }
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex == 0)
    {
        uint tileClass = SSR_CLASS_SKIP;
        if (gs_ReflectiveCount > 0)
        {
            tileClass = asfloat(gs_MinRoughness) < SSR_LinearRoughness ? SSR_CLASS_HIZ : SSR_CLASS_LINEAR;
            uint slot;
            InterlockedAdd(UAV_TileArgs[0], 1u, slot);
            UAV_TileList[slot] = PackTraceTile(groupId.xy);
        }
        gs_TileClass = tileClass;
        UAV_TileClass[groupId.xy] = tileClass;
    }
    GroupMemoryBarrierWithGroupSync();
    if (inside && gs_TileClass == SSR_CLASS_SKIP)
    {
        ClearReflectionPixel(tracePixel);
    }
}

// ---------------------------------------------------------------------------------------------------------------------
// Trace

uint2 TileTracePixel(uint3 groupId, uint3 groupThreadId, out uint2 tile)
{
    tile = UnpackTraceTile(SRV_TileList[groupId.x]);
    return tile * SSR_TILE_SIZE + groupThreadId.xy;
}

// 0 keeps the hit. 1 is a back-facing surface, 2 is a zero edge fade, 3 is invalid temporal color.
// Any of those is an empty sample: a miss still occupies estimator weight.
int ShadeReflectionHit(FSSRSurface surface, float3 L, float pdf, FScreenSpaceHit hit, bool mirror, out float4 radiance, out float hitDistance)
{
    float3 hitWS = GetWorldSpacePos(GetNDCPos(hit.uv, hit.rawDepth), Matrix_InvViewProj);
    hitDistance = max(length(hitWS - surface.positionWS), 1e-3);
    uint2 hitPixel = min((uint2)(hit.uv * SSR_Resolution.xy), (uint2)SSR_Resolution.xy - 1);
    float3 hitNormal = normalize(SRV_GBufferB[hitPixel].xyz * 2 - 1);
    float facing = saturate(-dot(hitNormal, L) * 4);
    float edge = GetScreenFadeBord(hit.uv, SSR_EdgeFade);
    radiance = 0;
    int reason = 0;
    if (facing <= 0) reason = 1;
    else if (edge <= 0) reason = 2;
    else
    {
        float projectionScale = 0.5 * TemporalColorResolution.y * abs(Matrix_Proj[1][1]);
        float mip = mirror ? 0 : RayConeMip(pdf, clamp(SSR_Samples, 1u, 4u), hitDistance, projectionScale, ScreenSpaceLinearEyeDepth(hit.rawDepth), (uint)TemporalColorMipCount);
        float colorConfidence;
        float3 color = SampleTemporalHitColor(hit.uv, hit.rawDepth, SRV_MotionTexture[hitPixel].xy, SRV_HitMotionMetadata[hitPixel], mip,
            Matrix_InvViewProj, Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj, colorConfidence);
        if (colorConfidence <= 0) reason = 3;
        else radiance = float4(color, edge);
    }
    return reason;
}

[numthreads(SSR_TILE_SIZE, SSR_TILE_SIZE, 1)]
void SSRTrace(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint2 tile;
    uint2 tracePixel = TileTracePixel(groupId, groupThreadId, tile);
    if (any(tracePixel >= (uint2)SSR_TraceResolution.xy)) return;
    bool linearMarch = SRV_TileClass[tile] == SSR_CLASS_LINEAR;
    FSSRSurface surface;
    if (!LoadSurface(TraceToFullPixel(tracePixel), surface))
    {
        ClearReflectionPixel(tracePixel);
        return;
    }

    float3 V = -surface.viewRayWS;
    float3 N = surface.normalWS;
    bool mirror = surface.roughness < SSR_MirrorRoughness;
    uint spp = mirror ? 1u : clamp(SSR_Samples, 1u, 4u);
    [loop]
    for (uint rayIndex = 0; rayIndex < 4; ++rayIndex)
    {
        if (rayIndex >= spp)
        {
            WriteReflectionSample(tracePixel, rayIndex, 0, 0);
            continue;
        }
        float3 L = 0;
        float pdf = 1;
        bool sampled = true;
        if (mirror)
        {
            L = reflect(-V, N);
        }
        else
        {
            float3x3 tangentBasis = GetTangentBasis(N);
            float3 tangentV = mul(tangentBasis, V);
            float2 E = float2(GetBNDSequenceSample(tracePixel, SSR_FrameIndex, (int)(rayIndex * 3)), GetBNDSequenceSample(tracePixel, SSR_FrameIndex, (int)(rayIndex * 3 + 1)));
            E.x *= 1 - SSR_BRDFBias;
            float4 sampleH = ImportanceSampleVisibleGGX(E, max(surface.roughness, 0.02), tangentV);
            float3 H = mul(sampleH.xyz, tangentBasis);
            L = reflect(-V, H);
            pdf = sampleH.w / max(4 * saturate(dot(V, H)), 1e-5);
            sampled = dot(N, L) > 0;
        }
        FScreenSpaceHit hit = (FScreenSpaceHit)0;
        bool found = false;
        if (sampled && dot(N, L) > 0)
        {
            float3 directionVS = normalize(mul((float3x3)Matrix_WorldToView, L));
            float jitter = GetBNDSequenceSample(tracePixel, SSR_FrameIndex, (int)(rayIndex * 3 + 2));
            found = linearMarch
                ? TraceScreenSpaceLinear(surface.positionVS, directionVS, SSR_LinearSteps, SSR_BinarySteps, jitter, SSR_TraceFlags, Matrix_Proj, SRV_DepthTexture, SRV_DepthTexture_InfinityView, SRV_HiZClosestTexture, SRV_HiZClosestTexture_InfinityView, SRV_HiZFurthestTexture, hit)
                : TraceScreenSpaceHiZ(surface.positionVS, directionVS, SSR_HiZSteps, jitter, SSR_TraceFlags, Matrix_Proj, SRV_DepthTexture, SRV_DepthTexture_InfinityView, SRV_HiZClosestTexture, SRV_HiZClosestTexture_InfinityView, SRV_HiZFurthestTexture, hit);
        }
        float invPdf = rcp(max(pdf, 1e-5));
        float4 radiance = 0;
        float4 dirT = 0;
        if (!sampled)
        {
            // The sampled direction points into the receiver. w stays 0 so resolve ignores it.
            dirT = float4(4, 4, 4, 0);
        }
        else if (!found)
        {
            // A miss keeps the unit direction. Negative inverse pdf still enters the estimator.
            dirT = float4(L, -invPdf);
        }
        else
        {
            float hitDistance;
            int reason = ShadeReflectionHit(surface, L, pdf, hit, mirror, radiance, hitDistance);
            if (reason == 0)
            {
                float3 hitWS = GetWorldSpacePos(GetNDCPos(hit.uv, hit.rawDepth), Matrix_InvViewProj);
                dirT = float4(hitWS - surface.positionWS, invPdf);
            }
            else
            {
                dirT = float4(reason, reason, reason, 0);
                radiance = 0;
            }
        }
        WriteReflectionSample(tracePixel, rayIndex, radiance, dirT);
        if (rayIndex == 0)
        {
            // The sample record keeps the unit miss direction. The debug ray stores the octahedron and why the march stopped.
            UAV_RayHit[tracePixel] = sampled && !found
                ? float4(UnitVectorToOctahedron(L), hit.exitReason, -invPdf)
                : dirT;
        }
    }
}

float3 TracePixelOrigin(uint2 tracePixel)
{
    uint2 fullPixel = TraceToFullPixel(tracePixel);
    float rawDepth = SRV_DepthTexture[fullPixel];
    float2 uv = (fullPixel + 0.5) * SSR_Resolution.zw;
    return GetWorldSpacePos(GetNDCPos(uv, rawDepth), Matrix_InvViewProj);
}

void AccumulateReflectionRecord(FReflectionSample record, uint2 tracePixel, FSSRSurface surface, float3 N,
    inout float3 radianceSum, inout float confidenceSum, inout float weightSum, inout float distanceSum, inout float distanceWeight,
    inout float3 rawColorSum, inout float3 rawColorSquareSum, inout float rawColorCount,
    inout float confidenceStatSum, inout float confidenceStatSquareSum, inout float confidenceStatCount)
{
    float signedInvPdf = record.dirT.w;
    // A miss keeps alpha at 0 so the environment term stays. It does not dilute a hit.
    if (signedInvPdf <= 0) return;
    float3 hitWS = TracePixelOrigin(tracePixel) + record.dirT.xyz;
    float3 delta = hitWS - surface.positionWS;
    float hitDistance = length(delta);
    if (hitDistance <= 1e-4) return;
    float3 L = delta / hitDistance;
    if (dot(N, L) <= 0) return;
    float3 radiance = record.radiance.rgb;
    float edgeFade = saturate(record.radiance.a);
    radianceSum += radiance;
    confidenceSum += edgeFade;
    weightSum += 1;
    rawColorSum += radiance;
    rawColorSquareSum += radiance * radiance;
    rawColorCount += 1;
    confidenceStatSum += edgeFade;
    confidenceStatSquareSum += edgeFade * edgeFade;
    confidenceStatCount += 1;
    distanceSum += hitDistance;
    distanceWeight += 1;
}

// ---------------------------------------------------------------------------------------------------------------------
// Resolve (ray reuse)

[numthreads(8, 8, 1)]
void SSRResolve(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSR_Resolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    FSSRSurface surface;
    if (!LoadSurface(pixel, surface))
    {
        UAV_Resolved[pixel] = 0;
        UAV_HitDistance[pixel] = 0;
        UAV_HitMean[pixel] = 0;
        UAV_HitDev[pixel] = 0;
        return;
    }

    float3 N = surface.normalWS;
    bool mirror = surface.roughness < SSR_MirrorRoughness;

    uint2 traceCenter = FullToTracePixel(pixel);
    uint reuseCount = mirror ? 1u : clamp(SSR_ResolveSamples, 1u, 16u);
    uint spp = mirror ? 1u : clamp(SSR_Samples, 1u, 4u);
    float rotation = InterleavedGradientNoise(float2(pixel) + 0.5, (float)(SSR_FrameIndex & 7u)) * 6.2831853;

    float weightSum = 0;
    float3 radianceSum = 0;
    float confidenceSum = 0;
    float distanceSum = 0;
    float distanceWeight = 0;
    float3 rawColorSum = 0;
    float3 rawColorSquareSum = 0;
    float rawColorCount = 0;
    float confidenceStatSum = 0;
    float confidenceStatSquareSum = 0;
    float confidenceStatCount = 0;
    [loop]
    for (uint own = 0; own < spp; ++own)
        AccumulateReflectionRecord(SRV_Samples[ReflectionSampleIndex(traceCenter, own)], traceCenter, surface, N, radianceSum, confidenceSum, weightSum, distanceSum, distanceWeight, rawColorSum, rawColorSquareSum, rawColorCount, confidenceStatSum, confidenceStatSquareSum, confidenceStatCount);
    [loop]
    for (uint i = 1; i < reuseCount; ++i)
    {
        int2 samplePixel = clamp(int2(traceCenter) + RayReuseOffset(i, reuseCount, SSR_ResolveRadius, rotation), 0, int2(SSR_TraceResolution.xy) - 1);
        AccumulateReflectionRecord(SRV_Samples[ReflectionSampleIndex((uint2)samplePixel, 0)], (uint2)samplePixel, surface, N, radianceSum, confidenceSum, weightSum, distanceSum, distanceWeight, rawColorSum, rawColorSquareSum, rawColorCount, confidenceStatSum, confidenceStatSquareSum, confidenceStatCount);
    }

    float inverseWeight = weightSum > 0 ? rcp(weightSum) : 0;
    float edgeFade = saturate(confidenceSum * inverseWeight);
    UAV_Resolved[pixel] = float4(radianceSum * inverseWeight * edgeFade, edgeFade);
    UAV_HitDistance[pixel] = distanceWeight > 0 ? distanceSum / distanceWeight : 0;
    float3 colorMean = rawColorCount > 0 ? rawColorSum / rawColorCount : 0;
    float3 colorDev = rawColorCount > 0 ? sqrt(max(rawColorSquareSum / rawColorCount - colorMean * colorMean, 0)) : 0;
    float confidenceMean = confidenceStatCount > 0 ? confidenceStatSum / confidenceStatCount : 0;
    float confidenceDev = confidenceStatCount > 0 ? sqrt(max(confidenceStatSquareSum / confidenceStatCount - confidenceMean * confidenceMean, 0)) : 0;
    UAV_HitMean[pixel] = float4(colorMean, confidenceMean);
    UAV_HitDev[pixel] = float4(colorDev, confidenceDev);
}

float ReflectionLuma(float3 rgb)
{
    return dot(rgb, float3(0.2126729, 0.7151522, 0.0721750));
}

// ---------------------------------------------------------------------------------------------------------------------
// Temporal

[numthreads(8, 8, 1)]
void SSRTemporal(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSR_Resolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    FSSRSurface surface;
    if (!LoadSurface(pixel, surface))
    {
        UAV_Temporal[pixel] = 0;
        UAV_Meta[pixel] = uint2(asuint(surface.rawDepth), 0);
        return;
    }

    float4 current = SRV_Resolved[pixel];
    float3 colorMean = SRV_HitMean[pixel].rgb;
    float3 colorDev = max(SRV_HitDev[pixel].rgb, 1e-5);
    float currentVariance = dot(colorDev * colorDev, float3(1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0));
    float3 resolvedColor = current.a > 1e-5 ? current.rgb / current.a : 0;

    float2 uv = (pixel + 0.5) * SSR_Resolution.zw;
    float2 surfaceMotion = SRV_MotionTexture[pixel].xy;
    float2 surfaceUV;
    float expectedDepth;
    ReprojectSurface(uv, surface.rawDepth, surfaceMotion, Matrix_InvViewProj, Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj, surfaceUV, expectedDepth);

    float historyAge = 0;
    float4 motionSurface = SRV_HitMotionMetadata[pixel];
    bool validMotionSurface = motionSurface.z > 0 && isfinite(motionSurface.x) && motionSurface.x >= 0 && motionSurface.x <= 1;
    // Use the previous object surface depth, rather than projecting its current pose.
    expectedDepth = validMotionSurface ? motionSurface.x : expectedDepth;
    float historyValid = (validMotionSurface ? SSR_HistoryValid : 0) * SurfaceHistoryDepthConfidence(SRV_HistoryMeta, SRV_HistoryMeta_InfinityView, surfaceUV, expectedDepth);
    if (historyValid > 0)
    {
        float4 historyMeta = LoadSurfaceMetadata(SRV_HistoryMeta,SRV_HistoryMeta_InfinityView,surfaceUV);
        float normalAgreement = dot(surface.normalWS, OctahedronToUnitVector(historyMeta.xy));
        historyValid = normalAgreement > 0.9 && historyMeta.w >= 1 ? 1 : 0;
        historyAge = historyValid > 0 ? historyMeta.w : 0;
    }

    float historyVariance = currentVariance;
    float3 filtered = resolvedColor;
    if (historyValid > 0)
    {
        float4 surfaceHistory = InfinitySampleLevel(SRV_HistoryRadiance, Global_bilinear_clamp_sampler, surfaceUV, 0);
        float hitDistance = SRV_HitDistance[pixel];
        float2 hitUV = hitDistance > 0 ? ReprojectVirtualPoint(surface.positionWS, surface.viewRayWS, hitDistance, Matrix_HistoryViewProj) : -1;
        bool hitValid = all(hitUV >= 0) && all(hitUV <= 1);
        float4 hitHistory = hitValid ? InfinitySampleLevel(SRV_HistoryRadiance, Global_bilinear_clamp_sampler, hitUV, 0) : surfaceHistory;
        // A near-zero history alpha unpremultiplies to black and, at a ~0.97 history weight, covers this frame's hit.
        float historyConfidence = max(surfaceHistory.a, hitValid ? hitHistory.a : 0);
        bool historyHasSignal = historyConfidence >= max(current.a * 0.5, 1e-3);
        if (!historyHasSignal)
        {
            historyValid = 0;
        }
        else
        {
            float3 surfaceColor = surfaceHistory.a > 1e-5 ? surfaceHistory.rgb / surfaceHistory.a : 0;
            float3 hitColor = hitHistory.a > 1e-5 ? hitHistory.rgb / hitHistory.a : 0;
            float surfaceWeight = exp2(-10 * ReflectionLuma((surfaceColor - colorMean) / colorDev));
            float hitWeight = hitValid ? exp2(-10 * ReflectionLuma((hitColor - colorMean) / colorDev)) : 0;
            float3 surfaceColorClamped = max(clamp(surfaceColor, colorMean - colorDev, colorMean + colorDev), resolvedColor);
            float3 hitColorClamped = max(clamp(hitColor, colorMean - colorDev, colorMean + colorDev), resolvedColor);
            float weight = surfaceWeight + hitWeight;
            float3 historyColor = weight > 0
                ? (surfaceColorClamped * surfaceWeight + hitColorClamped * hitWeight) / weight
                : surfaceColorClamped;
            filtered = lerp(historyColor, resolvedColor, TemporalCurrentWeight(historyAge, SSR_TemporalWeight));
            historyVariance = SRV_HistoryVariance.SampleLevel(Global_bilinear_clamp_sampler, surfaceUV, 0);
        }
    }

    filtered = max(filtered, resolvedColor);
    UAV_Temporal[pixel] = float4(max(0, filtered) * current.a, current.a);
    UAV_Meta[pixel] = EncodeSurfaceMetadata(surface.normalWS, surface.rawDepth, (uint)NextHistoryAge(historyAge), true);
    // Hysteresis 0.5 on the reconstruction variance. The slide does not name a reprojection for this scalar.
    UAV_Variance[pixel] = lerp(currentVariance, historyVariance, historyValid > 0 ? 0.5 : 0);
}

// ---------------------------------------------------------------------------------------------------------------------
// Bilateral cleanup. The slide gives no kernel radius. Width and sample count below are a monotone
// stand-in for "variable kernel width, sample count", and 1e-4 is the gate for "only where variance high".

[numthreads(8, 8, 1)]
void SSRBilateral(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSR_Resolution.xy)) return;
    uint2 pixel = id.xy;
    float4 center = SRV_Temporal[pixel];
    float variance = SRV_Variance[pixel];
    if (variance < 1e-4)
    {
        UAV_Output[pixel] = center;
        return;
    }
    float centerDepth, centerRoughness;
    if (!IsReflectiveSurface(pixel, centerDepth, centerRoughness))
    {
        UAV_Output[pixel] = center;
        return;
    }
    float response = saturate(variance / (variance + 0.05));
    float radius = lerp(1.0, 6.0, response);
    uint sampleCount = (uint)lerp(4.0, 16.0, response);
    float centerEye = ScreenSpaceLinearEyeDepth(centerDepth);
    float3 centerNormal = normalize(SRV_GBufferB[pixel].xyz * 2 - 1);
    int2 maxPixel = int2(SSR_Resolution.xy) - 1;
    float rotation = (SSR_FrameIndex & 63u) * 0.1;
    float3 sum = 0;
    float weightSum = 0;
    [loop]
    for (uint i = 0; i < 16; ++i)
    {
        if (i >= sampleCount) break;
        int2 offset = RayReuseOffset(i + 1, sampleCount, radius, rotation);
        uint2 samplePixel = (uint2)clamp(int2(pixel) + offset, 0, maxPixel);
        float sampleDepth, sampleRoughness;
        if (!IsReflectiveSurface(samplePixel, sampleDepth, sampleRoughness)) continue;
        float3 sampleNormal = normalize(SRV_GBufferB[samplePixel].xyz * 2 - 1);
        float weight = AtrousDepthWeight(centerEye, ScreenSpaceLinearEyeDepth(sampleDepth), 0.05)
            * saturate(dot(centerNormal, sampleNormal));
        sum += SRV_Temporal[samplePixel].rgb * weight;
        weightSum += weight;
    }
    UAV_Output[pixel] = float4(weightSum > 0 ? sum / weightSum : center.rgb, center.a);
}

// ---------------------------------------------------------------------------------------------------------------------
// Debug

[numthreads(8, 8, 1)]
void SSRDebug(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSR_Resolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    uint2 tracePixel = FullToTracePixel(pixel);
    float3 color = 0;
    if (SSR_DebugMode == DEBUGVIEW_SSRTILECLASS)
    {
        uint tileClass = SRV_TileClass[tracePixel / SSR_TILE_SIZE];
        color = tileClass == SSR_CLASS_HIZ ? float3(0.1, 0.45, 1.0) : (tileClass == SSR_CLASS_LINEAR ? float3(1.0, 0.6, 0.1) : float3(0.12, 0.12, 0.12));
    }
    else if (SSR_DebugMode == DEBUGVIEW_SSRRAYHIT)
    {
        float4 ray = SRV_RayHit[tracePixel];
        if (ray.w > 0) color = float3(0, 1, 0);
        else if (ray.w < 0) color = ray.z == 2 ? float3(1, 0.45, 0) : (ray.z == 3 ? float3(0.45, 0, 0) : float3(1, 0, 0));
        else if (ray.x == 1) color = float3(1, 0, 1);
        else if (ray.x == 2) color = float3(1, 1, 0);
        else if (ray.x == 3) color = float3(0, 1, 1);
        else if (ray.x == 4) color = float3(0.2, 0.35, 1);
        else color = 0;
    }
    else if (SSR_DebugMode == DEBUGVIEW_SSRCONFIDENCE)
    {
        color = SRV_Resolved[pixel].aaa;
    }
    else if (SSR_DebugMode == DEBUGVIEW_SSRHISTORYAGE)
    {
        color = saturate(DecodeSurfaceMetadata(SRV_Meta[pixel]).w / 16.0).xxx;
    }
    UAV_Debug[pixel] = float4(color, 1);
}
