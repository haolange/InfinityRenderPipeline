#pragma kernel HalfResDownsample
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/Common.hlsl"
float4 HalfRes_FullResolution;
float4 HalfRes_HalfResolution;
Texture2D<float> SRV_FullResDepthTexture;
Texture2D<float4> SRV_FullResNormalTexture;
RWTexture2D<float> UAV_HalfResDepthTexture;
RWTexture2D<float4> UAV_HalfResNormalTexture;

[numthreads(8, 8, 1)]
void HalfResDownsample(uint3 id : SV_DispatchThreadID)
{
    uint2 size = (uint2)HalfRes_HalfResolution.xy;
    if (any(id.xy >= size)) return;
    uint2 fullSize = (uint2)HalfRes_FullResolution.xy;
    uint2 begin = id.xy * 2;
    uint2 end = min(begin + 2, fullSize);
    if (id.x == size.x - 1) end.x = fullSize.x;
    if (id.y == size.y - 1) end.y = fullSize.y;
    uint2 selected = begin;
    float depth = SRV_FullResDepthTexture[begin];
    for (uint y = begin.y; y < end.y; y++) for (uint x = begin.x; x < end.x; x++)
    {
        float candidate = SRV_FullResDepthTexture[uint2(x, y)];
#if UNITY_REVERSED_Z
        bool closer = candidate > depth;
#else
        bool closer = candidate < depth;
#endif
        if (closer) { depth = candidate; selected = uint2(x, y); }
    }
    // Depth, normal and encoded source offset belong to the same full-resolution sample.
    float3 normal = normalize(SRV_FullResNormalTexture[selected].xyz * 2 - 1);
    uint2 offset = selected - begin;
    UAV_HalfResDepthTexture[id.xy] = depth;
    UAV_HalfResNormalTexture[id.xy] = float4(normal * 0.5 + 0.5, (offset.y * 3 + offset.x) / 8.0);
}
