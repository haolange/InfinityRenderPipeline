#pragma kernel ScatterDensity
#pragma kernel Integrate
#pragma kernel Temporal

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/Lighting.hlsl"
#include "../../ShaderLibrary/ShadowSampling.hlsl"
#include "../../ShaderLibrary/Lighting/LightCookie.hlsl"
#include "../../ShaderLibrary/Random.hlsl"
#include "../../ShaderLibrary/AtmosphereCommon.hlsl"

float4 VolFog_ScreenSize;
float4 VolFog_Resolution;
float VolFog_Density;
float VolFog_Height;
float VolFog_HeightFalloff;
float4 VolFog_Albedo;
float VolFog_Anisotropy;
float VolFog_AmbientIntensity;
int VolFog_DepthSlices;
float VolFog_MaxDistance;
float VolFog_TemporalWeight;
int VolFog_FrameIndex;
float4x4 Matrix_WorldToView;

float4x4 Matrix_InvViewProj;
float3 _WorldSpaceCameraPos;

Texture2D<float> SRV_DepthTexture;
Texture2D<float> SRV_CascadeShadowMap;
Texture2D<float> SRV_LocalShadowMap;
Texture2D<float4> SRV_SkyViewLUT;
Texture3D<float4> SRV_AerialPerspectiveLUT;
Texture3D<float4> SRV_HistoryVolumetricFog;
int VolFog_HasSkyView;
int VolFog_HasAerial;
float VolFog_AerialDistance;
RWTexture3D<float4> UAV_VolumetricFogTexture;

float SliceToDepth(float slice, float maxDistance, int numSlices)
{
    float t = slice / max(numSlices, 1);
    return maxDistance * t * t;
}

float HGPhase(float g, float cosTheta)
{
    float g2 = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cosTheta;
    return (1.0 - g2) / (4.0 * Pi * pow(abs(denom), 1.5));
}

float GetFogDensity(float3 worldPos)
{
    float heightAboveFog = worldPos.y - VolFog_Height;
    float density = VolFog_Density;
    if (VolFog_HeightFalloff > 0)
    {
        density *= exp(-max(0, heightAboveFog) * VolFog_HeightFalloff);
    }
    return max(0, density);
}

float3 FroxelToWorld(uint3 froxelCoord)
{
    float2 screenUV = (froxelCoord.xy + 0.5) / VolFog_Resolution.xy;
    float depth = SliceToDepth(froxelCoord.z + 0.5, VolFog_MaxDistance, VolFog_DepthSlices);
    float2 ndc = screenUV * 2.0 - 1.0;
    float4 clipPos = float4(ndc, 0.5, 1.0);
    float4 worldPos = mul(Matrix_InvViewProj, clipPos);
    worldPos /= worldPos.w;
    float3 viewDir = normalize(worldPos.xyz - _WorldSpaceCameraPos);
    return _WorldSpaceCameraPos + viewDir * depth;
}

float VolumeLightAttenuation(FLightRecord light, float3 worldPos)
{
    return IsDirectionalLight(light) ? 1.0 : LocalLightAttenuation(light, worldPos);
}

float3 EvaluateVolumeLight(FLightRecord light, float3 worldPos, float3 viewDir, float3 scattering, float viewDepth, Texture2D<float> cascadeShadowMap, Texture2D<float> localShadowMap)
{
    float3 L;
    float att = 1.0;
    float shadow;
    if (IsDirectionalLight(light))
    {
        L = DirectionalLightL(light);
        shadow = ((light.flags & LIGHT_FLAG_SHADOW) != 0 && light.shadowSliceCount > 0 ? SampleCascadeShadow(cascadeShadowMap, light, worldPos, viewDepth) : 1);
    }
    else
    {
        L = LocalLightL(light, worldPos);
        att = VolumeLightAttenuation(light, worldPos);
        shadow = SampleLocalShadow(localShadowMap, light, worldPos);
    }

    shadow = VolumeShadowWeight(light, lerp(1, shadow, LightShadowStrength(light)));

    float cosTheta = dot(viewDir, L);
    float phase = HGPhase(VolFog_Anisotropy, cosTheta);
    return scattering * VolumeLightRadiance(light) * LightCookieColor(light, worldPos) * phase * shadow * att;
}

void AccumulateLocalLights(float3 worldPos, float3 viewDir, float3 scattering, float viewDepth, float2 screenUV, inout float3 inScatter, Texture2D<float> cascadeShadowMap, Texture2D<float> localShadowMap)
{
    if (g_LocalLightCount <= 0)
    {
        return;
    }

    FLightLoop lightLoop = BeginLightLoopUV(screenUV, viewDepth);
    uint recordIndex;
    [loop]
    while (NextLight(lightLoop, recordIndex))
    {
        inScatter += EvaluateVolumeLight(g_LightRecordBuffer[recordIndex], worldPos, viewDir, scattering, viewDepth, cascadeShadowMap, localShadowMap);
    }
}

[numthreads(8, 8, 1)]
void ScatterDensity(uint3 id : SV_DispatchThreadID)
{
    uint3 froxelRes = uint3(VolFog_Resolution.xyz);
    if (any(id.xy >= froxelRes.xy))
        return;

    [loop]
    for (uint z = 0; z < (uint)VolFog_DepthSlices; ++z)
    {
        float3 worldPos = FroxelToWorld(uint3(id.xy, z));
        float density = GetFogDensity(worldPos);
        if (density < 1e-6)
        {
            UAV_VolumetricFogTexture[uint3(id.xy, z)] = 0;
            continue;
        }

        float3 extinction = density;
        float3 scattering = density * VolFog_Albedo.rgb;
        float3 inScatter = 0;
        float3 viewDir = normalize(worldPos - _WorldSpaceCameraPos);
        float3 viewPos = mul(Matrix_WorldToView, float4(worldPos, 1.0)).xyz;
        float viewDepth = -viewPos.z;
        float2 screenUV = (id.xy + 0.5) / VolFog_Resolution.xy;

        [loop]
        for (int d = 0; d < g_DirectionalLightCount; ++d)
        {
            inScatter += EvaluateVolumeLight(g_LightRecordBuffer[d], worldPos, viewDir, scattering, viewDepth, SRV_CascadeShadowMap, SRV_LocalShadowMap);
        }

        AccumulateLocalLights(worldPos, viewDir, scattering, viewDepth, screenUV, inScatter, SRV_CascadeShadowMap, SRV_LocalShadowMap);

        if (VolFog_HasSkyView != 0)
        {
            inScatter += scattering * SampleAtmosphereSkyViewLUT(SRV_SkyViewLUT, viewDir) * VolFog_AmbientIntensity;
        }
        else
        {
            inScatter += scattering * VolFog_AmbientIntensity;
        }

        if (VolFog_HasAerial != 0)
        {
            float linearDepth = length(worldPos - _WorldSpaceCameraPos);
            float4 aerial = SampleAtmosphereAerialLUT(SRV_AerialPerspectiveLUT, screenUV, linearDepth, VolFog_AerialDistance);
            inScatter += aerial.rgb * density;
        }

        UAV_VolumetricFogTexture[uint3(id.xy, z)] = float4(inScatter, extinction.x);
    }
}

[numthreads(8, 8, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    uint3 froxelRes = uint3(VolFog_Resolution.xyz);
    if (any(id.xy >= froxelRes.xy))
        return;

    float4 accumulatedScatterTransmittance = float4(0, 0, 0, 1);

    [loop]
    for (uint z = 0; z < (uint)VolFog_DepthSlices; ++z)
    {
        float4 voxelData = UAV_VolumetricFogTexture[uint3(id.xy, z)];
        float3 inScatter = voxelData.rgb;
        float extinction = voxelData.a;
        float sliceNear = SliceToDepth((float)z, VolFog_MaxDistance, VolFog_DepthSlices);
        float sliceFar = SliceToDepth((float)(z + 1), VolFog_MaxDistance, VolFog_DepthSlices);
        float sliceThickness = sliceFar - sliceNear;
        float sliceTransmittance = exp(-extinction * sliceThickness);
        float3 sliceScatter = extinction > 0 ? inScatter * (1.0 - sliceTransmittance) / extinction : inScatter * sliceThickness;
        accumulatedScatterTransmittance.rgb += accumulatedScatterTransmittance.a * sliceScatter;
        accumulatedScatterTransmittance.a *= sliceTransmittance;
        UAV_VolumetricFogTexture[uint3(id.xy, z)] = accumulatedScatterTransmittance;
    }
}

[numthreads(8, 8, 1)]
void Temporal(uint3 id : SV_DispatchThreadID)
{
    uint3 froxelRes = uint3(VolFog_Resolution.xyz);
    if (any(id.xy >= froxelRes.xy))
        return;

    float weight = saturate(VolFog_TemporalWeight);
    [loop]
    for (uint z = 0; z < (uint)VolFog_DepthSlices; ++z)
    {
        float4 current = UAV_VolumetricFogTexture[uint3(id.xy, z)];
        float4 history = SRV_HistoryVolumetricFog[uint3(id.xy, z)];
        UAV_VolumetricFogTexture[uint3(id.xy, z)] = lerp(current, history, weight);
    }
}
