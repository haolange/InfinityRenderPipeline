#include "Packages/com.infinity.render-pipeline/Shaders/ShaderLibrary/TextureView.hlsl"
#pragma kernel FogComposite

#pragma multi_compile_local _ FOG_COMPOSITE_FOG
#pragma multi_compile_local _ FOG_COMPOSITE_CLOUD

#include "../../ShaderLibrary/Common.hlsl"

float4 FogComposite_Resolution;
float FogComposite_MaxDistance;
float4x4 Matrix_InvViewProj;
float3 _WorldSpaceCameraPos;

Texture2D<float> SRV_DepthTexture;
Texture2D<float4> SRV_SceneColorTexture;
#if defined(FOG_COMPOSITE_FOG)
Texture3D<float4> SRV_VolumetricFogTexture;
#endif
#if defined(FOG_COMPOSITE_CLOUD)
Texture2D<float4> SRV_VolumetricCloudTexture;
#endif
RWTexture2D<float4> UAV_FoggedSceneColorTexture;

[numthreads(8, 8, 1)]
void FogComposite(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)FogComposite_Resolution.xy))
        return;

    float2 screenUV = (id.xy + 0.5) * FogComposite_Resolution.zw;
    float3 sceneColor = InfinitySampleLevel(SRV_SceneColorTexture,Global_point_clamp_sampler,screenUV,0).rgb;
    float depth = InfinitySampleLevel(SRV_DepthTexture,Global_point_clamp_sampler,screenUV,0).r;

    float2 ndc = screenUV * 2.0 - 1.0;
    float4 world = mul(Matrix_InvViewProj, float4(ndc, depth, 1.0));
    world.xyz /= max(world.w, 1e-6);
    float linearDepth = length(world.xyz - _WorldSpaceCameraPos);

#if defined(FOG_COMPOSITE_FOG)
    float fogSlice = saturate(sqrt(linearDepth / max(FogComposite_MaxDistance, 1.0)));
    float4 fogData = InfinitySampleLevelTrilinear(SRV_VolumetricFogTexture,Global_trilinear_clamp_sampler,float3(screenUV, fogSlice),0);
    sceneColor = sceneColor * fogData.a + fogData.rgb;
#endif

#if defined(FOG_COMPOSITE_CLOUD)
    float4 cloudData = InfinitySampleLevel(SRV_VolumetricCloudTexture,Global_bilinear_clamp_sampler,screenUV,0);
    sceneColor = sceneColor * cloudData.a + cloudData.rgb;
#endif

    UAV_FoggedSceneColorTexture[id.xy] = float4(max(0, sceneColor), 1);
}
