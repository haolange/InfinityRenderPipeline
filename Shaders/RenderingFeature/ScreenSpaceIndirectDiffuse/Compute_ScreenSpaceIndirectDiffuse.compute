#include "Packages/com.infinity.render-pipeline/Shaders/ShaderLibrary/TextureView.hlsl"
// Screen-space indirect diffuse on the stochastic SSR core (Compute_ScreenSpaceReflection): the same trace tiles,
// half-resolution quad rotation, Hi-Z walk, ray records, ray-reuse resolve and denoise library, with a cosine lobe.
//
//   SSGIClassify      one group per 8x8 trace tile: trace when a deferred surface is in the tile, else skip
//   SSGIClearSkipped  indirect over skip tiles: clears their ray records
//   SSGITrace         indirect over trace tiles: one cosine-distributed ray per trace pixel, Hi-Z walk
//   SSGIResolve       full resolution: ratio estimator over neighbor rays, filtered importance sampling mip
//   SSGITemporal      full resolution: surface reprojection, variance clip, per-pixel history age
//   SSGISpatial       full resolution: optional 5x5 a-trous pass
//
// Resolved / Temporal / SSGITexture (RGBA16F): rgb = irradiance / pi (the Lambert-convolved radiance, multiplied by
// albedo in the composite) premultiplied by confidence, a = confidence. A miss carries weight but no confidence, so
// that part of the pixel keeps its baked, probe or sky indirect diffuse.
// Meta (RGBA16F): octahedral world normal, raw depth, history age in frames (0 = no history).

#pragma kernel SSGIClassify
#pragma kernel SSGIClearSkipped
#pragma kernel SSGITrace
#pragma kernel SSGIResolve
#pragma kernel SSGITemporal
#pragma kernel SSGISpatial

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDepth.hlsl"
#include "../../ShaderLibrary/ScreenSpaceReprojection.hlsl"
#include "../../ShaderLibrary/GBufferPack.hlsl"
#include "../../ShaderLibrary/RayTracing/ScreenSpaceRayTrace/SSRTRayCast.hlsl"
#include "../../ShaderLibrary/RayTracing/ScreenSpaceRayTrace/ScreenSpaceTraceTiles.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDenoise/TemporalAccumulation.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDenoise/AtrousFilter.hlsl"

#define SSGI_TILE_SIZE SCREEN_SPACE_TRACE_TILE_SIZE
#define SSGI_CLASS_TRACE 0
#define SSGI_CLASS_SKIP 1
#define SSGI_EDGE_FADE 0.05

float4 SSGI_Resolution;
float4 SSGI_TraceResolution;
uint SSGI_TraceScale;
uint SSGI_FrameIndex;
uint SSGI_MaxTiles;
uint SSGI_TileListOffset;
float SSGI_MaxDistance;
float SSGI_Thickness;
float SSGI_Intensity;
uint SSGI_HiZSteps;
uint SSGI_ResolveSamples;
float SSGI_ResolveRadius;
float SSGI_TemporalWeight;
float SSGI_TemporalClampScale;
float SSGI_HistoryValid;
// xyz = world position, w = 1 for orthographic cameras.
float4 SSGI_CameraPosition;
float4 SSGI_CameraForward;
float4x4 Matrix_Proj, Matrix_InvProj, Matrix_InvViewProj, Matrix_WorldToView;
float4x4 Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj;

Texture2D<float> SRV_DepthTexture;
Texture2D SRV_HiZTexture;
Texture2D SRV_GBufferB;
Texture2D SRV_GBufferC;
Texture2D SRV_LightingPyramid;
Texture2D SRV_MotionTexture;
Texture2D SRV_HistoryRadiance;
Texture2D SRV_HistoryMeta;
Texture2D<float4> SRV_RayHit;
Texture2D<float4> SRV_Resolved;
Texture2D<float4> SRV_Temporal;
StructuredBuffer<uint> SRV_TileList;

RWStructuredBuffer<uint> UAV_TileArgs;
RWStructuredBuffer<uint> UAV_TileList;
RWTexture2D<float4> UAV_RayHit;
RWTexture2D<float4> UAV_Resolved;
RWTexture2D<float4> UAV_Temporal;
RWTexture2D<float4> UAV_Meta;
RWTexture2D<float4> UAV_Output;

#include "../../ShaderLibrary/ScreenSpaceIndirectSurface.hlsl"

uint2 TraceToFullPixel(uint2 tracePixel)
{
    return TraceToFullPixel(tracePixel, SSGI_TraceScale, SSGI_FrameIndex, (uint2)SSGI_Resolution.xy);
}

uint2 FullToTracePixel(uint2 pixel)
{
    return FullToTracePixel(pixel, SSGI_TraceScale, (uint2)SSGI_TraceResolution.xy);
}

// ---------------------------------------------------------------------------------------------------------------------
// Classification

groupshared uint gs_SurfaceCount;

[numthreads(SSGI_TILE_SIZE, SSGI_TILE_SIZE, 1)]
void SSGIClassify(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
    if (groupIndex == 0)
    {
        gs_SurfaceCount = 0;
    }
    GroupMemoryBarrierWithGroupSync();

    uint2 tracePixel = groupId.xy * SSGI_TILE_SIZE + groupThreadId.xy;
    float rawDepth;
    if (all(tracePixel < (uint2)SSGI_TraceResolution.xy) && IsIndirectSurface(TraceToFullPixel(tracePixel), rawDepth))
    {
        InterlockedAdd(gs_SurfaceCount, 1u);
    }
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex == 0)
    {
        uint tileClass = gs_SurfaceCount > 0 ? SSGI_CLASS_TRACE : SSGI_CLASS_SKIP;
        uint slot;
        InterlockedAdd(UAV_TileArgs[tileClass * 3], 1u, slot);
        UAV_TileList[tileClass * SSGI_MaxTiles + slot] = PackTraceTile(groupId.xy);
    }
}

uint2 TileTracePixel(uint3 groupId, uint3 groupThreadId)
{
    return UnpackTraceTile(SRV_TileList[SSGI_TileListOffset + groupId.x]) * SSGI_TILE_SIZE + groupThreadId.xy;
}

[numthreads(SSGI_TILE_SIZE, SSGI_TILE_SIZE, 1)]
void SSGIClearSkipped(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint2 tracePixel = TileTracePixel(groupId, groupThreadId);
    if (all(tracePixel < (uint2)SSGI_TraceResolution.xy))
    {
        UAV_RayHit[tracePixel] = 0;
    }
}

// ---------------------------------------------------------------------------------------------------------------------
// Trace

[numthreads(SSGI_TILE_SIZE, SSGI_TILE_SIZE, 1)]
void SSGITrace(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint2 tracePixel = TileTracePixel(groupId, groupThreadId);
    if (any(tracePixel >= (uint2)SSGI_TraceResolution.xy))
    {
        return;
    }

    FSSGISurface surface;
    if (!LoadSurface(TraceToFullPixel(tracePixel), surface))
    {
        UAV_RayHit[tracePixel] = 0;
        return;
    }

    // Cosine-distributed direction around the normal: pdf = NoL / pi.
    float2 E = float2(GetBNDSequenceSample(tracePixel, SSGI_FrameIndex, 0), GetBNDSequenceSample(tracePixel, SSGI_FrameIndex, 1));
    float4 sampleL = CosineSampleHemisphere(E);
    float3 L = mul(sampleL.xyz, GetTangentBasis(surface.normalWS));
    float pdf = sampleL.w;

    float3 directionVS = normalize(mul((float3x3)Matrix_WorldToView, L));
    float jitter = GetBNDSequenceSample(tracePixel, SSGI_FrameIndex, 2);
    float3 hit;
    bool found = TraceScreenSpaceRay(surface.positionVS, directionVS, SSGI_MaxDistance, SSGI_Thickness, SSGI_HiZSteps, jitter, Matrix_Proj, SRV_HiZTexture, SRV_HiZTexture_InfinityView, hit);
    UAV_RayHit[tracePixel] = found ? EncodeRayHit(hit, pdf) : EncodeRayMiss(L, pdf);
}

// ---------------------------------------------------------------------------------------------------------------------
// Resolve (ray reuse)

[numthreads(8, 8, 1)]
void SSGIResolve(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSGI_Resolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    FSSGISurface surface;
    if (!LoadSurface(pixel, surface))
    {
        UAV_Resolved[pixel] = 0;
        return;
    }

    float3 N = surface.normalWS;
    uint lightingWidth, lightingHeight, lightingMips;
    InfinityGetMipDimensions(SRV_LightingPyramid, 0, lightingWidth, lightingHeight, lightingMips);
    // Pixels covered by one world unit at eye depth 1.
    float projectionScale = 0.5 * SSGI_Resolution.y * abs(Matrix_Proj[1][1]);

    uint2 traceCenter = FullToTracePixel(pixel);
    uint sampleCount = clamp(SSGI_ResolveSamples, 1u, 16u);
    float rotation = InterleavedGradientNoise(float2(pixel) + 0.5, (float)(SSGI_FrameIndex & 7u)) * 6.2831853;

    float weightSum = 0;
    float3 radianceSum = 0;
    float confidenceSum = 0;
    [loop]
    for (uint i = 0; i < sampleCount; ++i)
    {
        int2 samplePixel = clamp(int2(traceCenter) + RayReuseOffset(i, sampleCount, SSGI_ResolveRadius, rotation), 0, int2(SSGI_TraceResolution.xy) - 1);
        float4 ray = SRV_RayHit[samplePixel];
        if (ray.w == 0)
        {
            continue;
        }

        float pdf = abs(ray.w);
        float3 L;
        float3 radiance = 0;
        float hitConfidence = 0;
        if (ray.w > 0)
        {
            float3 hitWS = GetWorldSpacePos(GetNDCPos(ray.xy, ray.z), Matrix_InvViewProj);
            float3 toHit = hitWS - surface.positionWS;
            float hitDistance = length(toHit);
            if (hitDistance <= 1e-4)
            {
                continue;
            }
            L = toHit / hitDistance;

            // Light leaves the front of the hit surface only; a ray landing on a back face is a miss.
            uint2 hitPixel = min((uint2)(ray.xy * SSGI_Resolution.xy), (uint2)SSGI_Resolution.xy - 1);
            float3 hitNormal = normalize(SRV_GBufferB[hitPixel].xyz * 2 - 1);
            float facing = saturate(-dot(hitNormal, L) * 4);
            float distanceFade = saturate((SSGI_MaxDistance - hitDistance) / max(0.1 * SSGI_MaxDistance, 1e-3));
            hitConfidence = GetScreenFadeBord(ray.xy, SSGI_EDGE_FADE) * facing * distanceFade;

            float mip = RayConeMip(pdf, sampleCount, hitDistance, projectionScale, ScreenSpaceLinearEyeDepth(ray.z), lightingMips);
            radiance = InfinitySampleLevelTrilinear(SRV_LightingPyramid,Global_trilinear_clamp_sampler,ray.xy,mip).rgb * SSGI_Intensity;
        }
        else
        {
            L = OctahedronToUnitVector(ray.xy);
        }

        float NoL = dot(N, L);
        if (NoL <= 0)
        {
            continue;
        }

        // Ratio estimator sum(f * Li / pdf) / sum(f / pdf) with f = NoL / pi, whose hemisphere integral is 1: the
        // result is the Lambert-convolved radiance. The 1 / pi cancels in the ratio.
        float weight = NoL / pdf;
        weightSum += weight;
        radianceSum += weight * hitConfidence * radiance;
        confidenceSum += weight * hitConfidence;
    }

    float inverseWeight = weightSum > 0 ? rcp(weightSum) : 0;
    UAV_Resolved[pixel] = float4(radianceSum * inverseWeight, saturate(confidenceSum * inverseWeight));
}

// ---------------------------------------------------------------------------------------------------------------------
// Temporal

[numthreads(8, 8, 1)]
void SSGITemporal(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSGI_Resolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    FSSGISurface surface;
    if (!LoadSurface(pixel, surface))
    {
        UAV_Temporal[pixel] = 0;
        UAV_Meta[pixel] = float4(0, 0, surface.rawDepth, 0);
        return;
    }

    float4 current = SRV_Resolved[pixel];
    float4 sum = 0;
    float4 sumSquares = 0;
    int2 maxPixel = int2(SSGI_Resolution.xy) - 1;
    [unroll]
    for (int y = -1; y <= 1; ++y)
    {
        [unroll]
        for (int x = -1; x <= 1; ++x)
        {
            float4 value = SRV_Resolved[clamp(int2(pixel) + int2(x, y), 0, maxPixel)];
            sum += value;
            sumSquares += value * value;
        }
    }
    FNeighborhoodMoments moments = ResolveNeighborhoodMoments(sum, sumSquares, 9, current, SSGI_TemporalClampScale);

    float2 uv = (pixel + 0.5) * SSGI_Resolution.zw;
    float2 surfaceUV;
    float expectedDepth;
    ReprojectSurface(uv, surface.rawDepth, SRV_MotionTexture[pixel].xy, Matrix_InvViewProj, Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj, surfaceUV, expectedDepth);

    // Diffuse lighting follows the surface; there is no virtual image to track.
    float historyAge = 0;
    float4 history = current;
    float historyValid = SSGI_HistoryValid * HistoryDepthConfidence(SRV_HistoryMeta, SRV_HistoryMeta_InfinityView, surfaceUV, expectedDepth, 2);
    if (historyValid > 0)
    {
        float4 historyMeta = InfinitySampleLevel(SRV_HistoryMeta,Global_point_clamp_sampler,surfaceUV,0);
        historyValid = dot(surface.normalWS, OctahedronToUnitVector(historyMeta.xy)) > 0.9 && historyMeta.w >= 1 ? 1 : 0;
        historyAge = historyValid > 0 ? historyMeta.w : 0;
    }
    if (historyValid > 0)
    {
        history = ClipHistoryToNeighborhood(InfinitySampleLevel(SRV_HistoryRadiance,Global_bilinear_clamp_sampler,surfaceUV,0), moments);
    }

    float currentWeight = TemporalCurrentWeight(historyAge, SSGI_TemporalWeight);
    UAV_Temporal[pixel] = max(0, lerp(history, current, currentWeight));
    UAV_Meta[pixel] = float4(UnitVectorToOctahedron(surface.normalWS), surface.rawDepth, NextHistoryAge(historyAge));
}

// ---------------------------------------------------------------------------------------------------------------------
// Spatial

[numthreads(8, 8, 1)]
void SSGISpatial(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSGI_Resolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    float4 center = SRV_Temporal[pixel];
    float centerDepth;
    if (!IsIndirectSurface(pixel, centerDepth))
    {
        UAV_Output[pixel] = center;
        return;
    }

    float centerEye = ScreenSpaceLinearEyeDepth(centerDepth);
    float3 centerNormal = normalize(SRV_GBufferB[pixel].xyz * 2 - 1);
    // Indirect diffuse is low frequency: taps two pixels apart.
    const float spacing = 2.0;
    int2 maxPixel = int2(SSGI_Resolution.xy) - 1;

    float4 sum = 0;
    float weightSum = 0;
    [unroll]
    for (int y = -2; y <= 2; ++y)
    {
        [unroll]
        for (int x = -2; x <= 2; ++x)
        {
            int2 tap = int2(x, y);
            uint2 samplePixel = (uint2)clamp(int2(pixel) + (int2)round(float2(tap) * spacing), 0, maxPixel);
            float sampleDepth;
            if (!IsIndirectSurface(samplePixel, sampleDepth))
            {
                continue;
            }
            float3 sampleNormal = normalize(SRV_GBufferB[samplePixel].xyz * 2 - 1);
            float weight = AtrousKernelWeight(tap)
                * AtrousDepthWeight(centerEye, ScreenSpaceLinearEyeDepth(sampleDepth), 0.05)
                * AtrousNormalWeight(centerNormal, sampleNormal, 16);
            sum += SRV_Temporal[samplePixel] * weight;
            weightSum += weight;
        }
    }
    UAV_Output[pixel] = weightSum > 0 ? sum / weightSum : center;
}
