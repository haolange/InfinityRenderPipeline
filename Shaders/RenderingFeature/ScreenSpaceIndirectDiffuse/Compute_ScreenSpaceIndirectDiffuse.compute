#include "Packages/com.infinity.render-pipeline/Shaders/ShaderLibrary/TextureView.hlsl"
// One 8x8 group compacts valid pixels in groupshared, then those lanes trace Samples cosine rays.
// The production march is Hi-Z. Define SSGI_TRACE_LINEAR to use the 2D march plus binary refine instead.
// Denoise is temporal, a 6 m world-space pass, temporal, then a 3 m world-space pass. Upsample is full resolution.
// #define SSGI_TRACE_LINEAR
#pragma kernel SSGITrace
#pragma kernel SSGITemporal
#pragma kernel SSGISpatial
#pragma kernel SSGIUpsample
#pragma kernel SSGITraceDebug SSGI_DIAGNOSTICS

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDepth.hlsl"
#include "../../ShaderLibrary/ScreenSpaceReprojection.hlsl"
#include "../../ShaderLibrary/TemporalColorSource.hlsl"
#include "../../ShaderLibrary/GBufferPack.hlsl"
#include "../../ShaderLibrary/ScreenSpaceSurfaceMetadata.hlsl"
#include "../../ShaderLibrary/RayTracing/ScreenSpaceRayTrace/SSRTRayCast.hlsl"
#include "../../ShaderLibrary/RayTracing/ScreenSpaceRayTrace/ScreenSpaceTraceTiles.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDenoise/TemporalAccumulation.hlsl"
#include "../../ShaderLibrary/ScreenSpaceDenoise/AtrousFilter.hlsl"

#define SSGI_TILE_SIZE SCREEN_SPACE_TRACE_TILE_SIZE
#define SSGI_EDGE_FADE 0.05

float4 SSGI_Resolution;
float4 SSGI_TraceResolution;
uint SSGI_TraceScale;
uint SSGI_FrameIndex;
uint SSGI_PreviousFrameIndex;
float SSGI_Intensity;
uint SSGI_HiZSteps;
uint SSGI_TraceFlags;
uint SSGI_Samples;
uint SSGI_SpatialPass;
uint SSGI_HasAO;
float SSGI_FrameAngle;
float SSGI_TemporalWeight;
float SSGI_TemporalClampScale;
float SSGI_HistoryValid;
// xyz = world position, w = 1 for orthographic cameras.
float4 SSGI_CameraPosition;
float4 SSGI_CameraForward;
float4x4 Matrix_Proj, Matrix_InvProj, Matrix_InvViewProj, Matrix_WorldToView;
float4x4 Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj;

Texture2D<float> SRV_DepthTexture;
Texture2D<float> SRV_HiZClosestTexture;
Texture2D<float> SRV_HiZFurthestTexture;
Texture2D SRV_GBufferB;
Texture2D SRV_GBufferC;
Texture2D<float4> SRV_HitMotionMetadata;
Texture2D SRV_MotionTexture;
Texture2D SRV_HistoryRadiance;
Texture2D<uint2> SRV_HistoryMeta;
Texture2D<float4> SRV_TraceRadiance;
Texture2D<float4> SRV_Current;
Texture2D<float4> SRV_Temporal;
Texture2D<float> SRV_Occlusion;
Texture2D<float4> SRV_Filtered;
Texture2D<uint2> SRV_Meta;

RWTexture2D<float4> UAV_RayHit;
RWTexture2D<float4> UAV_TraceRadiance;
RWTexture2D<float> UAV_HitDistance;
RWTexture2D<float4> UAV_Temporal;
RWTexture2D<uint2> UAV_Meta;
RWTexture2D<float4> UAV_Output;

#include "../../ShaderLibrary/ScreenSpaceIndirectSurface.hlsl"

uint2 TraceToFullPixel(uint2 tracePixel)
{
    return TraceToFullPixel(tracePixel, SSGI_TraceScale, SSGI_FrameIndex, (uint2)SSGI_Resolution.xy);
}

uint2 FullToTracePixel(uint2 pixel)
{
    return FullToTracePixel(pixel, SSGI_TraceScale, (uint2)SSGI_TraceResolution.xy);
}

// ---------------------------------------------------------------------------------------------------------------------
// Tile-local inclusive prefix. Every lane participates, then each valid lane traces its own pixel.
groupshared uint gs_Prefix[64];

void TracePixel(uint2 tracePixel)
{
    FSSGISurface surface;
    bool valid = LoadSurface(TraceToFullPixel(tracePixel), surface);
    if (!valid) return;
    uint spp = clamp(SSGI_Samples, 1u, 4u);
    float4 radiance = 0;
    float hitDistance = 0;
    [loop]
    for (uint rayIndex = 0; rayIndex < spp; ++rayIndex)
    {
        // Cosine-distributed direction around the normal: pdf = NoL / pi. f/pdf = 1.
        float2 E = float2(GetBNDSequenceSample(tracePixel, SSGI_FrameIndex, (int)(rayIndex * 3)), GetBNDSequenceSample(tracePixel, SSGI_FrameIndex, (int)(rayIndex * 3 + 1)));
        float4 sampleL = CosineSampleHemisphere(E);
        float3 L = mul(sampleL.xyz, GetTangentBasis(surface.normalWS));
        float3 directionVS = normalize(mul((float3x3)Matrix_WorldToView, L));
        float jitter = GetBNDSequenceSample(tracePixel, SSGI_FrameIndex, (int)(rayIndex * 3 + 2));
        FScreenSpaceHit hit = (FScreenSpaceHit)0;
#if defined(SSGI_TRACE_LINEAR)
        bool found = TraceScreenSpaceLinear(surface.positionVS, directionVS, SSGI_HiZSteps * 4, 4, jitter, SSGI_TraceFlags, Matrix_Proj, SRV_DepthTexture, SRV_DepthTexture_InfinityView, SRV_HiZClosestTexture, SRV_HiZClosestTexture_InfinityView, SRV_HiZFurthestTexture, hit);
#else
        bool found = TraceScreenSpaceHiZ(surface.positionVS, directionVS, SSGI_HiZSteps, jitter, SSGI_TraceFlags, Matrix_Proj, SRV_DepthTexture, SRV_DepthTexture_InfinityView, SRV_HiZClosestTexture, SRV_HiZClosestTexture_InfinityView, SRV_HiZFurthestTexture, hit);
#endif
#ifdef SSGI_DIAGNOSTICS
        if (rayIndex == 0) UAV_RayHit[tracePixel] = found ? EncodeRayHit(float3(hit.uv, hit.rawDepth), sampleL.w) : EncodeRayMiss(L, sampleL.w, hit.exitReason);
#endif
        if (found)
        {
            float3 hitWS = GetWorldSpacePos(GetNDCPos(hit.uv, hit.rawDepth), Matrix_InvViewProj);
            float distance = length(hitWS - surface.positionWS);
            uint2 hitPixel = min((uint2)(hit.uv * SSGI_Resolution.xy), (uint2)SSGI_Resolution.xy - 1);
            float3 hitNormal = normalize(SRV_GBufferB[hitPixel].xyz * 2 - 1);
            float confidence;
            float3 color = SampleTemporalHitColor(hit.uv, hit.rawDepth, SRV_MotionTexture[hitPixel].xy, SRV_HitMotionMetadata[hitPixel], 0,
                Matrix_InvViewProj, Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj, confidence);
            confidence *= GetScreenFadeBord(hit.uv, SSGI_EDGE_FADE) * saturate(-dot(hitNormal, L) * 4);
            radiance += float4(color * (SSGI_Intensity * confidence), confidence);
            hitDistance += distance;
        }
    }
    UAV_TraceRadiance[tracePixel] = radiance / spp;
    UAV_HitDistance[tracePixel] = hitDistance / spp;
}

void TraceGroup(uint3 groupId, uint3 lane, uint index)
{
    uint2 pixel = groupId.xy * 8 + lane.xy;
    bool inside = all(pixel < (uint2)SSGI_TraceResolution.xy);
    float depth = 0;
    bool valid = inside && IsIndirectSurface(TraceToFullPixel(pixel), depth);
    gs_Prefix[index] = valid ? 1u : 0u;
    if (inside)
    {
        UAV_TraceRadiance[pixel] = 0;
        UAV_HitDistance[pixel] = 0;
#ifdef SSGI_DIAGNOSTICS
        UAV_RayHit[pixel] = 0;
#endif
    }
    GroupMemoryBarrierWithGroupSync();
    [unroll] for (uint offset = 1; offset < 64; offset <<= 1)
    {
        uint previous = index >= offset ? gs_Prefix[index - offset] : 0;
        GroupMemoryBarrierWithGroupSync();
        gs_Prefix[index] += previous;
        GroupMemoryBarrierWithGroupSync();
    }
    if (valid) TracePixel(pixel);
}

[numthreads(8, 8, 1)]
void SSGITrace(uint3 groupId : SV_GroupID, uint3 lane : SV_GroupThreadID, uint index : SV_GroupIndex) { TraceGroup(groupId, lane, index); }
[numthreads(8, 8, 1)]
void SSGITraceDebug(uint3 groupId : SV_GroupID, uint3 lane : SV_GroupThreadID, uint index : SV_GroupIndex) { TraceGroup(groupId, lane, index); }

[numthreads(8, 8, 1)]
void SSGITemporal(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSGI_TraceResolution.xy))
    {
        return;
    }
    uint2 pixel = id.xy;
    FSSGISurface surface;
    if (!LoadSurface(TraceToFullPixel(pixel), surface))
    {
        UAV_Temporal[pixel] = 0;
        UAV_Meta[pixel] = uint2(asuint(surface.rawDepth), 0);
        return;
    }

    float4 current = SRV_Current[pixel];
    float4 sum = 0;
    float4 sumSquares = 0;
    int2 maxPixel = int2(SSGI_TraceResolution.xy) - 1;
    [unroll]
    for (int y = -1; y <= 1; ++y)
    {
        [unroll]
        for (int x = -1; x <= 1; ++x)
        {
            float4 value = SRV_Current[clamp(int2(pixel) + int2(x, y), 0, maxPixel)];
            sum += value;
            sumSquares += value * value;
        }
    }
    FNeighborhoodMoments moments = ResolveNeighborhoodMoments(sum, sumSquares, 9, current, SSGI_TemporalClampScale);

    uint2 surfacePixel = TraceToFullPixel(pixel);
    float2 uv = (surfacePixel + 0.5) * SSGI_Resolution.zw;
    float2 surfaceUV;
    float expectedDepth;
    ReprojectSurface(uv, surface.rawDepth, SRV_MotionTexture[surfacePixel].xy, Matrix_InvViewProj, Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj, surfaceUV, expectedDepth);

    // Diffuse lighting follows the surface; there is no virtual image to track.

    if (SSGI_TraceScale > 1)
    {
        uint2 offset = TraceToFullPixel(uint2(0,0), SSGI_TraceScale, SSGI_PreviousFrameIndex, (uint2)SSGI_Resolution.xy);
        surfaceUV = ((surfaceUV * SSGI_Resolution.xy - offset - 0.5) / SSGI_TraceScale + 0.5) * SSGI_TraceResolution.zw;
    }
    float historyAge = 0;
    float4 history = current;
    float4 motionSurface = SRV_HitMotionMetadata[surfacePixel];
    bool validMotionSurface = motionSurface.z > 0 && isfinite(motionSurface.x) && motionSurface.x >= 0 && motionSurface.x <= 1;
    // Use the previous object surface depth, rather than projecting its current pose.
    expectedDepth = validMotionSurface ? motionSurface.x : expectedDepth;
    float historyValid = (validMotionSurface ? SSGI_HistoryValid : 0) * SurfaceHistoryDepthConfidence(SRV_HistoryMeta, SRV_HistoryMeta_InfinityView, surfaceUV, expectedDepth);
    if (historyValid > 0)
    {
        float4 historyMeta = LoadSurfaceMetadata(SRV_HistoryMeta,SRV_HistoryMeta_InfinityView,surfaceUV);
        historyValid = dot(surface.normalWS, OctahedronToUnitVector(historyMeta.xy)) > 0.9 && historyMeta.w >= 1 ? 1 : 0;
        historyAge = historyValid > 0 ? historyMeta.w : 0;
    }
    if (historyValid > 0)
    {
        history = ClipHistoryToNeighborhood(InfinitySampleLevel(SRV_HistoryRadiance,Global_bilinear_clamp_sampler,surfaceUV,0), moments);
    }

    float currentWeight = TemporalCurrentWeight(historyAge, SSGI_TemporalWeight);
    UAV_Temporal[pixel] = max(0, lerp(history, current, currentWeight));
    UAV_Meta[pixel] = EncodeSurfaceMetadata(surface.normalWS, surface.rawDepth, (uint)NextHistoryAge(historyAge), true);
}

// World-space poisson denoise plus the combiner. F(viewZ), F(variance) and F(AO) have no body on the
// Metro slide; the mappings below are monotone stand-ins. Plane-distance step uses 5 cm or 2% of the radius.
[numthreads(8, 8, 1)]
void SSGISpatial(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSGI_TraceResolution.xy)) return;
    uint2 pixel = id.xy;
    float4 current = SRV_Temporal[pixel];
    FSSGISurface surface;
    if (!LoadSurface(TraceToFullPixel(pixel), surface)) { UAV_Output[pixel] = 0; return; }
    float4 sum = 0;
    float4 sumSquares = 0;
    int2 maxPixel = int2(SSGI_TraceResolution.xy) - 1;
    [unroll] for (int y = -1; y <= 1; ++y)
    [unroll] for (int x = -1; x <= 1; ++x)
    {
        float4 value = SRV_Temporal[clamp(int2(pixel) + int2(x, y), 0, maxPixel)];
        sum += value;
        sumSquares += value * value;
    }
    float3 mean = sum.rgb / 9;
    float3 dev = sqrt(max(sumSquares.rgb / 9 - mean * mean, 0));
    float variance = dot(dev * dev, float3(1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0));
    float viewZ = max(ScreenSpaceLinearEyeDepth(surface.rawDepth), 0);
    float fView = lerp(0.5, 1.5, saturate(viewZ / 20));
    float fVariance = max(saturate(variance / (variance + 0.02)), 0.05);
    float ao = 1;
    if (SSGI_HasAO != 0)
    {
        uint2 fullPixel = min(TraceToFullPixel(pixel), (uint2)SSGI_Resolution.xy - 1);
        ao = saturate(SRV_Occlusion[fullPixel].x);
    }
    float fAo = max(ao, 0.25);
    float baseRadius = SSGI_SpatialPass == 0 ? 6.0 : 3.0;
    float radius = baseRadius * fView * fVariance * fAo;
    uint stepN = (uint)clamp(rcp(max(radius / baseRadius, 0.05)), 1, 8);
    float3x3 basis = GetTangentBasis(surface.normalWS);
    float4 filtered = current;
    float weightSum = 1;
    [loop]
    for (uint i = 0; i < 32; ++i)
    {
        if ((i % stepN) != 0) continue;
        float r = sqrt((i + 0.5) / 32.0) * radius;
        float theta = i * 2.39996323 + SSGI_FrameAngle;
        float3 targetWS = surface.positionWS + mul(float3(cos(theta), sin(theta), 0), basis) * r;
        float4 projected = mul(Matrix_Proj, mul(Matrix_WorldToView, float4(targetWS, 1)));
        if (projected.w <= 0) continue;
        float2 uv = projected.xy / projected.w * 0.5 + 0.5;
        if (any(uv < 0) || any(uv >= 1)) continue;
        uint2 samplePixel = FullToTracePixel((uint2)(uv * SSGI_Resolution.xy));
        FSSGISurface neighbor;
        if (!LoadSurface(TraceToFullPixel(samplePixel), neighbor)) continue;
        float planeDistance = abs(dot(neighbor.positionWS - surface.positionWS, surface.normalWS));
        float planeLimit = max(radius * 0.02, 0.05);
        if (planeDistance > planeLimit) continue;
        float normalWeight = SSGI_SpatialPass == 0 ? 1 : saturate(dot(surface.normalWS, neighbor.normalWS));
        if (normalWeight <= 0) continue;
        filtered += SRV_Temporal[samplePixel] * normalWeight;
        weightSum += normalWeight;
    }
    filtered = filtered / weightSum;
    float age = DecodeSurfaceMetadata(SRV_Meta[pixel]).w;
    // No motion uses 0.93. A just-rejected history keeps the current sample, so the noisy weight rises.
    float accumSpeed = age <= 1 ? 1 : 0.93;
    UAV_Output[pixel] = lerp(filtered, current, 0.5 * accumSpeed);
}

// Full-resolution reconstruction of the recurrent diffuse working signal.
[numthreads(8,8,1)]
void SSGIUpsample(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)SSGI_Resolution.xy)) return;
    FSSGISurface surface;
    if (!LoadSurface(id.xy,surface)) { UAV_Output[id.xy] = 0; return; }
    uint2 phaseOffset = TraceToFullPixel(uint2(0,0));
    int2 origin = (int2)floor((float2(id.xy) - phaseOffset) / SSGI_TraceScale);
    uint2 lower = (uint2)clamp(origin,0,int2(SSGI_TraceResolution.xy)-1);
    uint2 upper = (uint2)clamp(origin+1,0,int2(SSGI_TraceResolution.xy)-1);
    // The last representative is clamped on odd extents, so its spacing can be
    // smaller than TraceScale. Interpolate actual surface positions, not quad centers.
    float2 lowerPosition = TraceToFullPixel(lower);
    float2 span = max(float2(TraceToFullPixel(upper)) - lowerPosition, 1);
    float2 blend = saturate((float2(id.xy) - lowerPosition) / span);
    float4 sum = 0; float total = 0;
    [unroll] for (int y=0;y<=1;++y)
    [unroll] for (int x=0;x<=1;++x)
    {
        uint2 tap = (uint2)clamp(origin+int2(x,y),0,int2(SSGI_TraceResolution.xy)-1);
        float4 meta = DecodeSurfaceMetadata(SRV_Meta[tap]);
        float agreement = dot(surface.normalWS,OctahedronToUnitVector(meta.xy));
        float relativeDepth = abs(ScreenSpaceLinearEyeDepth(meta.z)-ScreenSpaceLinearEyeDepth(surface.rawDepth))/max(ScreenSpaceLinearEyeDepth(surface.rawDepth),1e-4);
        if (meta.w < 1 || agreement < 0.9 || relativeDepth > 0.02) continue;
        float2 axisWeight = lerp(1 - blend, blend, float2(x,y));
        float weight = axisWeight.x * axisWeight.y * pow(saturate(agreement),32)*exp2(-relativeDepth*200);
        sum += SRV_Filtered[tap]*weight; total += weight;
    }
    UAV_Output[id.xy] = total > 0 ? sum/total : 0;
}
