#include "Common.hlsl"
#include "Occlusion.hlsl"
#include "SpatialFilter.hlsl"

#pragma kernel OcclusionTrace
#pragma kernel OcclusionSpatialX
#pragma kernel OcclusionSpatialY
#pragma kernel OcclusionTemporal
#pragma kernel OcclusionUpsample
#pragma enable_d3d11_debug_symbols

RWTexture2D<float> UAV_OcclusionTexture;
[numthreads(16, 16, 1)]
void OcclusionTrace(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)Resolution.xy)) return;
    float2 ScreenUV = (id.xy + 0.5) * Resolution.zw;
	uint2 PixelPosition = uint2(ScreenUV * Resolution.xy);

    float SceneDepth = SRV_DepthTexture.Load(int3(id.xy, 0)).r;
    float4 normalSample = SRV_NormalTexture.Load(int3(id.xy, 0));
    uint sourceOffset = (uint)round(normalSample.a * 8);
    float2 sourceUV = (id.xy * 2 + uint2(sourceOffset % 3, sourceOffset / 3) + 0.5) * UpsampleSize.zw;

    if (ScreenSpaceIsFarDepth(SceneDepth))
    {
        UAV_OcclusionTexture[id.xy] = 1;
        return;
    }

	float3 ScreenPos = GetScreenSpacePos(sourceUV, SceneDepth);
	float3 ViewPos = GetViewSpacePos(ScreenPos, Matrix_InvProj);

	float3 WorldNormal = normalize(normalSample.xyz * 2 - 1);
    float3 ViewNormal = mul((float3x3)Matrix_WorldToView, WorldNormal);

    float Occlusion = GTAO(NumRay, NumStep, Radius, Power, HalfProjScale, TemporalOffset, TemporalDirection, SceneDepth, ScreenUV, PixelPosition, ViewPos, ScreenSpaceViewDirection(ViewPos), ViewNormal, Resolution, Matrix_InvProj, SRV_DepthTexture, Global_point_clamp_sampler);
    UAV_OcclusionTexture[id.xy] = lerp(1, Occlusion, Intensity);
}

RWTexture2D<float> UAV_SpatialTexture;
[numthreads(16, 16, 1)]
void OcclusionSpatialX(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)Resolution.xy)) return;
    float2 ScreenUV = (id.xy + 0.5) * Resolution.zw;
    UAV_SpatialTexture[id.xy] = BilateralBlur(ScreenUV, float2(Resolution.z, 0));
}

[numthreads(16, 16, 1)]
void OcclusionSpatialY(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)Resolution.xy)) return;
    float2 ScreenUV = (id.xy + 0.5) * Resolution.zw;
    UAV_SpatialTexture[id.xy] = BilateralBlur(ScreenUV, float2(0, Resolution.w));
}

RWTexture2D<float> UAV_AccmulateTexture;
[numthreads(16, 16, 1)]
void OcclusionTemporal(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)Resolution.xy)) return;
    float2 ScreenUV = (id.xy + 0.5) * Resolution.zw;
    float2 sourceUV = HalfResSourceUV(ScreenUV);
    float2 Velocity = SRV_MotionTexture.SampleLevel(Global_point_clamp_sampler, sourceUV, 0);

    float SampleColors[9];

    [unroll]
    for(uint i = 0; i < 9; i++)
    {
        SampleColors[i] = SRV_OcclusionTexture.SampleLevel(Global_point_clamp_sampler, ScreenUV + (SampleOffset[i] * Resolution.zw), 0);
    }



    float m1 = 0;
    float m2 = 0;

    [unroll]
    for(uint x = 0; x < 9; x++)
    {
        m1 += SampleColors[x];
        m2 += SampleColors[x] * SampleColors[x];
    }

    float mean = m1 / 9;
    float stddev = sqrt(max(0, (m2 / 9) - pow2(mean)));

    float MinColor = mean - TemporalScale * stddev;
    float MaxColor = mean + TemporalScale * stddev;

    float CurrColor = SampleColors[4];
    float currentDepth = SRV_DepthTexture.Load(int3(id.xy, 0)).r;
    float2 HistoryUV; float expectedHistoryDepth;
    ReprojectSurface(sourceUV, currentDepth, Velocity, Matrix_InvViewProj, Matrix_HistoryViewProj, Matrix_MotionViewProj, Matrix_LastMotionViewProj, HistoryUV, expectedHistoryDepth);
    float PrevColor = SRV_HistoryTexture.SampleLevel(Global_point_clamp_sampler, HistoryUV, 0);
    MinColor = min(MinColor, CurrColor);
    MaxColor = max(MaxColor, CurrColor);
    PrevColor = clamp(PrevColor, MinColor, MaxColor);

    float DepthReject = HistoryDepthConfidence(SRV_HistoryDepthTexture, HistoryUV, expectedHistoryDepth, 0);

	float VelocityWeight = clamp(lerp(TemporalWeight, 0.0, length(Velocity) * 200.0), 0.0, TemporalWeight) * DepthReject;
    if (any(HistoryUV < 0) || any(HistoryUV > 1)) VelocityWeight = 0;
    UAV_AccmulateTexture[id.xy] = saturate(lerp(CurrColor, PrevColor, VelocityWeight));
}

RWTexture2D<float> UAV_UpsampleTexture;
[numthreads(16, 16, 1)]
void OcclusionUpsample(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)UpsampleSize.xy)) return;
    float2 uv = (id.xy + 0.5) * UpsampleSize.zw;
    float centerDepth = ScreenSpaceLinearEyeDepth(SRV_DepthTexture.Load(int3(id.xy, 0)).r);
    float3 normal = normalize(SRV_NormalTexture.Load(int3(id.xy, 0)).xyz * 2 - 1);
    float2 lowPosition = uv * Resolution.xy - 0.5;
    int2 basePixel = (int2)floor(lowPosition);
    float2 fraction = frac(lowPosition);
    float total = 0, weightSum = 0;
    [unroll]
    for (int y = 0; y < 2; y++)
    [unroll]
    for (int x = 0; x < 2; x++)
    {
        int2 pixel = clamp(basePixel + int2(x, y), 0, (int2)Resolution.xy - 1);
        float depth = ScreenSpaceLinearEyeDepth(SRV_HalfResDepthTexture.Load(int3(pixel, 0)).r);
        float3 lowNormal = normalize(SRV_HalfResNormalTexture.Load(int3(pixel, 0)).xyz * 2 - 1);
        float bilinear = (x == 0 ? 1 - fraction.x : fraction.x) * (y == 0 ? 1 - fraction.y : fraction.y);
        float weight = bilinear * exp(-abs(depth - centerDepth) / max(0.01 * centerDepth, 0.001)) * pow(saturate(dot(normal, lowNormal)), 8);
        total += SRV_OcclusionTexture.Load(int3(pixel, 0)).r * weight;
        weightSum += weight;
    }
    // No compatible surface sample means no supported occlusion contribution.
    UAV_UpsampleTexture[id.xy] = weightSum > 1e-6 ? saturate(total / weightSum) : 1;
}
