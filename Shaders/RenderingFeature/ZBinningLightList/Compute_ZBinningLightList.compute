#pragma kernel LightCount
#pragma kernel PrefixSum
#pragma kernel Fill

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/Lighting.hlsl"

float4 ZBin_ScreenSize;
int ZBin_TileSize;
float4 ZBin_NumTiles;
float4 ZBin_NearFar;
int ZBin_NumBins;
int ZBin_LightCount;
int ZBin_DirectionalCount;
int ZBin_Phase;
int ZBin_MaxTileList;
int ZBin_MaxZBinList;
float4x4 Matrix_View;
float4x4 Matrix_Proj;

StructuredBuffer<FLightBounds> SRV_LightBoundsBuffer;

RWStructuredBuffer<uint> UAV_TileCount;
RWStructuredBuffer<uint2> UAV_TileRange;
RWStructuredBuffer<uint> UAV_TileLightList;
RWStructuredBuffer<uint> UAV_ZBinCount;
RWStructuredBuffer<uint2> UAV_ZBinRange;
RWStructuredBuffer<uint> UAV_ZBinLightList;
RWStructuredBuffer<uint> UAV_OverflowCounter;

#define ZBINS_COUNT 32

uint DepthToBin(float linearDepth, float near, float far)
{
    float t = saturate((linearDepth - near) / max(far - near, 1e-4));
    return min((uint)(t * ZBin_NumBins), (uint)ZBin_NumBins - 1);
}

[numthreads(64, 1, 1)]
void LightCount(uint3 id : SV_DispatchThreadID)
{
    uint numTiles = (uint)(ZBin_NumTiles.x * ZBin_NumTiles.y);
    uint numBins = (uint)ZBin_NumBins;

    if (ZBin_Phase == 0)
    {
        if (id.x < numTiles)
        {
            UAV_TileCount[id.x] = 0;
        }
        if (id.x < numBins)
        {
            UAV_ZBinCount[id.x] = 0;
        }
        if (id.x == 0)
        {
            UAV_OverflowCounter[0] = 0;
        }
        return;
    }

    if (id.x >= (uint)ZBin_LightCount)
        return;

    FLightBounds bounds = SRV_LightBoundsBuffer[id.x];
    float3 centerWS = bounds.centerRadius.xyz;
    float radius = bounds.centerRadius.w;
    float minZ = bounds.zRange.x;
    float maxZ = bounds.zRange.y;

    float4 centerVS = mul(Matrix_View, float4(centerWS, 1.0));
    float viewZ = -centerVS.z;
    if (viewZ + radius < ZBin_NearFar.x)
        return;

    float4 clip = mul(Matrix_Proj, centerVS);
    float invW = rcp(max(abs(clip.w), 1e-4));
    float2 ndc = clip.xy * invW;
    float2 uv = ndc * 0.5 + 0.5;
    float projectedR = radius * Matrix_Proj._m00 * invW;
    float2 radiusUV = abs(float2(projectedR, projectedR * ZBin_ScreenSize.x * ZBin_ScreenSize.w));

    int2 tileMin = (int2)floor((uv - radiusUV) * ZBin_ScreenSize.xy / ZBin_TileSize);
    int2 tileMax = (int2)floor((uv + radiusUV) * ZBin_ScreenSize.xy / ZBin_TileSize);
    tileMin = clamp(tileMin, 0, (int2)ZBin_NumTiles.xy - 1);
    tileMax = clamp(tileMax, 0, (int2)ZBin_NumTiles.xy - 1);

    uint binMin = DepthToBin(minZ, ZBin_NearFar.x, ZBin_NearFar.y);
    uint binMax = DepthToBin(maxZ, ZBin_NearFar.x, ZBin_NearFar.y);
    if (binMin > binMax)
    {
        uint tmp = binMin;
        binMin = binMax;
        binMax = tmp;
    }

    uint numTilesX = (uint)ZBin_NumTiles.x;
    for (int ty = tileMin.y; ty <= tileMax.y; ++ty)
    {
        for (int tx = tileMin.x; tx <= tileMax.x; ++tx)
        {
            uint tileIndex = (uint)ty * numTilesX + (uint)tx;
            InterlockedAdd(UAV_TileCount[tileIndex], 1);
        }
    }

    for (uint bin = binMin; bin <= binMax; ++bin)
    {
        InterlockedAdd(UAV_ZBinCount[bin], 1);
    }
}

[numthreads(1, 1, 1)]
void PrefixSum(uint3 id : SV_DispatchThreadID)
{
    uint numTiles = (uint)(ZBin_NumTiles.x * ZBin_NumTiles.y);
    uint sum = 0;
    for (uint tile = 0; tile < numTiles; ++tile)
    {
        uint count = UAV_TileCount[tile];
        uint start = sum;
        uint next = sum + count;
        if (next > (uint)ZBin_MaxTileList)
        {
            uint kept = start < (uint)ZBin_MaxTileList ? (uint)ZBin_MaxTileList - start : 0;
            InterlockedAdd(UAV_OverflowCounter[0], count - kept);
            count = kept;
            next = start + kept;
        }
        UAV_TileRange[tile] = uint2(start, count);
        UAV_TileCount[tile] = 0;
        sum = next;
    }

    sum = 0;
    uint numBins = (uint)ZBin_NumBins;
    for (uint bin = 0; bin < numBins; ++bin)
    {
        uint count = UAV_ZBinCount[bin];
        uint start = sum;
        uint next = sum + count;
        if (next > (uint)ZBin_MaxZBinList)
        {
            uint kept = start < (uint)ZBin_MaxZBinList ? (uint)ZBin_MaxZBinList - start : 0;
            InterlockedAdd(UAV_OverflowCounter[0], count - kept);
            count = kept;
            next = start + kept;
        }
        UAV_ZBinRange[bin] = uint2(start, count);
        UAV_ZBinCount[bin] = 0;
        sum = next;
    }
}

[numthreads(64, 1, 1)]
void Fill(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)ZBin_LightCount)
        return;

    FLightBounds bounds = SRV_LightBoundsBuffer[id.x];
    float3 centerWS = bounds.centerRadius.xyz;
    float radius = bounds.centerRadius.w;
    float minZ = bounds.zRange.x;
    float maxZ = bounds.zRange.y;
    uint recordIndex = ZBin_DirectionalCount + id.x;

    float4 centerVS = mul(Matrix_View, float4(centerWS, 1.0));
    float viewZ = -centerVS.z;
    if (viewZ + radius < ZBin_NearFar.x)
        return;

    float4 clip = mul(Matrix_Proj, centerVS);
    float invW = rcp(max(abs(clip.w), 1e-4));
    float2 ndc = clip.xy * invW;
    float2 uv = ndc * 0.5 + 0.5;
    float projectedR = radius * Matrix_Proj._m00 * invW;
    float2 radiusUV = abs(float2(projectedR, projectedR * ZBin_ScreenSize.x * ZBin_ScreenSize.w));

    int2 tileMin = (int2)floor((uv - radiusUV) * ZBin_ScreenSize.xy / ZBin_TileSize);
    int2 tileMax = (int2)floor((uv + radiusUV) * ZBin_ScreenSize.xy / ZBin_TileSize);
    tileMin = clamp(tileMin, 0, (int2)ZBin_NumTiles.xy - 1);
    tileMax = clamp(tileMax, 0, (int2)ZBin_NumTiles.xy - 1);

    uint binMin = DepthToBin(minZ, ZBin_NearFar.x, ZBin_NearFar.y);
    uint binMax = DepthToBin(maxZ, ZBin_NearFar.x, ZBin_NearFar.y);
    if (binMin > binMax)
    {
        uint tmp = binMin;
        binMin = binMax;
        binMax = tmp;
    }

    uint numTilesX = (uint)ZBin_NumTiles.x;
    for (int ty = tileMin.y; ty <= tileMax.y; ++ty)
    {
        for (int tx = tileMin.x; tx <= tileMax.x; ++tx)
        {
            uint tileIndex = (uint)ty * numTilesX + (uint)tx;
            uint2 range = UAV_TileRange[tileIndex];
            uint slot;
            InterlockedAdd(UAV_TileCount[tileIndex], 1, slot);
            if (slot < range.y)
            {
                UAV_TileLightList[range.x + slot] = recordIndex;
            }
        }
    }

    for (uint bin = binMin; bin <= binMax; ++bin)
    {
        uint2 range = UAV_ZBinRange[bin];
        uint slot;
        InterlockedAdd(UAV_ZBinCount[bin], 1, slot);
        if (slot < range.y)
        {
            UAV_ZBinLightList[range.x + slot] = recordIndex;
        }
    }
}
