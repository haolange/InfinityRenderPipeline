#pragma kernel BloomDownsample
#pragma kernel BloomUpsample
#pragma kernel FinalCombine
#pragma kernel ExposureClear
#pragma kernel ExposureHistogram
#pragma kernel ExposureReduce

#include "../../ShaderLibrary/Common.hlsl"
#include "../../ShaderLibrary/Random.hlsl"
#include "../../ShaderLibrary/ColorUtility.hlsl"

float4 PP_Resolution;
float PP_BloomIntensity;
float PP_BloomThreshold;
float PP_VignetteIntensity;
float PP_VignetteSmoothness;
float PP_FilmGrainIntensity;
float PP_FilmGrainResponse;
int PP_FrameIndex;
float PP_ExposureMultiplier;
float PP_AutoExposure;

Texture2D<float4> SRV_SceneColorTexture;
RWTexture2D<float4> UAV_PostProcessTexture;
Texture3D<float4> SRV_CombineLUT;
Texture2D<float> SRV_ExposureEV;

Texture2D<float4> SRV_BloomSource;
RWTexture2D<float4> UAV_BloomTarget;
float4 BloomMipSize;
float PP_BloomPrefilter;

Texture2D<float4> SRV_BloomTexture;

RWStructuredBuffer<uint> UAV_ExposureHistogram;
Texture2D<float> SRV_ExposureHistoryEV;
RWTexture2D<float> UAV_ExposureEV;
float4 PP_ExposureHistogramRange;
float PP_ExposureLowPercentile;
float PP_ExposureHighPercentile;
float PP_ExposureAdapt;
int PP_ExposureReset;

float3 LinToLog(float3 linearColor)
{
    const float LinearRange = 14.0;
    const float LinearGrey = 0.18;
    const float ExposureGrey = 444.0;
    float3 logColor = log2(max(linearColor, 1e-6)) / LinearRange - log2(LinearGrey) / LinearRange + ExposureGrey / 1023.0;
    return saturate(logColor);
}

float CurrentExposureMultiplier()
{
    float multiplier = PP_ExposureMultiplier;
    if (PP_AutoExposure > 0.5)
    {
        multiplier *= exp2(SRV_ExposureEV[uint2(0, 0)]);
    }

    return multiplier;
}

float3 KarisAverage(float3 c)
{
    return c / (1.0 + Rec709Luminance(c));
}

[numthreads(8, 8, 1)]
void BloomDownsample(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)BloomMipSize.xy))
        return;

    float2 uv = (id.xy + 0.5) * BloomMipSize.zw;
    float2 texelSize = BloomMipSize.zw;

    float3 a = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2(-2, -2) * texelSize, 0).rgb;
    float3 b = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 0, -2) * texelSize, 0).rgb;
    float3 c = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 2, -2) * texelSize, 0).rgb;
    float3 d = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2(-1, -1) * texelSize, 0).rgb;
    float3 e = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 1, -1) * texelSize, 0).rgb;
    float3 f = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2(-2,  0) * texelSize, 0).rgb;
    float3 g = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv, 0).rgb;
    float3 h = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 2,  0) * texelSize, 0).rgb;
    float3 i = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2(-1,  1) * texelSize, 0).rgb;
    float3 j = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 1,  1) * texelSize, 0).rgb;
    float3 k = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2(-2,  2) * texelSize, 0).rgb;
    float3 l = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 0,  2) * texelSize, 0).rgb;
    float3 m = SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 2,  2) * texelSize, 0).rgb;

    float3 result = 0;
    result += (d + e + i + j) * 0.5 * 0.25;
    result += (a + b + f + g) * 0.125 * 0.25;
    result += (b + c + g + h) * 0.125 * 0.25;
    result += (f + g + k + l) * 0.125 * 0.25;
    result += (g + h + l + m) * 0.125 * 0.25;

    if (PP_BloomPrefilter > 0.5)
    {
        result *= CurrentExposureMultiplier();
        const float knee = 0.5;
        float brightness = Rec709Luminance(result);
        float soft = clamp(brightness - PP_BloomThreshold + knee, 0, 2.0 * knee);
        soft = soft * soft * rcp(4.0 * knee + 1e-4);
        float contribution = max(soft, brightness - PP_BloomThreshold) * rcp(max(brightness, 1e-4));
        result *= contribution;
    }

    UAV_BloomTarget[id.xy] = float4(max(0, result), 1);
}

[numthreads(8, 8, 1)]
void BloomUpsample(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)BloomMipSize.xy))
        return;

    float2 uv = (id.xy + 0.5) * BloomMipSize.zw;
    float2 texelSize = BloomMipSize.zw;

    float3 result = 0;
    result += SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2(-1, -1) * texelSize, 0).rgb * 1.0;
    result += SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 0, -1) * texelSize, 0).rgb * 2.0;
    result += SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 1, -1) * texelSize, 0).rgb * 1.0;
    result += SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2(-1,  0) * texelSize, 0).rgb * 2.0;
    result += SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv                             , 0).rgb * 4.0;
    result += SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 1,  0) * texelSize, 0).rgb * 2.0;
    result += SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2(-1,  1) * texelSize, 0).rgb * 1.0;
    result += SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 0,  1) * texelSize, 0).rgb * 2.0;
    result += SRV_BloomSource.SampleLevel(Global_bilinear_clamp_sampler, uv + float2( 1,  1) * texelSize, 0).rgb * 1.0;
    result /= 16.0;
    result += UAV_BloomTarget[id.xy].rgb;

    UAV_BloomTarget[id.xy] = float4(max(0, result), 1);
}

float ComputeVignette(float2 uv)
{
    float2 d = abs(uv - 0.5) * 2.0;
    float falloff = saturate(1.0 - dot(d, d) * PP_VignetteIntensity);
    return pow(max(falloff, 1e-4), max(PP_VignetteSmoothness, 0.01) * 2.0);
}

float3 ApplyFilmGrain(float3 color, float2 uv, int frameIndex)
{
    if (PP_FilmGrainIntensity <= 0)
        return color;

    float noise = InterleavedGradientNoise(uv * PP_Resolution.xy, frameIndex);
    noise = (noise - 0.5) * 2.0 * PP_FilmGrainIntensity;
    float lum = Rec709Luminance(color);
    float grainStrength = lerp(1.0, 1.0 - saturate(lum), PP_FilmGrainResponse);
    return color + noise * grainStrength;
}

[numthreads(8, 8, 1)]
void FinalCombine(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)PP_Resolution.xy))
        return;

    float2 screenUV = (id.xy + 0.5) * PP_Resolution.zw;
    float3 sceneColor = SRV_SceneColorTexture.SampleLevel(Global_point_clamp_sampler, screenUV, 0).rgb;
    sceneColor *= CurrentExposureMultiplier();
    sceneColor += SRV_BloomTexture.SampleLevel(Global_bilinear_clamp_sampler, screenUV, 0).rgb * PP_BloomIntensity;

    float3 graded = SRV_CombineLUT.SampleLevel(Global_trilinear_clamp_sampler, LinToLog(max(sceneColor, 1e-6)), 0).rgb;
    graded *= ComputeVignette(screenUV);
    graded = ApplyFilmGrain(graded, screenUV, PP_FrameIndex);

    UAV_PostProcessTexture[id.xy] = float4(max(0, graded), 1);
}

[numthreads(64, 1, 1)]
void ExposureClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x < 256)
    {
        UAV_ExposureHistogram[id.x] = 0;
    }
}

[numthreads(8, 8, 1)]
void ExposureHistogram(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)PP_Resolution.xy))
        return;

    float3 sceneColor = SRV_SceneColorTexture[id.xy].rgb;
    float luma = max(Rec709Luminance(sceneColor), 1e-6);
    float logLum = log2(luma);
    float t = saturate((logLum - PP_ExposureHistogramRange.x) * PP_ExposureHistogramRange.z);
    uint bin = (uint)(t * 255.999);
    InterlockedAdd(UAV_ExposureHistogram[bin], 1);
}

[numthreads(1, 1, 1)]
void ExposureReduce(uint3 id : SV_DispatchThreadID)
{
    uint total = 0;
    for (uint i = 0; i < 256; ++i)
    {
        total += UAV_ExposureHistogram[i];
    }

    float targetEV = 0.0;
    if (total > 0)
    {
        uint lowCount = (uint)(total * PP_ExposureLowPercentile / 100.0);
        uint highCount = (uint)(total * PP_ExposureHighPercentile / 100.0);
        uint running = 0;
        float weighted = 0.0;
        float weight = 0.0;
        for (uint bin = 0; bin < 256; ++bin)
        {
            uint count = UAV_ExposureHistogram[bin];
            uint next = running + count;
            if (next > lowCount && running < highCount)
            {
                uint usable = min(next, highCount) - max(running, lowCount);
                float logCenter = lerp(PP_ExposureHistogramRange.x, PP_ExposureHistogramRange.y, (bin + 0.5) / 256.0);
                weighted += logCenter * usable;
                weight += usable;
            }

            running = next;
        }

        float avgLog = weight > 0.0 ? weighted / weight : 0.0;
        targetEV = log2(0.18) - avgLog;
    }

    float prevEV = PP_ExposureReset != 0 ? targetEV : SRV_ExposureHistoryEV[uint2(0, 0)];
    float ev = lerp(prevEV, targetEV, saturate(PP_ExposureAdapt));
    UAV_ExposureEV[uint2(0, 0)] = ev;
}
